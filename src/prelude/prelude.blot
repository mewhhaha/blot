  .Int8x16 = Int8x16;
  .likely = likely;
  .unlikely = unlikely;
  .Text = Text;
  .Empty = Empty;
  .Length = Length;
  .as_json = as_json;
  .as_const_json = as_const_json;
  .Semigroup = Semigroup;
  .Monoid = Monoid;

  .Array = Array;
  .Arena = Arena;
  .Continuation = Continuation;
  .fold = fold;
  .each = each;
  .map = map;
  .filter = filter;
  .sum = sum;
  .upto = upto;
  .ever = ever;
  .Iter = Iter;
  .iterate = iterate;
  .collect = collect;
