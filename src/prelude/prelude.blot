// The prelude.
//
// Nothing here is built into the compiler. `Bool`, `Int`, `+`, `struct`, and
// `fold` are ordinary blot declarations over the `@` primitives, which is what
// "few primitives" has to mean if it means anything.
//
// Two calling conventions, and the line between them is deliberate:
//
//   * anything an operator dispatches to is curried, because sections are the
//     point of an operator — `Int.add 2` is what makes `20 |> Int.add 2` work;
//   * every other multi-argument function takes one shape, because naming beats
//     position and a tuple is still one parameter.

// --- types ------------------------------------------------------------------
//
// `|` names `Type.union` exactly the way `+` names `Int.add`: the operator
// points at prelude source, and the prelude decides which primitive answers.
// Nothing about `|` is privileged. This initial namespace has to precede the
// declarations that use it; the complete namespace is assembled after its
// remaining operations have been defined.


const Type =
  {
    .union = @type.union;
    .intersect = @type.intersect;
    .diff = @type.diff;
  }

// --- functions --------------------------------------------------------------

const identity = fn value => value
const always = fn value => fn _ => value
const freeze :: @forall (fn T => [T] -> [T])
const freeze = fn value => @linear.freeze value

// Curried: these are the targets of `$` and `|>`.
const apply = fn f => fn x => f x
const pipe = fn x => fn f => f x

const compose = fn (f, g) => fn x => f (g x)
const flip = fn f => fn (a, b) => f (b, a)

const Fn =
  {
    .identity = identity;
    .always = always;
    .apply = apply;
    .pipe = pipe;
    .compose = compose;
    .flip = flip;
  }

// --- declaration tags ------------------------------------------------------

// The compiler reads this ordinary shape at compile time. The transform stays
// ordinary blot code: a `let` runs it at run time, while a `const` runs it at
// compile time with the value it enriches.
const tag = fn (name, metadata, transform) => {
  .name = name;
  .metadata = metadata;
  .transform = transform;
}

const derive = fn transform => tag ("derive", (), transform)
const test = tag ("test", (), identity)
const assert = { .reuse = tag ("assert.reuse", (), @assert.reuse); }

// --- booleans ---------------------------------------------------------------
//
// `#True` and `#False` are ordinary constructors. `if` accepts one of them and
// nothing else, so there is no truthiness anywhere in the language.

const True = #True
const False = #False
const Bool = #True | #False

const not = fn value => case value of
  #True => False
  #False => True

// Ordinary deferred functions implement boolean combination. The operators are
// ordinary calls to these bindings; the function decides whether to demand its
// second argument.
const and = fn left => fn ~right => case left of
  #False => False
  #True => right

const or = fn left => fn ~right => case left of
  #True => True
  #False => right

const Logic = { .not = not; .and = and; .or = or; }

// Whether two arrows agree about who evaluates the argument. `reflect` answers
// `.deferred` for every arrow, so this is a comparison rather than a question
// about whether the field is there.
const same_demand = fn (left, right) => case left of
  #True => right
  #False => not right

// Refusing, with a reason. This is how a compile-time check reports what it
// found: `expect` in a `const` is a diagnostic before the program runs.
const expect = fn (condition, message) => case condition of
  #True => ()
  #False => @fail message

// --- ordering ---------------------------------------------------------------
//
// One comparison primitive yields every integer ordering operation. Each member
// here is curried: they are all operator targets.

const Ordering = #Less | #Equal | #Greater

// Matched exhaustively rather than with `_`. A wildcard arm leaves the
// constructor set unpinned in a polymorphic function, and the set is what the
// backend needs to build a Core union — so being explicit here is what lets
// every comparison in the language reach Wasm.
const is_equal = fn o => case o of
  #Equal => True
  #Less => False
  #Greater => False

const is_less = fn o => case o of
  #Less => True
  #Equal => False
  #Greater => False

const is_greater = fn o => case o of
  #Greater => True
  #Less => False
  #Equal => False

const IntOrder =
  {
    .cmp = @int.cmp;
    .eq = fn left => fn right => is_equal (@int.cmp left right);
    .ne = fn left => fn right => not (is_equal (@int.cmp left right));
    .lt = fn left => fn right => is_less (@int.cmp left right);
    .le = fn left => fn right => not (is_greater (@int.cmp left right));
    .gt = fn left => fn right => is_greater (@int.cmp left right);
    .ge = fn left => fn right => not (is_less (@int.cmp left right));
    .min = fn left => fn right => do:
      if is_greater (@int.cmp left right):
        return right
      else:
        return left
    ;
    .max = fn left => fn right => do:
      if is_less (@int.cmp left right):
        return right
      else:
        return left
    ;
  }

// --- numbers ----------------------------------------------------------------

const IntArithmetic =
  {
    .add = @int.add;
    .sub = @int.sub;
    .mul = @int.mul;
    .div = @int.div;
    .rem = @int.rem;
    .negate = @int.neg;
    .abs = fn value => do:
      if is_less (@int.cmp value 0):
        return @int.neg value
      else:
        return value
    ;
    .succ = fn value => @int.add value 1;
    .pred = fn value => @int.sub value 1;
  }

// The fixed operator table resolves against this early namespace. The complete
// type value is attached later, after the ordinary `attach` helper exists.
const Int = { ...IntOrder; ...IntArithmetic; }

// --- text -------------------------------------------------------------------

// Interfaces are structural types, not implicit dispatch. A function that
// accepts one receives the implementation record explicitly, so its operator
// choices remain visible in source.
const Empty = fn value => { .empty = value; }
const Length = fn value => { .length = value -> @type.int; }
const Semigroup = fn value => { .append = value -> value -> value; }
const Monoid = fn value => {
  .empty = value;
  .append = value -> value -> value;
}

// Blot has no higher-kinded type variables, so collection interfaces state one
// concrete source and result instantiation. Polymorphic implementations such as
// `Array.map` satisfy each requested instantiation independently.
const Mappable = fn (source, target, value, mapped) => {
  .map = (source, (value -> mapped)) -> target;
}

const Foldable = fn (collection, value, state) => {
  .fold = (collection, state, ((state, value) -> state)) -> state;
}

const Filterable = fn (collection, value) => {
  .filter = (collection, (value -> Bool)) -> collection;
}

const TextOperations =
  {
    .empty = "";
    .append = @text.concat;
    .length = @text.len;
    .cmp = @text.cmp;
    .contains = @text.contains;
    .of_int = @text.of_int;
  }

const Text = TextOperations

const as_json = @json.parse #Widen
const as_const_json = @json.parse #Exact

const text_eq = fn (left, right) => is_equal (@text.cmp left right)

// --- arrays -----------------------------------------------------------------

const array_get = fn (&values, index) => do:
  if index >= 0:
    if index < @array.len (&values):
      return #Some (@array.get (&values) index)
    else:
      return #None
  else:
    return #None

const array_set = fn (values, index, value) => do:
  if index >= 0:
    if index < @array.len values:
      return #Some (@array.set values index value)
    else:
      return #None
  else:
    return #None

const Continuation =
  {
    .cancel = @continuation.cancel;
  }

// Structural recursion, which is all a surface loop becomes before inference.
// Rebindings form the accumulator; `for` does not introduce assignment.
const fold :: @forall (fn T => @forall (fn S => do:
    return ([T], S, (S, T) -> S) -> S
  ))
const fold = fn (&values, state, step) => do:
  let rec go =
    fn (index, current) => do:
      result <- case array_get (values, index) of
        #Some value => do:
          next <- step (current, value)
          continued <- go (@int.add index 1, next)
          return continued

        #None => current
      return result
  result <- go (0, state)
  return result

const array_append = fn left => fn right => do:
  return fold (
    right,
    left,
    fn (state, value) => @array.push state value
  )

const array_map = fn (values, transform) => do:
  return fold (
    values,
    @array.empty,
    fn (state, value) => @array.push state (transform value)
  )

const array_filter = fn (values, keep) => fold (
  values,
  @array.empty,
  fn (state, value) => case keep value of
    #True => @array.push state value
    #False => state
)

const array_partition = fn (values, belongs_left) => fold (
  values,
  (@array.empty, @array.empty),
  fn ((left, right), value) => case belongs_left value of
    #True => (@array.push left value, right)
    #False => (left, @array.push right value)
)

const array_uncons_at = fn (values, index) => do:
  if index >= 0:
    if index < @array.len values:
      return #Some (@array.take values index)
    else:
      return #None
  else:
    return #None

const array_uncons = fn values => array_uncons_at (values, 0)

const array_items = fn values => do:
  let shared = @linear.freeze values
  return {
    .state = 0;
    .step = fn index => case array_get (shared, index) of
      #Some value => #Some (value, @int.add index 1)
      #None => #None
    ;
  }

const slice_copy :: @forall (fn T => [T] -> @region.type T)
const slice_copy = fn !values => @region.copy (!values)

const slice_length :: @forall (fn T => @region.type T -> @type.int)
const slice_length = fn &region => @region.length (&region)

const slice_get ::
  @forall (fn T => (@region.type T, @type.int) -> (#Some T | #None))
const slice_get = fn (&region, index) => @region.get (&region) index

const slice_set :: @forall (fn T => do:
    return
      (@region.type T, @type.int, T) -> (#Updated (@region.type T) | #SetOutOfBounds (@region.type T))
  )
const slice_set =
  fn (!region, index, value) => @region.set (!region) index value

const slice_replace :: @forall (fn T => do:
    return (@region.type T, @type.int, T) ->
        (#Replaced (T, @region.type T) |
         #ReplaceOutOfBounds (T, @region.type T))
  )
const slice_replace =
  fn (!region, index, !value) => @region.replace (!region) index (!value)

const slice_swap :: @forall (fn T => do:
    return
      (@region.type T, @type.int, @type.int) -> (#Updated (@region.type T) | #SwapOutOfBounds (@region.type T))
  )
const slice_swap =
  fn (!region, left, right) => @region.swap (!region) left right

const slice_partition_unchecked :: @forall (fn T => do:
    return (
      @region.type T,
      @type.int,
      @type.int,
      (T -> (#True | #False))
    ) -> (@region.type T, @type.int)
  )
const slice_partition_unchecked =
  fn (!region, start, end, belongs_left) => do:
    let rec go =
      fn (!current_region, scan, boundary, final) => do:
        if is_equal (@int.cmp scan final):
          return (!current_region, boundary)
        else:
          let current = case slice_get ((&current_region), scan) of
            #Some value => value
            #None => @panic "partition index escaped its Slice"
          return case belongs_left current of
            #True => do:
              let updated = case slice_swap (
                (!current_region),
                scan,
                boundary
              ) of
                #Updated !next => next
                #SwapOutOfBounds !original => original
              return go (
                !updated,
                @int.add scan 1,
                @int.add boundary 1,
                final
              )
            #False => go (
              !current_region,
              @int.add scan 1,
              boundary,
              final
            )
    return go (!region, start, start, end)

const slice_partition_range :: @forall (fn T => do:
    return (
      @region.type T,
      @type.int,
      @type.int,
      (T -> (#True | #False))
    ) -> (
      #Partitioned (@region.type T, @type.int) |
      #PartitionOutOfBounds (@region.type T, @type.int)
    )
  )
const slice_partition_range =
  fn (!region, start, end, belongs_left) => do:
    let length = slice_length (&region)
    if is_less (@int.cmp start 0):
      return #PartitionOutOfBounds (!region, start)
    else:
      if is_less (@int.cmp end start):
        return #PartitionOutOfBounds (!region, start)
      else:
        if is_less (@int.cmp length end):
          return #PartitionOutOfBounds (!region, start)
        else:
          let (!partitioned, boundary) =
            slice_partition_unchecked (
              !region,
              start,
              end,
              belongs_left
            )
          return #Partitioned (!partitioned, boundary)

const slice_partition :: @forall (fn T => do:
    return (
      @region.type T,
      (T -> (#True | #False))
    ) -> (@region.type T, @type.int)
  )
const slice_partition =
  fn (!region, belongs_left) => do:
    let length = slice_length (&region)
    return slice_partition_unchecked (
      !region,
      0,
      length,
      belongs_left
    )

const slice_split :: @forall (fn T => do:
    return (@region.type T, @type.int) -> (#Split (
        @region.type T,
        @region.type T,
        @region.rejoin
      ) | #SplitOutOfBounds (@region.type T))
  )
const slice_split = fn (!region, index) => @region.split (!region) index

const slice_join :: @forall (fn T => do:
    return (
      @region.rejoin,
      @region.type T,
      @region.type T
    ) -> @region.type T
  )
const slice_join =
  fn (!rejoin, !left, !right) => @region.join (!rejoin) (!left) (!right)

const slice_reassociate_left ::
  (@region.rejoin, @region.rejoin) -> (@region.rejoin, @region.rejoin)
const slice_reassociate_left =
  fn (!outer, !inner) => @region.reassociate_left (!outer) (!inner)
const slice_reassociate_right ::
  (@region.rejoin, @region.rejoin) -> (@region.rejoin, @region.rejoin)
const slice_reassociate_right =
  fn (!outer, !inner) => @region.reassociate_right (!outer) (!inner)

const slice_freeze :: @forall (fn T => @region.type T -> [T])
const slice_freeze = fn !region => @region.freeze (!region)

// Checked range metadata is deliberately not ownership authority. Every
// consuming operation still validates the bounds against the current Slice.
const SliceRange =
  {
    .start = @type.int;
    .end = @type.int;
  }

const slice_range_value = fn (start, end) => do:
  return { .start = start; .end = end; }

const slice_range_bounds = fn bounds => bounds

const slice_range_length :: SliceRange -> @type.int
const slice_range_length = fn bounds => do:
  let { .start; .end; } = slice_range_bounds bounds
  return @int.sub end start

const slice_range_last :: SliceRange -> @type.int
const slice_range_last = fn bounds => do:
  let { .end; } = slice_range_bounds bounds
  return @int.sub end 1

const slice_range_before :: (SliceRange, @type.int) -> SliceRange
const slice_range_before = fn (bounds, boundary) => do:
  let { .start; } = slice_range_bounds bounds
  return slice_range_value (start, boundary)

const slice_range_after :: (SliceRange, @type.int) -> SliceRange
const slice_range_after = fn (bounds, boundary) => do:
  let { .end; } = slice_range_bounds bounds
  return slice_range_value (@int.add boundary 1, end)

const range_whole :: @forall (fn T => [T] -> SliceRange)
const range_whole = fn &values => do:
  return slice_range_value (0, @array.len (&values))

const range_shorter_first ::
  (SliceRange, SliceRange) -> (SliceRange, SliceRange)
const range_shorter_first = fn (left, right) => do:
  if slice_range_length left <= slice_range_length right:
    return (left, right)

  return (right, left)

const Range =
  {
    .Type = SliceRange;
    .of = slice_range_value;
    .whole = range_whole;
    .length = slice_range_length;
    .last = slice_range_last;
    .before = slice_range_before;
    .after = slice_range_after;
    .shorter_first = range_shorter_first;
  }

const array_expect_get :: @forall (fn T => ([T], @type.int) -> T)
const array_expect_get = fn (&values, index) => do:
  return case array_get ((&values), index) of
    #Some value => value
    #None => @panic "index escaped its checked Array range"

const array_expect_set :: @forall (fn T => ([T], @type.int, T) -> [T])
const array_expect_set = fn (?values, index, value) => do:
  if index >= 0:
    if index < @array.len (&values):
      return @array.set values index value
    else:
      return @panic "index escaped its checked Array range"
  else:
    return @panic "index escaped its checked Array range"

const scratch_with_capacity :: @forall (fn T => @type.int -> @scratch.type T)
const scratch_with_capacity =
  fn capacity => @scratch.with_capacity capacity

const scratch_push :: @forall (fn T => (@scratch.type T, T) -> @scratch.type T)
const scratch_push =
  fn (scratch, value) => @scratch.push scratch value

const scratch_finish :: @forall (fn T => @scratch.type T -> [T])
const scratch_finish =
  fn scratch => @scratch.finish scratch

const scratch_recycle :: @forall (fn T => [T] -> @scratch.type T)
const scratch_recycle =
  fn values => @scratch.recycle values

const Scratch =
  {
    .of = @scratch.type;
    .with_capacity = scratch_with_capacity;
    .push = scratch_push;
    .finish = scratch_finish;
    .recycle = scratch_recycle;
  }

const array_merge_run :: @forall (fn T => do:
    return (
      [T],
      @scratch.type T,
      @type.int,
      @type.int,
      @type.int,
      @type.int,
      ((T, T) -> (#True | #False))
    ) -> ([T], @scratch.type T)
  )
const array_merge_run =
  fn (?source, ?target, left, middle, right, stop, before_or_equal) => do:
    let rec merge = fn (?current, ?output, i, j) => do:
      if i >= middle:
        if j >= stop:
          return (current, output)
        else:
          let value = array_expect_get ((&current), j)
          return merge (current, Scratch.push (output, value), i, j + 1)
      else:
        if j >= stop:
          let value = array_expect_get ((&current), i)
          return merge (current, Scratch.push (output, value), i + 1, j)
        else:
          let left_value = array_expect_get ((&current), i)
          let right_value = array_expect_get ((&current), j)
          if before_or_equal (left_value, right_value):
            return merge (
              current,
              Scratch.push (output, left_value),
              i + 1,
              j
            )
          else:
            return merge (
              current,
              Scratch.push (output, right_value),
              i,
              j + 1
            )

    return merge (source, target, left, right)

const array_merge_pass :: @forall (fn T => do:
    return (
      [T],
      @scratch.type T,
      @type.int,
      ((T, T) -> (#True | #False))
    ) -> ([T], @scratch.type T)
  )
const array_merge_pass =
  fn (?source, ?target, width, before_or_equal) => do:
    let length = @array.len (&source)
    let rec runs = fn (?current, ?output, start) => do:
      if start >= length:
        return (
          Scratch.finish output,
          Scratch.recycle current
        )
      else:
        let middle = IntOrder.min (start + width) length
        let stop = IntOrder.min (middle + width) length
        let (current, output) =
          array_merge_run (
            current,
            output,
            start,
            middle,
            middle,
            stop,
            before_or_equal
          )
        return runs (current, output, stop)

    return runs (source, target, 0)

const array_merge_sort ::
  @forall (fn T => ([T], ((T, T) -> (#True | #False))) -> [T])
const array_merge_sort = fn (values, before_or_equal) => do:
  let length = @array.len (&values)
  if length < 2:
    return values
  else:
    let target = Scratch.with_capacity length
    let rec passes = fn (?source, ?output, width) => do:
      let (next, output) =
        array_merge_pass (
          source,
          output,
          width,
          before_or_equal
        )
      let next_width = width * 2
      if next_width >= length:
        return (next, output)
      else:
        return passes (next, output, next_width)

    let (sorted, _) = passes (values, target, 1)
    return sorted

const RadixSign = 0 | 1 | 2
const RadixStrategy = #Stable | #Unstable
const RadixBucket =
  @type.refine @type.int (
    fn value => value >= 0 && value <= 255
  )

const radix_zeroes :: @type.unit -> [@type.int]
const radix_zeroes = fn _ => do:
  let rec fill = fn (?counts, bucket) => do:
    if bucket >= 256:
      return counts
    else:
      return fill (@array.push counts 0, bucket + 1)
  return fill (@array.empty, 0)

const radix_floor_digit :: (@type.int, @type.int) -> @type.int
const radix_floor_digit = fn (key, divisor) => do:
  let quotient = key / divisor
  let quotient = case key % divisor < 0 of
    #True => quotient - 1
    #False => quotient
  let digit = quotient % 256
  if digit < 0:
    return digit + 256
  else:
    return digit

const radix_magnitude_digit :: (@type.int, @type.int) -> @type.int
const radix_magnitude_digit = fn (key, divisor) => do:
  let digit = (key / divisor) % 256
  if digit < 0:
    return 0 - digit
  else:
    return digit

const radix_bucket :: @type.int -> RadixBucket
const radix_bucket = fn value => do:
  if value < 0:
    return 0
  else:
    if value > 255:
      return 255
    else:
      return value

const radix_digit :: (@type.int, @type.int, RadixSign, @type.int) -> RadixBucket
const radix_digit = fn (key, divisor, sign, top_divisor) => do:
  if sign == 0:
    return radix_bucket (radix_floor_digit (key, divisor))
  else:
    if sign == 1:
      return radix_bucket (
        255 - radix_magnitude_digit (key, divisor)
      )
    else:
      let digit = radix_floor_digit (key, divisor)
      if divisor == top_divisor:
        if digit < 128:
          return radix_bucket (digit + 128)
        else:
          return radix_bucket (digit - 128)
      else:
        return radix_bucket digit

const radix_power :: @type.int -> @type.int
const radix_power = fn exponent => do:
  let rec raise = fn (value, remaining) => do:
    if remaining < 1:
      return value
    else:
      return raise (value * 256, remaining - 1)
  return raise (1, exponent)

const radix_top_divisor :: (@type.int, @type.int, RadixSign) -> @type.int
const radix_top_divisor = fn (minimum, maximum, sign) => do:
  if sign == 2:
    return radix_power 7
  else:
    if sign == 0:
      let rec grow = fn divisor => do:
        if maximum / divisor >= 256:
          return grow (divisor * 256)
        else:
          return divisor
      return grow 1
    else:
      let rec grow = fn divisor => do:
        if minimum / divisor <= -256:
          return grow (divisor * 256)
        else:
          return divisor
      return grow 1

const array_radix_cache :: @forall (fn T => do:
    return ([T], (T -> @type.int)) -> (
      [(T, @type.int)],
      @type.int,
      @type.int,
      @scratch.type T
    )
  )
const array_radix_cache = fn (values, key) => do:
  let length = @array.len (&values)
  let first = array_expect_get ((&values), 0)
  let first_key = key first
  let entries = Scratch.with_capacity length
  let entries = Scratch.push (entries, (first, first_key))
  let rec cache = fn (?source, ?output, index) => do:
    if index >= length:
      return (
        source,
        Scratch.finish output
      )
    else:
      let value = array_expect_get ((&source), index)
      let value_key = key value
      return cache (
        source,
        Scratch.push (output, (value, value_key)),
        index + 1
      )
  let (values, entries) = cache (values, entries, 1)
  let rec bounds = fn (index, minimum, maximum) => do:
    if index >= length:
      return (minimum, maximum)
    else:
      let entry = array_expect_get ((&entries), index)
      return bounds (
        index + 1,
        IntOrder.min minimum entry.1,
        IntOrder.max maximum entry.1
      )
  let (minimum, maximum) = bounds (1, first_key, first_key)
  return (entries, minimum, maximum, Scratch.recycle values)

const radix_counts :: @forall (fn T => do:
    return (
      [(T, @type.int)],
      @type.int,
      @type.int,
      @type.int,
      RadixSign,
      @type.int
    ) -> [@type.int]
  )
const radix_counts =
  fn (&entries, start, stop, divisor, sign, top_divisor) => do:
    let rec count = fn (?counts, index) => do:
      if index >= stop:
        return counts
      else:
        let entry = array_expect_get ((&entries), index)
        let bucket = radix_digit (entry.1, divisor, sign, top_divisor)
        let seen = array_expect_get ((&counts), bucket)
        return count (
          array_expect_set (counts, bucket, seen + 1),
          index + 1
        )
    return count (radix_zeroes (), start)

const radix_positions :: [@type.int] -> [@type.int]
const radix_positions = fn &counts => do:
  let rec build = fn (?positions, bucket, offset) => do:
    if bucket >= 256:
      return positions
    else:
      let count = array_expect_get ((&counts), bucket)
      return build (
        @array.push positions offset,
        bucket + 1,
        offset + count
      )
  let first = array_expect_get ((&counts), 0)
  return build ([0], 1, first)

const radix_stable_pass :: @forall (fn T => do:
    return (
      [(T, @type.int)],
      [(T, @type.int)],
      @type.int,
      RadixSign,
      @type.int
    ) -> ([(T, @type.int)], [(T, @type.int)])
  )
const radix_stable_pass =
  fn (?source, ?target, divisor, sign, top_divisor) => do:
    let length = @array.len (&source)
    let counts =
      radix_counts (
        (&source),
        0,
        length,
        divisor,
        sign,
        top_divisor
      )
    let positions = radix_positions (&counts)
    let rec scatter = fn (?current, ?output, ?cursor, index) => do:
      if index >= length:
        return (current, output, cursor)
      else:
        let entry = array_expect_get ((&current), index)
        let bucket =
          radix_digit (
            entry.1,
            divisor,
            sign,
            top_divisor
          )
        let position = array_expect_get ((&cursor), bucket)
        let output = array_expect_set (output, position, entry)
        let cursor = array_expect_set (cursor, bucket, position + 1)
        return scatter (
          ?current,
          ?output,
          ?cursor,
          index + 1
        )
    let (source, target, _) = scatter (?source, ?target, ?positions, 0)
    return (target, source)

const radix_stable :: @forall (fn T => do:
    return (
      [(T, @type.int)],
      RadixSign,
      @type.int
    ) -> [(T, @type.int)]
  )
const radix_stable = fn (?entries, sign, top_divisor) => do:
  let target = @array.copy (&entries)
  let rec passes = fn (?source, ?output, divisor) => do:
    let (next, output) =
      radix_stable_pass (
        source,
        output,
        divisor,
        sign,
        top_divisor
      )
    if divisor >= top_divisor:
      return (next, output)
    else:
      return passes (next, output, divisor * 256)
  let (sorted, _) = passes (entries, target, 1)
  return sorted

const radix_flag_range :: @forall (fn T => do:
    return (
      [(T, @type.int)],
      @type.int,
      @type.int,
      @type.int,
      RadixSign,
      @type.int
    ) -> [(T, @type.int)]
  )
const radix_flag_range =
  fn (?entries, start, stop, divisor, sign, top_divisor) => do:
    let rec flag = fn (?values, range_start, range_stop, place_value) => do:
      let counts =
        radix_counts (
          (&values),
          range_start,
          range_stop,
          place_value,
          sign,
          top_divisor
        )
      let relative = radix_positions (&counts)
      let rec shift = fn (?positions, bucket) => do:
        if bucket >= 256:
          return positions
        else:
          let offset = array_expect_get ((&positions), bucket)
          let positions =
            array_expect_set (
              positions,
              bucket,
              range_start + offset
            )
          return shift (?positions, bucket + 1)
      let starts = shift (?relative, 0)
      let next = @array.copy (&starts)
      let rec buckets = fn (?current, ?positions, bucket) => do:
        if bucket >= 256:
          return (current, positions)
        else:
          let bucket_start = array_expect_get ((&starts), bucket)
          let bucket_count = array_expect_get ((&counts), bucket)
          let limit = bucket_start + bucket_count
          let rec place = fn (?state, ?next_positions) => do:
            let index = array_expect_get ((&next_positions), bucket)
            if index >= limit:
              return (state, next_positions)
            else:
              let entry = array_expect_get ((&state), index)
              let target_bucket =
                radix_digit (
                  entry.1,
                  place_value,
                  sign,
                  top_divisor
                )
              if target_bucket == bucket:
                return place (
                  state,
                  array_expect_set (
                    next_positions,
                    bucket,
                    index + 1
                  )
                )
              else:
                let target =
                  array_expect_get (
                    (&next_positions),
                    target_bucket
                  )
                let displaced = array_expect_get ((&state), target)
                let state =
                  array_expect_set (
                    array_expect_set (state, index, displaced),
                    target,
                    entry
                  )
                let next_positions =
                  array_expect_set (
                    next_positions,
                    target_bucket,
                    target + 1
                  )
                return place (state, next_positions)
          let (current, positions) = place (current, positions)
          return buckets (current, positions, bucket + 1)

      let (values, _) = buckets (values, next, 0)
      if place_value <= 1:
        return values
      else:
        let next_place = place_value / 256
        let rec children = fn (?current, bucket) => do:
          if bucket >= 256:
            return current
          else:
            let child_start = array_expect_get ((&starts), bucket)
            let child_count = array_expect_get ((&counts), bucket)
            let current = case child_count < 2 of
              #True => current
              #False => flag (
                current,
                child_start,
                child_start + child_count,
                next_place
              )
            return children (current, bucket + 1)
        return children (values, 0)

    return flag (?entries, start, stop, divisor)

const radix_unstable :: @forall (fn T => do:
    return (
      [(T, @type.int)],
      RadixSign,
      @type.int
    ) -> [(T, @type.int)]
  )
const radix_unstable = fn (?entries, sign, top_divisor) => do:
  let length = @array.len (&entries)
  return radix_flag_range (
    ?entries,
    0,
    length,
    top_divisor,
    sign,
    top_divisor
  )

const array_radix_sort :: @forall (fn T => do:
    return ([T], (T -> @type.int), RadixStrategy) -> [T]
  )
const array_radix_sort = fn (?values, key, strategy) => do:
  let length = @array.len (&values)
  if length < 1:
    return values
  else:
    let (entries, minimum, maximum, output) = array_radix_cache (values, key)
    let sign = case minimum >= 0 of
      #True => 0
      #False => case maximum < 0 of
        #True => 1
        #False => 2
    let top_divisor = radix_top_divisor (minimum, maximum, sign)
    let algorithm = case strategy of
      #Stable => radix_stable
      #Unstable => radix_unstable
    let sorted = algorithm (?entries, sign, top_divisor)
    let rec project = fn (?source, ?target, index) => do:
      if index >= length:
        let _ = Scratch.recycle source
        return Scratch.finish target
      else:
        let entry = array_expect_get ((&source), index)
        let target = Scratch.push (target, entry.0)
        return project (?source, ?target, index + 1)
    return project (?sorted, ?output, 0)

const Radix =
  {
    .stable = #Stable;
    .unstable = #Unstable;
  }

const array_swap_or_keep :: @forall (fn T => ([T], @type.int, @type.int) -> [T])
@[assert.reuse]
const array_swap_or_keep = fn (?values, left, right) => do:
  if left >= 0:
    if left < @array.len (&values):
      if right >= 0:
        if right < @array.len (&values):
          let left_value = @array.get (&values) left
          let right_value = @array.get (&values) right
          return @array.set
            (@array.set values left right_value)
            right
            left_value
        else:
          return values
      else:
        return values
    else:
      return values
  else:
    return values

const array_partition_before :: @forall (fn T => do:
    return (
      [T],
      @type.int,
      @type.int,
      T,
      ((T, T) -> (#True | #False))
    ) -> ([T], @type.int)
  )
const array_partition_before =
  fn (?values, start, end, pivot, before_or_equal) => do:
    @[assert.reuse]
    let rec go = fn (?current, scan, boundary) => do:
      return case scan >= end of
        #True => (current, boundary)
        #False => do:
          let value = array_expect_get ((&current), scan)
          return case before_or_equal (value, pivot) of
            #True => do:
              let current = array_swap_or_keep (current, scan, boundary)
              return go (?current, scan + 1, boundary + 1)
            #False => go (?current, scan + 1, boundary)

    return go (?values, start, start)

const array_expect_partition_last :: @forall (fn T => do:
    return (
      [T],
      SliceRange,
      ((T, T) -> (#True | #False))
    ) -> ([T], SliceRange, SliceRange)
  )
@[assert.reuse]
const array_expect_partition_last =
  fn (?values, bounds, before_or_equal) => do:
    let { .start; .end; } = slice_range_bounds bounds
    let last = end - 1
    let pivot = array_expect_get ((&values), last)
    let (values, boundary) =
      array_partition_before (values, start, last, pivot, before_or_equal)
    let values = array_swap_or_keep (values, boundary, last)
    return (
      values,
      slice_range_before (bounds, boundary),
      slice_range_after (bounds, boundary)
    )

const array_quicksort ::
  @forall (fn T => ([T], ((T, T) -> (#True | #False))) -> [T])
const array_quicksort = fn (values, before_or_equal) => do:
  let bounds = range_whole (&values)
  @[assert.reuse]
  let rec sort = fn (?current, current_bounds) => do:
    if slice_range_length current_bounds < 2:
      return current
    else:
      let (current, left, right) =
        array_expect_partition_last (
          current,
          current_bounds,
          before_or_equal
        )
      let (first, second) = range_shorter_first (left, right)
      let current = sort (?current, first)
      return sort (?current, second)

  return sort (?values, bounds)

const Array =
  {
    .empty = @array.empty;
    .append = array_append;
    .fold = fold;
    .map = array_map;
    .filter = array_filter;
    .partition = array_partition;
    .uncons = array_uncons;
    .items = array_items;
    .length = fn &values => @array.len (&values);
    .copy = fn &values => @array.copy (&values);
    .get = array_get;
    .expect_get = array_expect_get;
    .set = array_set;
    .push = fn (values, value) => @array.push values value;
    .swap_or_keep = array_swap_or_keep;
    .expect_partition_last = array_expect_partition_last;
    .quicksort = array_quicksort;
    .merge_sort = array_merge_sort;
    .radix_sort = array_radix_sort;
  }

const slice_whole :: @forall (fn T => @region.type T -> SliceRange)
const slice_whole = fn &region => do:
  return slice_range_value (0, slice_length (&region))

const slice_range :: @forall (fn T => do:
    return (@region.type T, @type.int, @type.int) ->
      (#Range SliceRange | #RangeOutOfBounds)
  )
const slice_range = fn (&region, start, end) => do:
  let length = slice_length (&region)
  if is_less (@int.cmp start 0):
    return #RangeOutOfBounds
  else:
    if is_less (@int.cmp end start):
      return #RangeOutOfBounds
    else:
      if is_less (@int.cmp length end):
        return #RangeOutOfBounds
      else:
        return #Range (slice_range_value (start, end))

const slice_expect_get :: @forall (fn T => (@region.type T, @type.int) -> T)
const slice_expect_get = fn (&region, index) => do:
  return case slice_get ((&region), index) of
    #Some value => value
    #None => @panic "index escaped its checked Slice range"

const slice_partition_in :: @forall (fn T => do:
    return (
      @region.type T,
      SliceRange,
      (T -> (#True | #False))
    ) -> (
      #Partitioned (@region.type T, @type.int) |
      #PartitionOutOfBounds (@region.type T, @type.int)
    )
  )
const slice_partition_in = fn (!region, bounds, belongs_left) => do:
  let { .start; .end; } = slice_range_bounds bounds
  return slice_partition_range (
    !region,
    start,
    end,
    belongs_left
  )

const slice_swap_or_keep :: @forall (fn T => do:
    return (@region.type T, @type.int, @type.int) -> @region.type T
  )
const slice_swap_or_keep = fn (!region, left, right) => do:
  return case slice_swap ((!region), left, right) of
    #Updated !updated => updated
    #SwapOutOfBounds !original => original

const Slice =
  {
    .of = @region.type;
    .Range = SliceRange;
    .copy = slice_copy;
    .length = slice_length;
    .get = slice_get;
    .expect_get = slice_expect_get;
    .set = slice_set;
    .replace = slice_replace;
    .swap = slice_swap;
    .swap_or_keep = slice_swap_or_keep;
    .partition = slice_partition;
    .partition_range = slice_partition_range;
    .partition_in = slice_partition_in;
    .whole = slice_whole;
    .range = slice_range;
    .range_length = slice_range_length;
    .range_last = slice_range_last;
    .range_before = slice_range_before;
    .range_after = slice_range_after;
    .split = slice_split;
    .join = slice_join;
    .reassociate_left = slice_reassociate_left;
    .reassociate_right = slice_reassociate_right;
    .freeze = slice_freeze;
  }

const Arena =
  {
    .singleton = fn value => [value];
    .insert = fn (?values, value) => do:
      let address = @array.len (&values)
      return (@array.push values value, address)
    ;
    .length = Array.length;
    .get = Array.get;
  }

const each = fn (values, visit) => do:
  result <- fold (
    values,
    (),
    fn (_, value) => do:
      <- visit value
  )
  return result

const map = array_map

const filter = array_filter

const partition = array_partition

const sum = fn values => do:
  return fold (
    values,
    0,
    fn (state, value) => @int.add state value
  )

const any :: @forall (fn T => ([T], T -> (#True | #False)) -> (#True | #False))
const any = fn (&values, holds) => do:
  return fold (
    values,
    False,
    fn (seen, value) => seen || holds value
  )

const every ::
  @forall (fn T => ([T], T -> (#True | #False)) -> (#True | #False))
const every = fn (&values, holds) => do:
  return fold (
    values,
    True,
    fn (seen, value) => seen && holds value
  )

const rec upto_build :: (@type.int, @type.int, [@type.int]) -> [@type.int]
const rec upto_build = fn (index, high, state) => do:
  if is_less (@int.cmp index high):
    return upto_build (
      @int.add index 1,
      high,
      @array.push state index
    )
  else:
    return state

const upto = fn (low, high) => upto_build (low, high, Array.empty)

// --- floats -----------------------------------------------------------------
//
// Attached operations do not imply overload resolution: an operator resolves
// to one binding by name, and a `+` that worked on both would have to dispatch
// on a value's type at run time — the typeclass machinery this language does
// not have. `F64.add` is the floating-point addition; integer operators remain
// fixed to `Int` and other domains use named calls.

const F64Operations =
  {
    .add = @float.add;
    .sub = @float.sub;
    .mul = @float.mul;
    .div = @float.div;
    .rem = @float.rem;
    .negate = @float.neg;
    // No `.eq`. Exact comparison is `is_equal (F64.cmp a b)`, which is the
    // same test and refuses NaN instead of quietly answering `#False` for it —
    // and a float equality that looks like the integer one invites the
    // comparison that `0.1 + 0.2` is famous for failing.
    .cmp = @float.cmp;
    .of_int = @float.of_int;
    .truncate = @int.of_float;
    .abs = fn value => do:
      if is_less (@float.cmp value 0.0):
        return @float.neg value
      else:
        return value
    ;

    // How a program asks before comparing. It cannot be written over `F64.cmp`,
    // because comparing a NaN is the thing that refuses — which is exactly why
    // this one is a primitive and float equality is not.
    .is_nan = @float.is_nan;

    // Newton's method, seeded at the value. Core has no f64 square root, so a
    // `@float.sqrt` primitive would have been open-coded at lowering anyway —
    // and a primitive is for what blot cannot write, which this is not.
    .sqrt = fn value => do:
      if is_equal (@float.cmp value 0.0):
        return 0.0
      else if is_less (@float.cmp value 0.0):
        return @float.div 0.0 0.0
      else:
        return fold (
          upto (0, 24),
          value,
          fn (guess, _) => do:
            return @float.mul 0.5 (@float.add guess (@float.div value guess))
        )
    ;
  }

// --- single precision -------------------------------------------------------
//
// The narrower float, reached by conversion rather than by a literal: there is
// one float token in the grammar and `F32.of_float` is what makes the loss of
// precision a step the program takes. It is also the lane type a four-wide
// vector wants, which is the other reason to have it at all.

const F32Operations =
  {
    .add = @f32.add;
    .sub = @f32.sub;
    .mul = @f32.mul;
    .div = @f32.div;
    .negate = @f32.neg;
    .cmp = @f32.cmp;
    .is_nan = @f32.is_nan;
    .of_float = @f32.of_float;
    .of_int = @f32.of_int;
    .widen = @float.of_f32;
    .truncate = fn value => @int.of_float (@float.of_f32 value);
    .abs = fn value => do:
      if is_less (@f32.cmp value (@f32.of_float 0.0)):
        return @f32.neg value
      else:
        return value
    ;

    // Core has no f32 remainder, so it is computed in double precision and
    // narrowed once at the end. Square root is a direct scalar operation.
    .rem = fn left => fn right => do:
      return @f32.of_float
        (@float.rem (@float.of_f32 left) (@float.of_f32 right))
    ;
    .sqrt = @f32.sqrt;
  }

// --- four lanes -------------------------------------------------------------
//
// One register rather than four fields. Each operation here is a single
// instruction in the emitted module, and the same arithmetic done one lane at a
// time when the backend is not asked for SIMD — so a program cannot tell which
// it got except by timing it.
//
// The lanes are read by name because the target has four instructions and no
// way to choose between them at run time. That is also why there is no `.get`
// taking an index.

const f32x4_dot :: @type.f32x4 -> @type.f32x4 -> @type.float32
const f32x4_dot = fn left => fn right => @f32x4.sum (@f32x4.mul left right)

const f32x4_scale :: (@type.f32x4, @type.float32) -> @type.f32x4
const f32x4_scale = fn (value, factor) => do:
  return @f32x4.mul value (@f32x4.splat factor)

const F32x4Operations =
  {
    .of = fn (x, y, z, w) => @f32x4.of x y z w;
    .splat = @f32x4.splat;
    .add = @f32x4.add;
    .sub = @f32x4.sub;
    .mul = @f32x4.mul;
    .div = @f32x4.div;
    .equal = @f32x4.eq;
    .less = @f32x4.less;
    .select = @f32x4.select;
    .shuffle = fn (left, right, lane0, lane1, lane2, lane3) => do:
      return @f32x4.shuffle left right lane0 lane1 lane2 lane3
    ;
    .swizzle = fn (value, lane0, lane1, lane2, lane3) => do:
      return @f32x4.shuffle value value lane0 lane1 lane2 lane3
    ;
    .x = @f32x4.x;
    .y = @f32x4.y;
    .z = @f32x4.z;
    .w = @f32x4.w;

    // A dot product is a multiply and three adds of the lanes. Written here
    // rather than as a primitive because it is writable here.
    // One instruction, where four extracts and three adds would be seven.
    .sum = @f32x4.sum;

    .dot = f32x4_dot;
    .scale = f32x4_scale;
  }

const I32x4Operations =
  {
    .of = fn (x, y, z, w) => @i32x4.of x y z w;
    .of_wrapping = fn (x, y, z, w) => @i32x4.of_wrapping x y z w;
    .splat = @i32x4.splat;
    .splat_wrapping = @i32x4.splat_wrapping;
    .add = @i32x4.add;
    .sub = @i32x4.sub;
    .mul = @i32x4.mul;
    .bit_and = @i32x4.and;
    .bit_or = @i32x4.or;
    .bit_xor = @i32x4.xor;
    .bit_not = @i32x4.not;
    .shift_left = fn value => fn amount => @i32x4.shl value amount;
    .shift_right_signed = fn value => fn amount => @i32x4.shr_s value amount;
    .shift_right_unsigned = fn value => fn amount => @i32x4.shr_u value amount;
    .equal = @i32x4.eq;
    .not_equal = @i32x4.ne;
    .less_signed = @i32x4.lt_s;
    .less_unsigned = @i32x4.lt_u;
    .greater_signed = @i32x4.gt_s;
    .greater_unsigned = @i32x4.gt_u;
    .less_or_equal_signed = @i32x4.le_s;
    .less_or_equal_unsigned = @i32x4.le_u;
    .greater_or_equal_signed = @i32x4.ge_s;
    .greater_or_equal_unsigned = @i32x4.ge_u;
    .min_signed = @i32x4.min_s;
    .min_unsigned = @i32x4.min_u;
    .max_signed = @i32x4.max_s;
    .max_unsigned = @i32x4.max_u;
    .select = @i32x4.select;
    .x = @i32x4.lane0;
    .y = @i32x4.lane1;
    .z = @i32x4.lane2;
    .w = @i32x4.lane3;
    .lane = @i32x4.lane;
    .with_x = fn value => fn lane => @i32x4.with_lane0 value lane;
    .with_y = fn value => fn lane => @i32x4.with_lane1 value lane;
    .with_z = fn value => fn lane => @i32x4.with_lane2 value lane;
    .with_w = fn value => fn lane => @i32x4.with_lane3 value lane;
    .with_x_wrapping = fn value => fn lane => do:
      return @i32x4.with_lane0_wrapping value lane
    ;
    .with_y_wrapping = fn value => fn lane => do:
      return @i32x4.with_lane1_wrapping value lane
    ;
    .with_z_wrapping = fn value => fn lane => do:
      return @i32x4.with_lane2_wrapping value lane
    ;
    .with_w_wrapping = fn value => fn lane => do:
      return @i32x4.with_lane3_wrapping value lane
    ;
    .mask_bits = fn mask => @i32x4.mask_bitmask mask;
    .all = fn mask => is_equal (@int.cmp (@i32x4.mask_all mask) 1);
    .any = fn mask => is_equal (@int.cmp (@i32x4.mask_any mask) 1);
  }

const I16x8Operations =
  {
    .splat = @i16x8.splat;
    .splat_wrapping = @i16x8.splat_wrapping;
    .add = @i16x8.add;
    .sub = @i16x8.sub;
    .mul = @i16x8.mul;
    .bit_and = @i16x8.and;
    .bit_or = @i16x8.or;
    .bit_xor = @i16x8.xor;
    .bit_not = @i16x8.not;
    .shift_left = fn value => fn amount => @i16x8.shl value amount;
    .shift_right_signed = fn value => fn amount => @i16x8.shr_s value amount;
    .shift_right_unsigned = fn value => fn amount => @i16x8.shr_u value amount;
    .equal = @i16x8.eq;
    .not_equal = @i16x8.ne;
    .less_signed = @i16x8.lt_s;
    .less_unsigned = @i16x8.lt_u;
    .greater_signed = @i16x8.gt_s;
    .greater_unsigned = @i16x8.gt_u;
    .less_or_equal_signed = @i16x8.le_s;
    .less_or_equal_unsigned = @i16x8.le_u;
    .greater_or_equal_signed = @i16x8.ge_s;
    .greater_or_equal_unsigned = @i16x8.ge_u;
    .min_signed = @i16x8.min_s;
    .min_unsigned = @i16x8.min_u;
    .max_signed = @i16x8.max_s;
    .max_unsigned = @i16x8.max_u;
    .select = @i16x8.select;
    .mask_bits = fn mask => @i16x8.mask_bitmask mask;
    .all = fn mask => is_equal (@int.cmp (@i16x8.mask_all mask) 1);
    .any = fn mask => is_equal (@int.cmp (@i16x8.mask_any mask) 1);
  }

const I8x16Operations =
  {
    .splat = @i8x16.splat;
    .splat_wrapping = @i8x16.splat_wrapping;
    .add = @i8x16.add;
    .sub = @i8x16.sub;
    .bit_and = @i8x16.and;
    .bit_or = @i8x16.or;
    .bit_xor = @i8x16.xor;
    .bit_not = @i8x16.not;
    .shift_left = fn value => fn amount => @i8x16.shl value amount;
    .shift_right_signed = fn value => fn amount => @i8x16.shr_s value amount;
    .shift_right_unsigned = fn value => fn amount => @i8x16.shr_u value amount;
    .equal = @i8x16.eq;
    .not_equal = @i8x16.ne;
    .less_signed = @i8x16.lt_s;
    .less_unsigned = @i8x16.lt_u;
    .greater_signed = @i8x16.gt_s;
    .greater_unsigned = @i8x16.gt_u;
    .less_or_equal_signed = @i8x16.le_s;
    .less_or_equal_unsigned = @i8x16.le_u;
    .greater_or_equal_signed = @i8x16.ge_s;
    .greater_or_equal_unsigned = @i8x16.ge_u;
    .min_signed = @i8x16.min_s;
    .min_unsigned = @i8x16.min_u;
    .max_signed = @i8x16.max_s;
    .max_unsigned = @i8x16.max_u;
    .select = @i8x16.select;
    .mask_bits = fn mask => @i8x16.mask_bitmask mask;
    .all = fn mask => is_equal (@int.cmp (@i8x16.mask_all mask) 1);
    .any = fn mask => is_equal (@int.cmp (@i8x16.mask_any mask) 1);
  }

// --- option and result ------------------------------------------------------

const Option = fn value => #None | #Some value
const None = #None
const Some = fn value => #Some value

const unwrap_or = fn (option, fallback) => case option of
  #Some value => value
  #None => fallback

const Result = fn (ok, error) => #Ok ok | #Error error
const Ok = fn value => #Ok value
const Error = fn value => #Error value

const Iterable = fn (collection, value, state) => {
  .items = collection -> {
    .state = state;
    .step = state -> Option (value, state);
  };
}

// --- iterators --------------------------------------------------------------
//
// An iterator is a `.state` and a `.step`, where `step state` answers
// `#Some (value, next_state)` or `#None`. Three things follow from that shape
// and are the reason for it.
//
// It answers an `Option` rather than a pair of new constructors. The prelude is
// in scope in every module that opens it, and lowering needs a constructor name
// to belong to one union per module — so a tag the prelude introduces is
// reserved everywhere. `#Some` and `#None` were already spent.
//
// It is a *state* and a step rather than a closure that returns the next
// closure. Both express the same protocol, but the closure form allocates one
// closure per element and leaves residual lowering resolving a lambda set that
// grows with the loop; this form is one closure total and a plain value threaded
// through it, which is an ordinary Runtime-HIR loop.
//
// The protocol is source. `range` and `items` are ordinary functions, so a new
// kind of sequence is a function someone writes rather than a case the compiler
// has to know about. `indexed` alone needs a primitive because its erased bounds
// evidence must not be forgeable as an ordinary record.

const ever =
  {
    .state = ();
    .step = fn _ => Some ((), ());
  }

const iter_range = fn (from, to) => {
  .state = from;
  .step = fn index => do:
    if is_less (@int.cmp index to):
      return Some (index, @int.add index 1)
    else:
      return None
  ;
}

const iter_items = array_items

// A half-open affine walk over one array Store. The state is only the logical
// index: `values`, `stop`, and `stride` are loop-invariant captures, so Runtime
// HIR can keep one Store identity and lower the walk to scalar induction plus
// `store.read`. A zero stride is empty rather than an accidental infinite loop.
//
// `slice` and `reverse` below are ordinary specializations. They deliberately
// return iterators, not arrays: the recommended consumer is still `for`, and no
// temporary collection is implied by selecting or reversing an address order.
const iter_affine_next =
  fn (values, index, stride) => case array_get (values, index) of
    #None => None
    #Some value => Some (value, @int.add index stride)

const iter_affine = fn (values, start, stop, stride) => {
  .state = start;
  .step = fn index => do:
    if is_less (@int.cmp 0 stride):
      if is_less (@int.cmp index stop):
        return iter_affine_next (values, index, stride)
      else:
        return None
    else:
      if is_less (@int.cmp stride 0):
        if is_less (@int.cmp stop index):
          return iter_affine_next (values, index, stride)
        else:
          return None
      else:
        return None
  ;
}

const iter_slice =
  fn (values, start, stop) => iter_affine (values, start, stop, 1)

const iter_reverse = fn values => do:
  return iter_affine (
    values,
    @int.sub (Array.length values) 1,
    -1,
    -1
  )

// Draining one. `for` is this loop with the accumulator inferred from the names
// its body rebinds; written out, it is the same fold.
const iterate ::
  @forall (fn State => @forall (fn Element => @forall (fn Carried => do:
    return (
      {
        .state = State;
        .step = State -> (#Some (Element, State) | #None);
      },
      Carried,
      (Carried, Element) -> Carried
    ) -> Carried
  )))
const iterate = fn (iterator, initial, visit) => do:
  let rec go =
    fn (state, carried) => case iterator.step state of
      #None => carried
      #Some pair => go (pair.1, visit (carried, pair.0))
  return go (iterator.state, initial)

const collect = fn iterator => do:
  let values = []
  for value in iterator:
    values := @array.push (Array.copy values) value

  return values

// Namespaced because `range` is already the type constructor — `I32` is a
// range — and two things called `range` in one scope would be worse than a
// prefix. Every other group in this file is a record for the same reason.
const Iter =
  {
    .range = iter_range;
    .items = iter_items;
    .affine = iter_affine;
    .slice = iter_slice;
    .reverse = iter_reverse;
    .indexed = @array.indexed;
    .iterate = iterate;
    .collect = collect;
  }

// --- polymorphic collections -----------------------------------------------

// Lists use `-1` as the empty address, leaving every array element available
// for a real node. A one-step view exposes ordinary constructor matching while
// retaining the compact arena in the tail.
const list_type = fn value => ([(value, @type.int)], @type.int)
const list_view = fn value => #Nil | #Cons (value, list_type value)
const list_empty = (Array.empty, -1)

const list_prepend = fn value => fn list => do:
  let (nodes, head) = list
  let address = @array.len (&nodes)
  return (@array.push nodes (value, head), address)

const list_uncons = fn list => do:
  let (nodes, head) = list
  if is_less (@int.cmp head 0):
    return #Nil
  else:
    return case array_get (nodes, head) of
      #Some node => #Cons (node.0, (nodes, node.1))
      #None => #Nil

const rec list_fold_nodes =
  fn (&nodes, address, state, visit) => do:
    if is_less (@int.cmp address 0):
      return state
    else:
      return case array_get ((&nodes), address) of
        #Some node => list_fold_nodes (
          (&nodes),
          node.1,
          visit (state, node.0),
          visit
        )
        #None => state

const list_fold = fn (list, state, visit) => do:
  let (nodes, head) = list
  return list_fold_nodes ((&nodes), head, state, visit)

const list_reverse_onto = fn (source, target) => do:
  return
    list_fold (source, target, fn (result, value) => list_prepend value result)

const list_reverse = fn list => list_reverse_onto (list, list_empty)

const list_append = fn left => fn right => do:
  return list_reverse_onto (list_reverse left, right)

const list_from_array = fn values => do:
  let reversed =
    fold (
      values,
      list_empty,
      fn (result, value) => list_prepend value result
    )
  return list_reverse reversed

const list_map = fn (list, transform) => do:
  let reversed =
    list_fold (
      list,
      list_empty,
      fn (result, value) => list_prepend (transform value) result
    )
  return list_reverse reversed

const list_filter = fn (list, keep) => do:
  let reversed =
    list_fold (
      list,
      list_empty,
      fn (result, value) => case keep value of
        #True => list_prepend value result
        #False => result
    )
  return list_reverse reversed

const list_to_array = fn list => do:
  return list_fold (
      list,
      Array.empty,
      fn (values, value) => @array.push values value
    )

const list_items = fn list => {
  .state = list;
  .step = fn state => case list_uncons state of
    #Nil => None
    #Cons (value, tail) => Some (value, tail)
  ;
}

const List =
  {
    .of = list_type;
    .view = list_view;
    .empty = list_empty;
    .singleton = fn value => list_prepend value list_empty;
    .prepend = list_prepend;
    .uncons = list_uncons;
    .append = list_append;
    .fold = list_fold;
    .map = list_map;
    .filter = list_filter;
    .reverse = list_reverse;
    .from_array = list_from_array;
    .to_array = list_to_array;
    .length = fn list => list_fold (list, 0, fn (count, _) => @int.add count 1);
    .items = list_items;
  }

const map_type = fn (key, value) => [(key, value)]

const map_get = fn (equal, entries, key) => do:
  let rec find =
    fn index => case array_get (entries, index) of
      #Some entry => case equal entry.0 key of
        #True => Some entry.1
        #False => find (@int.add index 1)

      #None => None
  return find 0

const map_put = fn (equal, entries, key, value) => do:
  let replaced =
    fold (
      entries,
      (Array.empty, None, False),
      fn (state, entry) => do:
        if state.2:
          return (@array.push (Array.copy state.0) entry, state.1, state.2)
        else if equal entry.0 key:
          return (
            @array.push (Array.copy state.0) (key, value),
            Some entry.1,
            True
          )
        else:
          return (@array.push (Array.copy state.0) entry, state.1, state.2)
    )
  let updated = case replaced.2 of
    #True => replaced.0
    #False => @array.push (Array.copy replaced.0) (key, value)
  return (replaced.1, updated)

const map_remove = fn (equal, entries, key) => do:
  let removed =
    fold (
      entries,
      (Array.empty, None, False),
      fn (state, entry) => do:
        if state.2:
          return (@array.push (Array.copy state.0) entry, state.1, state.2)
        else if equal entry.0 key:
          return (state.0, Some entry.1, True)
        else:
          return (@array.push (Array.copy state.0) entry, state.1, state.2)
    )
  return (removed.1, removed.0)

const map_with = fn equal => do:
  let put = fn (entries, key, value) => map_put (equal, entries, key, value)
  let append = fn left => fn right => do:
    return fold (
      right,
      left,
      fn (entries, entry) => (put (entries, entry.0, entry.1)).1
    )
  return {
    .of = map_type;
    .empty = Array.empty;
    .singleton = fn (key, value) => [(key, value)];
    .get = fn (entries, key) => map_get (equal, entries, key);
    .has = fn (entries, key) => case map_get (equal, entries, key) of
      #Some _ => True
      #None => False
    ;
    .put = put;
    .remove = fn (entries, key) => map_remove (equal, entries, key);
    .append = append;
    .fold = fold;
    .map = fn (entries, transform) => do:
      return array_map (
        entries,
        fn entry => (entry.0, transform entry.1)
      )
    ;
    .filter = array_filter;
    .length = Array.length;
    .keys = fn entries => array_map (entries, fn entry => entry.0);
    .values = fn entries => array_map (entries, fn entry => entry.1);
    .items = array_items;
  }

const Map = { .of = map_type; .with = map_with; }

const set_type = fn value => [value]

const set_has = fn (equal, values, needle) => do:
  return fold (
    values,
    False,
    fn (found, value) => found || equal value needle
  )

const set_insert :: @forall (fn T => do:
    return (
      T -> T -> (#True | #False),
      [T],
      T
    ) -> (#None | #Some T, [T])
  )
const set_insert = fn (equal, ?values, inserted) => do:
  let replaced =
    fold (
      values,
      (Array.empty, None, False),
      fn (state, value) => do:
        if state.2:
          return (@array.push (Array.copy state.0) value, state.1, state.2)
        else if equal value inserted:
          return (@array.push (Array.copy state.0) inserted, Some value, True)
        else:
          return (@array.push (Array.copy state.0) value, state.1, state.2)
    )
  let updated = case replaced.2 of
    #True => replaced.0
    #False => @array.push (Array.copy replaced.0) inserted
  return (replaced.1, updated)

const set_remove = fn (equal, values, needle) => do:
  let removed =
    fold (
      values,
      (Array.empty, None, False),
      fn (state, value) => do:
        if state.2:
          return (@array.push (Array.copy state.0) value, state.1, state.2)
        else if equal value needle:
          return (state.0, Some value, True)
        else:
          return (@array.push (Array.copy state.0) value, state.1, state.2)
    )
  return (removed.1, removed.0)

const set_with = fn equal => do:
  let insert =
    fn (?values, value) => set_insert (equal, Array.copy values, value)
  let union = fn left => fn right => do:
    return fold (
      right,
      left,
      fn (values, value) => (set_insert (equal, Array.copy values, value)).1
    )
  let map_with_equal = fn (values, mapped_equal, transform) => do:
    return fold (
      values,
      Array.empty,
      fn (mapped, value) => do:
        return (set_insert (mapped_equal, Array.copy mapped, transform value)).1
    )
  return {
    .of = set_type;
    .empty = Array.empty;
    .singleton = fn value => [value];
    .has = fn (values, value) => set_has (equal, values, value);
    .insert = insert;
    .remove = fn (values, value) => set_remove (equal, values, value);
    .append = union;
    .union = union;
    .intersect = fn left => fn right => do:
      return array_filter (
        left,
        fn value => set_has (equal, right, value)
      )
    ;
    .diff = fn left => fn right => do:
      return array_filter (
        left,
        fn value => not (set_has (equal, right, value))
      )
    ;
    .fold = fold;
    .filter = array_filter;
    .map = fn (values, transform) => map_with_equal (values, equal, transform);
    .map_with = map_with_equal;
    .length = Array.length;
    .items = array_items;
  }

const Set = { .of = set_type; .with = set_with; }

const Dict = map_with (fn left => fn right => text_eq (left, right))

// Stable insertion sort. `before (a, b)` is `#True` when `a` must come first;
// stability is what lets `packed` reorder by width without scrambling the
// declaration order of fields that tie.
//
// Written with `for` rather than a fold inside a fold: the inner pass carries
// two things at once, and naming them beats threading a record through a
// closure that has to rebuild it on every element.
const sort_by = fn (values, before) => do:
  let sorted = Array.empty
  for value in array_items values:
    let out = Array.empty
    let placed = False
    for existing in array_items (Array.copy sorted):
      let goes_first = not placed && before (value, existing)
      out := case goes_first of
        #True => @array.push (@array.push (Array.copy out) value) existing
        #False => @array.push (Array.copy out) existing
      placed := placed || goes_first

    sorted := case placed of
      #True => out
      #False => @array.push (Array.copy out) value

  return sorted

// --- types ------------------------------------------------------------------
//
// Every one of these is an ordinary function over compile-time values. There is
// no type-level sublanguage for them to live in.

const range = fn (low, high) => @type.range low high
const refine = fn (base, predicate) => @type.refine base predicate
const arrow = fn (domain, codomain) => @type.arrow domain codomain
const type_of = fn value => @type.of value
const seal = fn (name, value) => @type.seal name value
const unseal = fn value => @type.open value

// Attaching a namespace to a type value, which is what lets `struct` hand back
// the storage type itself rather than a record beside it. `<+` is this, and it
// is curried and left-associative, so a namespace is written as a sequence of
// attachments rather than as nested calls — which is as close to a sequence of
// statements as a language without assignment gets.
const attach = fn target => fn members => do:
  return fold (
    @shape.names members,
    target,
    fn (extended, name) => do:
      return @type.attach extended name (@shape.get members name)
  )

// The GPU frontend requires every integer literal to fit the signed 32-bit
// domain, so wider bounds are computed rather than spelled. Compile time is the
// same language, so this costs nothing at runtime.
const rec pow2 =
  fn n => do:
    if is_less (@int.cmp n 1):
      return 1
    else:
      return 2 * pow2 (@int.sub n 1)

// The arithmetic domains. Integer operations return signed-i64 `Int` without
// proving a narrower storage width, so a signature narrowing to `I32` is a real
// obligation rather than a formality.
const Int = attach (attach @type.int IntOrder) IntArithmetic
const Text = attach @type.text TextOperations

const F64 = attach @type.float F64Operations
const F32 = attach @type.float32 F32Operations
const F32x4 = attach @type.f32x4 F32x4Operations
const F32x4Mask = @type.f32x4_mask
const I32x4 = attach @type.i32x4 I32x4Operations
const I32x4Mask = @type.i32x4_mask
const I16x8 = attach @type.i16x8 I16x8Operations
const I16x8Mask = @type.i16x8_mask
const I8x16 = attach @type.i8x16 I8x16Operations
const I8x16Mask = @type.i8x16_mask
const likely = fn condition => @branch.likely condition
const unlikely = fn condition => @branch.unlikely condition

// Fixed-width integer types are ranges rather than another numeric domain.
// The width is compile-time information for storage tools; arithmetic still
// uses `Int` and has to prove a narrower result when a signature asks for one.
const integer_width = fn bits => case is_greater (@int.cmp bits 0) of
  #True => bits
  #False => do:
    return
      @fail (Text.append "integer bit width must be positive, found " (Text.of_int bits))

const U = fn bits => do:
  let width = integer_width bits
  return range (0, @int.sub (pow2 width) 1) <+ { .bit_width = width; }

const I = fn bits => do:
  let width = integer_width bits
  let magnitude = pow2 (@int.sub width 1)
  return range (
    @int.neg magnitude,
    @int.sub magnitude 1
  ) <+ { .bit_width = width; }

const I8 = I 8
const I16 = I 16
const I32 = I 32
const I64 = I 64
const U8 = U 8
const U16 = U 16
const U32 = U 32
const U64 = U 64
const Nat = range (0, @int.sub (pow2 63) 1)
const Unit = @type.unit

// Byte offsets and widths in declaration order, with no padding at all. This
// is the raw hook; `aligned` and `packed` below are written over the same
// idea rather than built in.
const layout = fn (shape, width_of) => do:
  let offset = 0
  let fields = Array.empty
  for name in array_items (@shape.names shape):
    let width = width_of (@shape.get shape name)
    fields := @array.push (Array.copy fields) {
      .name = name;
      .offset = offset;
      .width = width;
    }
    offset := @int.add offset width

  return { .size = offset; .fields = fields; }

// --- reflection -------------------------------------------------------------
//
// `@type.reflect` is the whole of the introspection machinery: it names which
// case of the value domain a type is and hands back the parts, as an ordinary
// tagged value. Everything below is blot over that result, using the `case`
// the language already has. There is no type-level `case`, because a type is
// not a different kind of thing to case on.

const reflect = fn t => @type.reflect t

// These are the two observations reflection intentionally cannot define for
// itself. Equality is alpha-equivalent, so compiler binder identities never
// become source data. Instantiation eliminates one outer binder without ever
// handing its open body to source.
const type_equal = fn (left, right) => @type.equal left right
const instantiate =
  fn (quantified, argument) => @type.instantiate quantified argument

// Width is part of the source-level namespace attached by `I` and `U`, not a
// new type-lattice case. A plain range carries no storage promise and therefore
// has no width to return here.
const bit_width = fn t => @shape.get (@type.members t) "bit_width"

// A union's members, and any other type as the one-member array. `Extract`,
// `Exclude`, and exhaustiveness checks are all folds over this.
const members = fn t => case reflect t of
  #Union options => options
  _ => [t]

// Union has no identity element, so rebuilding one is a primitive rather than a
// `fold`: an empty array is not the empty type, it is a mistake.
const union_of = fn values => @type.union_of values

// `value` sits at or above a range's low end. `#Unbounded` is below everything,
// and a bound in the wrong domain is not comparable rather than false-by-luck.
// One helper serves both a literal and another range's bound.
const above_low = fn (value, low) => case reflect low of
  #Unbounded => True
  #Int l => case reflect value of
    #Int v => not (is_less (@int.cmp v l))
    _ => False

  #Text l => case reflect value of
    #Text v => not (is_less (@text.cmp v l))
    _ => False

  _ => False

const below_high = fn (value, high) => case reflect high of
  #Unbounded => True
  #Int h => case reflect value of
    #Int v => not (is_greater (@int.cmp v h))
    _ => False

  #Text h => case reflect value of
    #Text v => not (is_greater (@text.cmp v h))
    _ => False

  _ => False

// A literal type is a singleton, so only the same literal refines it.
const refines_literal = fn (narrow, value) => case reflect narrow of
  #Int v => case reflect value of
    #Int w => Int.eq v w
    _ => False

  #Text v => case reflect value of
    #Text w => text_eq (v, w)
    _ => False

  _ => False

// Four domains, and every pair answered rather than defaulted. A `_` arm here
// would have hidden the next domain the way the two-armed version hid `F64`
// and `F32`, which reflected as `#Int` and made `refines (F64, Int)` true.
const same_domain = fn (left, right) => case left of
  #Int => case right of
    #Int => True
    #F64 => False
    #F32 => False
    #Text => False

  #F64 => case right of
    #F64 => True
    #Int => False
    #F32 => False
    #Text => False

  #F32 => case right of
    #F32 => True
    #Int => False
    #F64 => False
    #Text => False

  #Text => case right of
    #Text => True
    #Int => False
    #F64 => False
    #F32 => False

const rec admits_omission =
  fn type => case reflect type of
    #Unit => True
    #Union members => any (members, admits_omission)
    _ => False

// Does every value of `narrow` inhabit `wide`?
//
// This is the comptime mirror of what biunification decides during checking.
// It is written here rather than exposed from the checker on purpose: the
// checker's answer is about inferred types with variables in them, and this one
// is about ground compile-time values, which is the only thing a program can
// hold and ask about.
const rec refines =
  fn (narrow, wide) => case reflect wide of
    #Unbounded => True
    #Union options => any (options, fn option => refines (narrow, option))
    #Range r => case reflect narrow of
      // Same ordered domain first: an unbounded text range and an unbounded
      // integer range have identical bounds and are not each other.
      #Range s => same_domain (s.domain, r.domain) && above_low (s.low, r.low) && below_high (s.high, r.high)
      _ => above_low (narrow, r.low) && below_high (narrow, r.high)

    #Shape wide_fields => case reflect narrow of
      // Width and depth: a wider record refines a narrower one.
      #Shape narrow_fields => every (
        @shape.names wide_fields,
        fn name => do:
          if @shape.has narrow_fields name:
            return refines (
              @shape.get narrow_fields name,
              @shape.get wide_fields name
            )
          else:
            return admits_omission (@shape.get wide_fields name)
      )
      _ => False

    #Array wide_elements => case reflect narrow of
      #Array narrow_elements => case Int.eq (@array.len narrow_elements) (@array.len wide_elements) of
        #True => every (
          upto (0, @int.sub (@array.len wide_elements) 1),
          fn index => case (
            array_get (narrow_elements, index),
            array_get (wide_elements, index)
          ) of
            (#Some narrow_element, #Some wide_element) => refines (narrow_element, wide_element)
            _ => False
        )
        #False => False
      _ => False

    #Arrow w => case reflect narrow of
      // Contravariant in the domain, covariant in the codomain. The row is the
      // one part this cannot decide: an effect reflects as `#Opaque`, so there is
      // no way here to ask whether one row contains another. A function that
      // performs is therefore refused rather than guessed at — the checker
      // decides rows, at the signature, where both of them are known.
      // The calling convention is part of the arrow: a strict function does not
      // refine a deferred one, because the caller decides whether the argument
      // runs at all.
      #Arrow n => same_demand (n.deferred, w.deferred) && refines (w.domain, n.domain) && refines (n.codomain, w.codomain) && Int.eq (@array.len n.effects) 0
      _ => False

    #Tag w => case reflect narrow of
      #Tag n => text_eq (n.name, w.name) && (case w.payload of
        #None => case n.payload of
          #None => True
          #Some _ => False

        #Some carried => case n.payload of
          #Some mine => refines (mine, carried)
          #None => False

      )
      _ => False

    // A seal is invariant: same name, and carriers that refine each other.
    #Sealed w => case reflect narrow of
      #Sealed n => text_eq (n.name, w.name) && refines (n.inner, w.inner) && refines (w.inner, n.inner)
      _ => False

    #Int v => refines_literal (narrow, v)
    #Text v => refines_literal (narrow, v)
    #Unit => case reflect narrow of
      #Unit => True
      _ => False

    // Reflection keeps the open body private. Exact equality can still compare
    // quantified types modulo binder names; predicates that need to inspect a
    // body instantiate it explicitly with a closed type value first.
    #Forall => type_equal (narrow, wide)
    #Opaque => False

// --- asking about a type ----------------------------------------------------
//
// Predicate-form `@satisfies` hands a predicate the type of an expression, and a
// predicate is an ordinary function from a type value to a `Bool`. These are
// the two that would otherwise be written inline every time; anything more
// specific is `fn t => case reflect t of …`, which needs no help from here.

const Is = fn expected => fn t => type_equal (t, expected)
const Has = fn shape => fn t => refines (t, shape)

// The union members that fit the bound, and the ones that do not. `Extract` and
// `Exclude` read as they do in TypeScript, except that neither can quietly
// produce a bottom type, because blot does not have one — an empty result is
// reported where it happens.
const Extract = fn (whole, bound) => do:
  return union_of (filter (
    members whole,
    fn option => refines (option, bound)
  ))

const Exclude = fn (whole, bound) => do:
  return union_of (filter (
    members whole,
    fn option => not (refines (option, bound))
  ))

// The field-level pair. `@shape.*` already does the work; these only name it.
const Pick = fn (shape, names) => do:
  return fold (
    names,
    @shape.empty,
    fn (kept, name) => @shape.set kept name (@shape.get shape name)
  )

const Omit = fn (shape, names) => do:
  return fold (
    names,
    shape,
    fn (kept, name) => @shape.remove kept name
  )

// Matching a parameterized nominal. `opened ("List", t)` is `#Some element`
// when `t` is a `List` of something, which is the blot reading of writing
// `case t of List a => ...` in a language that had a type-level `case`.
const opened = fn (name, t) => case reflect t of
  #Sealed s => case text_eq (s.name, name) of
    #True => Some s.inner
    #False => None
  _ => None

const Reflect =
  {
    .of = reflect;
    .equal = type_equal;
    .instantiate = instantiate;
    .members = members;
    .union_of = union_of;
    .refines = refines;
    .extract = Extract;
    .exclude = Exclude;
    .pick = Pick;
    .omit = Omit;
    .opened = opened;
  }

// --- structs ----------------------------------------------------------------
//
// `struct` hands back the storage type *itself*, with its constructor and
// accessors attached to it by `<+`. One binding is both the type and its
// namespace, so `Point` can be written in a signature and still answer
// `Point.new`. The members are invisible to typing: `let p :: Point`
// constrains `p` to the tuple, and nothing about the namespace reaches the
// lattice.
//
// The storage is a tuple rather than an array because a tuple keeps one type
// per slot. `[I32, Text]` collapses to "an array of int-or-text" the moment
// inference looks at it, and storage that is imprecise is not predictable
// storage.
//
// There is no separate `structure (shape, order)`. A shape's fields are in
// declaration order and `reorder` rebuilds one in any other, so choosing a
// placement is an operation on the shape rather than a second entry point
// into the struct.

const reorder = fn (shape, order) => do:
  return fold (
    order,
    @shape.empty,
    fn (moved, name) => @shape.set moved name (@shape.get shape name)
  )

const struct = fn shape => do:
  let order = @linear.freeze (@shape.names shape)
  // Where each field lives.
  let next = 0
  let slots = @shape.empty
  for name in array_items (@array.copy (&order)):
    slots := @shape.set slots name next
    next := @int.add next 1

  let at = slots
  let key = fn name => Text.of_int (@shape.get at name)
  // One binding, rebound through both passes — the same shape binned's `struct`
  // has, where `product_type` is built by one loop and extended by the next.
  //
  // Two passes rather than one because they build different things: the first
  // fills a shape, and the second wraps that shape in a namespace. `@shape.set`
  // takes a shape and `@type.attach` takes a type value, so the storage has to
  // be finished before an accessor can go on it.
  let product = @shape.empty
  for name in array_items (@array.copy (&order)):
    product := @shape.set product (key name) (@shape.get shape name)

  // One accessor per field: a projection at a known slot, nothing more. The
  // names are computed, so this is `@type.attach` rather than `<+`.
  for name in array_items (@array.copy (&order)):
    product := @type.attach product name (fn value => do:
      return @shape.get value (key name)
    )

  return product <+ {
    // Named record in, positional storage out. The call site writes the fields
    // in whatever order reads well; the order decides where they land. A field
    // the shape does not declare is refused here rather than stored, and a
    // missing one fails on the read.
    .new = fn record => do:
      let _ = @satisfies (@shape.names record) order
      let product = @shape.empty
      for name in array_items (@array.copy (&order)):
        product := @shape.set product (key name) (@satisfies (@shape.get record name) (@shape.get shape name))

      return product
    ;

    // ...and back, so storage can be read by name without knowing the order.
    .named = fn value => do:
      let record = @shape.empty
      for name in array_items (@array.copy (&order)):
        record := @shape.set record name (@shape.get value (key name))

      return record
    ;

    .shape = shape;
    .fields = order;
    .size = @array.len order;
    .slot = fn name => @shape.get at name;
  }

// --- packing ----------------------------------------------------------------
//
// Deliberately not `struct` with a different order. A placement decides which
// slot a field occupies; packing describes which bits it occupies. `packed`
// reports that description and does not change the tuple representation that
// `struct` returns.

// Offsets in a given order, each field aligned to its own width. `.padding` is
// reported rather than hidden: a placement that wastes space should say so,
// because choosing a better order is the reason to look.
const aligned = fn (shape, order, width_of) => do:
  let offset = 0
  let padding = 0
  let fields = Array.empty
  for name in array_items (@array.copy (&order)):
    let width = width_of (@shape.get shape name)
    let slack = @int.rem offset width
    let pad = case Int.eq slack 0 of
      #True => 0
      #False => @int.sub width slack
    let start = @int.add offset pad
    fields := @array.push fields { .name = name; .offset = start; .width = width; }
    padding := @int.add padding pad
    offset := @int.add start width

  return { .size = offset; .padding = padding; .fields = fields; }

// Fields keep declaration order and occupy consecutive bits. The mask is the
// unshifted field mask; a consumer combines it with `bit_offset` when loading
// or storing a containing word. Tail padding is the unused part of the final
// byte, not space between fields.
const packed = fn shape => do:
  let order = @shape.names shape
  let bits = layout (shape, bit_width)
  let fields =
    freeze (map (
      bits.fields,
      fn field => {
        .name = field.name;
        .bit_offset = field.offset;
        .bit_width = field.width;
        .mask = @int.sub (pow2 field.width) 1;
      }
    ))
  let byte_size = @int.div (@int.add bits.size 7) 8
  return {
    .order = order;
    .bit_size = bits.size;
    .byte_size = byte_size;
    .trailing_bits = @int.sub (byte_size * 8) bits.size;
    .fields = fields;
    .bit_offset = fn name => fold (
      fields,
      None,
      fn (found, field) => do:
        if text_eq (field.name, name):
          return Some field.bit_offset
        else:
          return found
    );
  }


// --- owned ordered text maps -----------------------------------------------
//
// A sorted text-keyed map is an ordinary collection adapter over Slice. The
// entry product is a real Type value built by struct; its storage is still the
// two-slot tuple accepted by the persistent Map representation.
const ordered_text_map_entry_type =
  fn value => do:
    let entry = struct { .key = Text; .value = value; }
    return @type.attach entry "ordered_text_map_entry" ()

const ordered_text_map_type =
  fn value => @region.type (ordered_text_map_entry_type value)

const rec ordered_text_map_is_strict :: @forall (fn V => do:
    return ([ordered_text_map_entry_type V], Int, Int) -> Bool
  )
const rec ordered_text_map_is_strict =
  fn (&entries, index, length) => do:
    if index >= length:
      return True
    else:
      let previous = case array_get ((&entries), index - 1) of
        #Some entry => entry
        #None => @panic "ordered-map validation escaped its input"
      let current = case array_get ((&entries), index) of
        #Some entry => entry
        #None => @panic "ordered-map validation escaped its input"
      if is_less (@text.cmp previous.0 current.0):
        return ordered_text_map_is_strict (
          (&entries),
          index + 1,
          length
        )
      else:
        return False

const ordered_text_map_copy :: @forall (fn V => do:
    return [ordered_text_map_entry_type V] ->
      @region.type (ordered_text_map_entry_type V)
  )
const ordered_text_map_copy = fn entries => do:
  let length = @array.len (&entries)
  if ordered_text_map_is_strict ((&entries), 1, length):
    return @region.copy entries
  else:
    return @panic "OrderedTextMap.copy requires strictly increasing keys"

const ordered_text_map_validate ::
  @forall (fn V => [ordered_text_map_entry_type V] -> Bool)
const ordered_text_map_validate = fn &entries => do:
  let length = @array.len (&entries)
  return ordered_text_map_is_strict ((&entries), 1, length)

const rec ordered_text_map_lower_bound_from :: @forall (fn V => do:
    return (
      @region.type (ordered_text_map_entry_type V),
      Text,
      Int,
      Int
    ) -> Int
  )
const rec ordered_text_map_lower_bound_from =
  fn (&entries, key, low, high) => do:
    if low >= high:
      return low
    else:
      let middle = low + (high - low) / 2
      let entry = case @region.get (&entries) middle of
        #Some found => found
        #None => @panic "ordered-map search escaped its key range"
      if is_less (@text.cmp entry.0 key):
        return ordered_text_map_lower_bound_from (
          (&entries),
          key,
          middle + 1,
          high
        )
      else:
        return ordered_text_map_lower_bound_from (
          (&entries),
          key,
          low,
          middle
        )

const ordered_text_map_lower_bound :: @forall (fn V => do:
    return (
      @region.type (ordered_text_map_entry_type V),
      Text
    ) -> Int
  )
const ordered_text_map_lower_bound = fn (&entries, key) => do:
  let length = @region.length (&entries)
  return ordered_text_map_lower_bound_from (
    (&entries),
    key,
    0,
    length
  )

const ordered_text_map_get :: @forall (fn V => do:
    return (
      @region.type (ordered_text_map_entry_type V),
      Text
    ) -> (#Some V | #None)
  )
const ordered_text_map_get = fn (&entries, key) => do:
  let index = ordered_text_map_lower_bound ((&entries), key)
  return case @region.get (&entries) index of
    #Some entry => do:
      if text_eq (entry.0, key):
        return #Some entry.1
      else:
        return #None
    #None => #None

const ordered_text_map_replace :: @forall (fn V => do:
    return (
      @region.type (ordered_text_map_entry_type V),
      Text,
      V
    ) -> (
      #MapReplaced (V, @region.type (ordered_text_map_entry_type V)) |
      #MapMissing (V, @region.type (ordered_text_map_entry_type V))
    )
  )
const ordered_text_map_replace = fn (!entries, key, replacement) => do:
  let index = ordered_text_map_lower_bound ((&entries), key)
  return case @region.get (&entries) index of
    #Some entry => do:
      if text_eq (entry.0, key):
        return case @region.set (!entries) index (entry.0, replacement) of
          #Updated !updated => #MapReplaced (entry.1, updated)
          #SetOutOfBounds !original => #MapMissing (replacement, original)
      else:
        return #MapMissing (replacement, entries)
    #None => #MapMissing (replacement, entries)

const ordered_text_map_split_before :: @forall (fn V => do:
    return (
      @region.type (ordered_text_map_entry_type V),
      Text
    ) -> (#Split (
        @region.type (ordered_text_map_entry_type V),
        @region.type (ordered_text_map_entry_type V),
        @region.rejoin
      ) | #SplitOutOfBounds (
        @region.type (ordered_text_map_entry_type V)
      ))
  )
const ordered_text_map_split_before = fn (!entries, key) => do:
  let index = ordered_text_map_lower_bound ((&entries), key)
  return @region.split (!entries) index

const ordered_text_map_freeze :: @forall (fn V => do:
    return @region.type (ordered_text_map_entry_type V) ->
      [ordered_text_map_entry_type V]
  )
const ordered_text_map_freeze = fn !entries => @region.freeze (!entries)

const OrderedTextMap =
  {
    .entry = ordered_text_map_entry_type;
    .of = ordered_text_map_type;
    .validate = ordered_text_map_validate;
    .copy = ordered_text_map_copy;
    .length = slice_length;
    .lower_bound = ordered_text_map_lower_bound;
    .get = ordered_text_map_get;
    .replace = ordered_text_map_replace;
    .split_before = ordered_text_map_split_before;
    .join = slice_join;
    .reassociate_left = slice_reassociate_left;
    .reassociate_right = slice_reassociate_right;
    .freeze = ordered_text_map_freeze;
  }

const Type =
  {
    ...Type;
    .range = range;
    .refine = refine;
    .arrow = arrow;
    .of = type_of;
    .seal = seal;
    .unseal = unseal;
    .attach = attach;
  }

return {
  .Fn = Fn;
  .identity = identity;
  .freeze = freeze;
  .always = always;
  .compose = compose;
  .flip = flip;
  .tag = tag;
  .derive = derive;
  .test = test;
  .assert = assert;

  .Bool = Bool;
  .True = True;
  .False = False;
  .Logic = Logic;
  .not = not;
  .expect = expect;

  .Ordering = Ordering;
  .is_equal = is_equal;
  .is_less = is_less;
  .is_greater = is_greater;
  .likely = likely;
  .unlikely = unlikely;
  .Text = Text;
  .Empty = Empty;
  .Length = Length;
  .as_json = as_json;
  .as_const_json = as_const_json;
  .Semigroup = Semigroup;
  .Monoid = Monoid;
  .Mappable = Mappable;
  .Foldable = Foldable;
  .Filterable = Filterable;
  .Iterable = Iterable;

  .Array = Array;
  .Scratch = Scratch;
  .Radix = Radix;
  .Range = Range;
  .Slice = Slice;
  .Arena = Arena;
  .Continuation = Continuation;
  .fold = fold;
  .each = each;
  .map = map;
  .filter = filter;
  .partition = partition;
  .sum = sum;
  .upto = upto;
  .ever = ever;
  .Iter = Iter;
  .iterate = iterate;
  .collect = collect;
  .List = List;
  .Map = Map;
  .Set = Set;
  .Dict = Dict;
  .OrderedTextMap = OrderedTextMap;

  .Option = Option;
  .None = None;
  .Some = Some;
  .unwrap_or = unwrap_or;
  .Result = Result;
  .Ok = Ok;
  .Error = Error;

  .Type = Type;
  .attach = attach;
  .seal = seal;
  .unseal = unseal;
  .Reflect = Reflect;
  .reflect = reflect;
  .type_equal = type_equal;
  .instantiate = instantiate;
  .refines = refines;
  .Is = Is;
  .Has = Has;
  .members = members;
  .union_of = union_of;
  .Extract = Extract;
  .Exclude = Exclude;
  .Pick = Pick;
  .Omit = Omit;
  .opened = opened;
  .any = any;
  .every = every;
  .text_eq = text_eq;
  .range = range;
  .refine = refine;
  .bit_width = bit_width;
  .struct = struct;
  .reorder = reorder;
  .packed = packed;
  .layout = layout;
  .aligned = aligned;
  .sort_by = sort_by;
  .F64 = F64;
  .F32 = F32;
  .F32x4 = F32x4;
  .F32x4Mask = F32x4Mask;
  .I32x4 = I32x4;
  .I32x4Mask = I32x4Mask;
  .I16x8 = I16x8;
  .I16x8Mask = I16x8Mask;
  .I8x16 = I8x16;
  .I8x16Mask = I8x16Mask;
  .I = I;
  .I8 = I8;
  .I16 = I16;
  .I32 = I32;
  .I64 = I64;
  .U = U;
  .U8 = U8;
  .U16 = U16;
  .U32 = U32;
  .U64 = U64;
  .Nat = Nat;
  .Int = Int;
  .Unit = Unit;
}
