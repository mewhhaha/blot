// The prelude.
//
// Nothing here is built into the compiler. `Bool`, `Ord`, `+`, `struct`, and
// `fold` are ordinary blot declarations over the `@` primitives, which is what
// "few primitives" has to mean if it means anything.
//
// Two calling conventions, and the line between them is deliberate:
//
//   * anything an operator dispatches to is curried, because sections are the
//     point of an operator — `Num.add 2` is what makes `20 |> Num.add 2` work;
//   * every other multi-argument function takes one shape, because naming beats
//     position and a tuple is still one parameter.

// --- sets -------------------------------------------------------------------
//
// Types are sets, so the three set operations are one namespace rather than
// three loose primitives. `|` names `Set.union` exactly the way `+` names
// `Num.add`: the operator points at prelude source, and the prelude decides
// which primitive answers. Nothing about `|` is privileged, and this has to
// come first because the declarations below already use it.

const Set = {
  .union = left => (right => @type.union left right);
  .intersect = left => (right => @type.intersect left right);
  .diff = left => (right => @type.diff left right);
};

// --- functions --------------------------------------------------------------

const identity = value => value;
const always = value => (_ => value);

// Curried: these are the targets of `$` and `|>`.
const apply = f => (x => f x);
const pipe = x => (f => f x);

const compose = (f, g) => (x => f (g x));
const flip = f => ((a, b) => f (b, a));

const Fn = {
  .identity = identity;
  .always = always;
  .apply = apply;
  .pipe = pipe;
  .compose = compose;
  .flip = flip;
};

// --- booleans ---------------------------------------------------------------
//
// `#True` and `#False` are ordinary constructors. `if` accepts one of them and
// nothing else, so there is no truthiness anywhere in the language.

const True = #True;
const False = #False;
const Bool = #True | #False;

const not = value => case value of
  #True => False,
  #False => True
end;

const and = (left, right) => case left of
  #False => False,
  #True => right
end;

const or = (left, right) => case left of
  #True => True,
  #False => right
end;

const Logic = { .not = not; .and = and; .or = or; };

// --- ordering ---------------------------------------------------------------
//
// One comparison primitive yields the whole of `Eq` and `Ord`. Every member
// here is curried: they are all operator targets.

const Ordering = #Less | #Equal | #Greater;

// Matched exhaustively rather than with `_`. A wildcard arm leaves the
// constructor set unpinned in a polymorphic function, and the set is what the
// backend needs to build a Core union — so being explicit here is what lets
// every comparison in the language reach Wasm.
const is_equal = o => case o of
  #Equal => True,
  #Less => False,
  #Greater => False
end;

const is_less = o => case o of
  #Less => True,
  #Equal => False,
  #Greater => False
end;

const is_greater = o => case o of
  #Greater => True,
  #Less => False,
  #Equal => False
end;

const Ord = {
  .cmp = left => (right => @int.cmp left right);
  .eq = left => (right => is_equal (@int.cmp left right));
  .ne = left => (right => not (is_equal (@int.cmp left right)));
  .lt = left => (right => is_less (@int.cmp left right));
  .le = left => (right => not (is_greater (@int.cmp left right)));
  .gt = left => (right => is_greater (@int.cmp left right));
  .ge = left => (right => not (is_less (@int.cmp left right)));
  .min = left => (right => if is_greater (@int.cmp left right) then right else left end);
  .max = left => (right => if is_less (@int.cmp left right) then right else left end);
};

const Eq = { .eq = Ord.eq; .ne = Ord.ne; };

// --- numbers ----------------------------------------------------------------

const Num = {
  .add = left => (right => @int.add left right);
  .sub = left => (right => @int.sub left right);
  .mul = left => (right => @int.mul left right);
  .div = left => (right => @int.div left right);
  .rem = left => (right => @int.rem left right);
  .negate = value => @int.neg value;
  .abs = value => if is_less (@int.cmp value 0) then @int.neg value else value end;
  .succ = value => @int.add value 1;
  .pred = value => @int.sub value 1;
};

// --- text -------------------------------------------------------------------

const Text = {
  .append = left => (right => @text.concat left right);
  .length = value => @text.len value;
  .cmp = left => (right => @text.cmp left right);
  .of_int = value => @text.of_int value;
};

const Semigroup = { .append = Text.append; };

const text_eq = (left, right) => is_equal (@text.cmp left right);

// --- arrays -----------------------------------------------------------------

const Array = {
  .empty = @array.empty;
  .length = values => @array.len values;
  .get = (values, index) => @array.get values index;
  .set = (values, index, value) => @array.set values index value;
  .push = (values, value) => @array.push values value;
};

// Structural recursion, which is all a loop ever was. `for` does not exist in
// blot: there is no assignment for it to drive.
const fold = (values, state, step) => do
  const go = rec ((index, current) =>
    if is_less (@int.cmp index (@array.len values))
    then go (@int.add index 1, step (current, @array.get values index))
    else current
    end);
  return go (0, state);
end;

const each = (values, visit) =>
  fold (values, (), ((_, value) => visit value));

const map = (values, f) =>
  fold (values, @array.empty, ((state, value) => @array.push state (f value)));

const filter = (values, keep) =>
  fold (values, @array.empty, ((state, value) =>
    case keep value of
      #True => @array.push state value,
      #False => state
    end));

const sum = values => fold (values, 0, ((state, value) => @int.add state value));

const any = (values, holds) =>
  fold (values, False, ((seen, value) => Logic.or (seen, holds value)));

const every = (values, holds) =>
  fold (values, True, ((seen, value) => Logic.and (seen, holds value)));

const upto = (low, high) => do
  const build = rec ((index, state) =>
    if is_less (@int.cmp index high)
    then build (@int.add index 1, @array.push state index)
    else state
    end);
  return build (low, @array.empty);
end;

// --- option and result ------------------------------------------------------

const Option = value => #None | #Some value;
const None = #None;
const Some = value => #Some value;

const unwrap_or = (option, fallback) => case option of
  #Some value => value,
  #None => fallback
end;

const Result = (ok, error) => #Ok ok | #Error error;
const Ok = value => #Ok value;
const Error = value => #Error value;

// --- types ------------------------------------------------------------------
//
// Every one of these is an ordinary function over compile-time values. There is
// no type-level sublanguage for them to live in.

const range = (low, high) => @type.range low high;
const arrow = (domain, codomain) => @type.arrow domain codomain;
const type_of = value => @type.of value;
const seal = (name, value) => @type.seal name value;
const unseal = value => @type.open value;

// The GPU frontend requires every integer literal to fit the signed 32-bit
// domain, so wider bounds are computed rather than spelled. Compile time is the
// same language, so this costs nothing at runtime.
const pow2 = rec (n => if is_less (@int.cmp n 1) then 1 else @int.mul 2 (pow2 (@int.sub n 1)) end);

// The unbounded domains. Arithmetic returns these: `@int.add` does not prove
// its result fits a width, so a `sig` narrowing to `I32` is a real obligation
// rather than a formality.
const Int = @type.int;
const Str = @type.text;

const I32 = range (-2147483648, 2147483647);
const I64 = range (@int.neg (pow2 63), @int.sub (pow2 63) 1);
const U8 = range (0, 255);
const Nat = range (0, @type.unbounded);
const Unit = @type.unit;

// Field offsets and widths. This is the structuring and padding hook: `packed`
// and any other layout strategy are written over it rather than built in.
const layout = (shape, width_of) => do
  const names = @shape.names shape;
  const placed = fold (names, { .offset = 0; .fields = @array.empty; },
    ((state, name) => do
      const width = width_of (@shape.get shape name);
      return {
        .offset = @int.add state.offset width;
        .fields = @array.push state.fields {
          .name = name;
          .offset = state.offset;
          .width = width;
        };
      };
    end));
  return { .size = placed.offset; .fields = placed.fields; };
end;

// --- reflection -------------------------------------------------------------
//
// `@type.reflect` is the whole of the introspection machinery: it names which
// case of the value domain a type is and hands back the parts, as an ordinary
// tagged value. Everything below is blot over that result, using the `case`
// the language already has. There is no type-level `case`, because a type is
// not a different kind of thing to case on.

const reflect = t => @type.reflect t;

// A union's members, and any other type as the one-member array. `Extract`,
// `Exclude`, and exhaustiveness checks are all folds over this.
const members = t => case reflect t of
  #Union options => options,
  _ => [t]
end;

// Union has no identity element, so rebuilding one is a primitive rather than a
// `fold`: an empty array is not the empty type, it is a mistake.
const union_of = values => @type.union_of values;

// `value` sits at or above a range's low end. `#Unbounded` is below everything,
// and a bound in the wrong domain is not comparable rather than false-by-luck.
// One helper serves both a literal and another range's bound.
const above_low = (value, low) => case reflect low of
  #Unbounded => True,
  #Int l => case reflect value of
    #Int v => not (is_less (@int.cmp v l)),
    _ => False
  end,
  #Text l => case reflect value of
    #Text v => not (is_less (@text.cmp v l)),
    _ => False
  end,
  _ => False
end;

const below_high = (value, high) => case reflect high of
  #Unbounded => True,
  #Int h => case reflect value of
    #Int v => not (is_greater (@int.cmp v h)),
    _ => False
  end,
  #Text h => case reflect value of
    #Text v => not (is_greater (@text.cmp v h)),
    _ => False
  end,
  _ => False
end;

// A literal type is a singleton, so only the same literal refines it.
const refines_literal = (narrow, value) => case reflect narrow of
  #Int v => case reflect value of #Int w => Ord.eq v w, _ => False end,
  #Text v => case reflect value of #Text w => text_eq (v, w), _ => False end,
  _ => False
end;

// Does every value of `narrow` inhabit `wide`?
//
// This is the comptime mirror of what biunification decides during checking.
// It is written here rather than exposed from the checker on purpose: the
// checker's answer is about inferred types with variables in them, and this one
// is about ground compile-time values, which is the only thing a program can
// hold and ask about.
const refines = rec ((narrow, wide) => case reflect wide of
  #Unbounded => True,
  #Union options => any (options, (option => refines (narrow, option))),
  #Range r => case reflect narrow of
    #Range s => Logic.and (above_low (s.low, r.low), below_high (s.high, r.high)),
    _ => Logic.and (above_low (narrow, r.low), below_high (narrow, r.high))
  end,
  #Shape wide_fields => case reflect narrow of
    // Width and depth: a wider record refines a narrower one.
    #Shape narrow_fields => every (@shape.names wide_fields, (name =>
      if @shape.has narrow_fields name
      then refines (@shape.get narrow_fields name, @shape.get wide_fields name)
      else False
      end)),
    _ => False
  end,
  #Array wide_elements => case reflect narrow of
    #Array narrow_elements =>
      if Ord.eq (@array.len narrow_elements) (@array.len wide_elements)
      then every (upto (0, @int.sub (@array.len wide_elements) 1), (index =>
        refines (@array.get narrow_elements index, @array.get wide_elements index)))
      else False
      end,
    _ => False
  end,
  #Arrow w => case reflect narrow of
    // Contravariant in the domain, covariant in the codomain.
    #Arrow n => Logic.and (refines (w.domain, n.domain), refines (n.codomain, w.codomain)),
    _ => False
  end,
  #Tag w => case reflect narrow of
    #Tag n => Logic.and (text_eq (n.name, w.name), case w.payload of
      #None => case n.payload of #None => True, #Some _ => False end,
      #Some carried => case n.payload of
        #Some mine => refines (mine, carried),
        #None => False
      end
    end),
    _ => False
  end,
  // A seal is invariant: same name, and carriers that refine each other.
  #Sealed w => case reflect narrow of
    #Sealed n => Logic.and (text_eq (n.name, w.name),
      Logic.and (refines (n.inner, w.inner), refines (w.inner, n.inner))),
    _ => False
  end,
  #Int v => refines_literal (narrow, v),
  #Text v => refines_literal (narrow, v),
  #Unit => case reflect narrow of #Unit => True, _ => False end,
  #Opaque => False
end);

// The union members that fit the bound, and the ones that do not. `Extract` and
// `Exclude` read as they do in TypeScript, except that neither can quietly
// produce a bottom type, because blot does not have one — an empty result is
// reported where it happens.
const Extract = (whole, bound) =>
  union_of (filter (members whole, (option => refines (option, bound))));

const Exclude = (whole, bound) =>
  union_of (filter (members whole, (option => not (refines (option, bound)))));

// The field-level pair. `@shape.*` already does the work; these only name it.
const Pick = (shape, names) => fold (names, @shape.empty,
  ((kept, name) => @shape.set kept name (@shape.get shape name)));

const Omit = (shape, names) => fold (names, shape,
  ((kept, name) => @shape.remove kept name));

// Matching a parameterized nominal. `opened ("List", t)` is `#Some element`
// when `t` is a `List` of something, which is the blot reading of writing
// `case t of List a => ...` in a language that had a type-level `case`.
const opened = (name, t) => case reflect t of
  #Sealed s => if text_eq (s.name, name) then Some s.inner else None end,
  _ => None
end;

const Reflect = {
  .of = reflect;
  .members = members;
  .union_of = union_of;
  .refines = refines;
  .extract = Extract;
  .exclude = Exclude;
  .pick = Pick;
  .omit = Omit;
  .opened = opened;
};

// `struct` is the headline claim of "few primitives": naming a product type's
// fields and generating its constructor and accessors is ordinary code over
// `@shape.*`, not a compiler feature.
const struct = shape => do
  // One slot per field is the canonical layout. `layout` below is the hook for
  // any other strategy — `packed` is that call with a byte width instead of 1 —
  // so a struct always reports where its fields live, and never invents a
  // packing rule the program did not ask for.
  const placed = layout (shape, (_ => 1));
  return {
    .fields = @shape.names shape;
    .types = shape;
    .size = placed.size;
    .slots = placed.fields;
    .offset = name => fold (placed.fields, None,
      ((found, slot) => if text_eq (slot.name, name) then Some slot.offset else found end));
    .new = value => @satisfies value shape;
  };
end;

const Type = {
  .range = range;
  .union = Set.union;
  .intersect = Set.intersect;
  .diff = Set.diff;
  .arrow = arrow;
  .of = type_of;
  .seal = seal;
  .unseal = unseal;
  .struct = struct;
  .layout = layout;
};

return {
  .Fn = Fn;
  .identity = identity;
  .always = always;
  .compose = compose;
  .flip = flip;

  .Bool = Bool;
  .True = True;
  .False = False;
  .Logic = Logic;
  .not = not;

  .Ordering = Ordering;
  .Ord = Ord;
  .Eq = Eq;
  .Num = Num;
  .Text = Text;
  .Semigroup = Semigroup;

  .Array = Array;
  .fold = fold;
  .each = each;
  .map = map;
  .filter = filter;
  .sum = sum;
  .upto = upto;

  .Option = Option;
  .None = None;
  .Some = Some;
  .unwrap_or = unwrap_or;
  .Result = Result;
  .Ok = Ok;
  .Error = Error;

  .Type = Type;
  .Set = Set;
  .seal = seal;
  .unseal = unseal;
  .Reflect = Reflect;
  .reflect = reflect;
  .refines = refines;
  .members = members;
  .union_of = union_of;
  .Extract = Extract;
  .Exclude = Exclude;
  .Pick = Pick;
  .Omit = Omit;
  .opened = opened;
  .any = any;
  .every = every;
  .text_eq = text_eq;
  .range = range;
  .struct = struct;
  .layout = layout;
  .I32 = I32;
  .I64 = I64;
  .U8 = U8;
  .Nat = Nat;
  .Int = Int;
  .Str = Str;
  .Unit = Unit;
};
