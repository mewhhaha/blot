open import "blot:prelude"

const SparkExecutor = Resource.of "Spark.Executor"
const SparkScope = Resource.of "Spark.Scope"
const SparkJob = Resource.of_type "Spark.Job"

const SparkRuntime = @effect.host {
  .scope = {
    .signature = @forall (fn e => @forall (fn result => ((SparkExecutor, (SparkScope -> result) ~ [e]) -> result) ~ [e]));
    .input = (#Unrestricted, #Affine);
    .result = #Unrestricted;
    .suspends = True;
  };
  .child_scope = {
    .signature = @forall (fn e => @forall (fn result => ((SparkScope, (SparkScope -> result) ~ [e]) -> result) ~ [e]));
    .input = (#Unrestricted, #Affine);
    .result = #Unrestricted;
    .suspends = True;
  };
  .spawn = {
    .signature = @forall (fn e => @forall (fn result => ((SparkScope, (Unit -> result) ~ [e]) -> SparkJob result) ~ [e]));
    .input = (#Unrestricted, #Affine);
    .result = #Affine;
    .suspends = True;
  };
  .join = {
    .signature = @forall (fn result => SparkJob result -> result);
    .input = #Affine;
    .result = #Unrestricted;
    .suspends = True;
  };
  .parallel = {
    .signature = @forall (fn result => (SparkScope, Unit -> result) -> SparkJob result);
    .input = (#Unrestricted, #Affine);
    .result = #Affine;
    .suspends = True;
  };
  .cancel = {
    .signature = @forall (fn result => SparkJob result -> Unit);
    .input = #Affine;
    .result = #Unrestricted;
    .suspends = True;
  };
  .speculate = {
    .signature = @forall (fn result => (SparkScope, Unit -> result) -> SparkJob result);
    .input = (#Unrestricted, #Affine);
    .result = #Affine;
    .suspends = True;
  };
  .yield = Effect.suspends (SparkScope -> Unit);
  .on_exit = {
    .signature = @forall (fn e => ((SparkScope, (Unit -> Unit) ~ [e]) -> Unit) ~ [e]);
    .input = (#Unrestricted, #Affine);
    .result = #Unrestricted;
    .suspends = True;
  };
}

const map_parallel = fn scope => fn concurrency => fn transform => fn values => do:
  if concurrency < 1:
    return @panic "Spark.map_parallel requires positive concurrency"

  let shared = @linear.freeze values
  let length = Array.length shared
  return case Array.get (shared, 0) of
    #None => []
    #Some first => do:
      let ?work = fn () => transform first
      use initial <- SparkRuntime.parallel (scope, ?work)
      let rec fill = fn (index, ?jobs) => do:
        let pending = Array.length (&jobs)
        let can_spawn = case index < length of
          #True => pending < concurrency
          #False => False
        if can_spawn:
          let value = Array.expect_get (shared, index)
          let ?work = fn () => transform value
          use job <- SparkRuntime.parallel (scope, ?work)
          return fill (index + 1, @array.push (?jobs) (?job))
        else:
          return (index, ?jobs)
      let rec advance = fn (index, ?jobs, ?results) => do:
        use (next, pending) <- fill (index, ?jobs)
        return case Array.uncons (?pending) of
          #None => ?results
          #Some (job, remaining) => do:
            use value <- SparkRuntime.join (?job)
            return advance (next, ?remaining, @array.push (?results) value)

      use (next, pending) <- fill (1, [?initial])
      return case Array.uncons (?pending) of
        #None => @panic "Spark.map_parallel lost its first job"
        #Some (job, remaining) => do:
          use value <- SparkRuntime.join (?job)
          return advance (next, ?remaining, [value])

return {
  .Executor = SparkExecutor;
  .Scope = SparkScope;
  .Job = SparkJob;
  .Effect = SparkRuntime;
  .scope = fn executor => fn body => SparkRuntime.scope (executor, ?body);
  .child_scope = fn parent => fn body => SparkRuntime.child_scope (parent, ?body);
  .spawn = fn scope => fn ?work => SparkRuntime.spawn (scope, ?work);
  .join = SparkRuntime.join;
  .parallel = fn scope => fn ?work => SparkRuntime.parallel (scope, ?work);
  .speculate = fn scope => fn ?work => SparkRuntime.speculate (scope, ?work);
  .map_parallel = map_parallel;
  .cancel = SparkRuntime.cancel;
  .yield = SparkRuntime.yield;
  .on_exit = fn scope => fn ?cleanup => SparkRuntime.on_exit (scope, ?cleanup);
  }
