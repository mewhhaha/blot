open import "blot:prelude"
const T = import "../../../examples/lib/traversal.blot"

const Probe = { .label = Text; }
const Wave = [Probe]
const Plan = [Wave]

const waves: T.Traversal (Plan, Wave)
const waves = T.each
const probe_label: T.Traversal (Probe, Text)
const probe_label =
  T.one (
    fn probe => probe.label,
    fn (probe, label) => Shape.update (probe, { .label = label; })
  )

return T.compose (waves, probe_label)
