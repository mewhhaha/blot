open import "blot:prelude"

const L = import "../../../examples/lib/lens.blot"

const User = { .name = Text; }
const Address = { .city = Text; }

const user_name: L.Lens (User, Text)
const user_name =
  {
    .view = fn user => user.name;
    .set = fn (user, name) => Shape.update (user, { .name = name; });
  }

const address_city: L.Lens (Address, Text)
const address_city =
  {
    .view = fn address => address.city;
    .set = fn (address, city) => Shape.update (address, { .city = city; });
  }

// The outer lens focuses Text, but the inner lens requires Address as its whole.
// Composition must reject this path instead of discovering the mismatch at run time.
const invalid = L.compose (user_name, address_city)

return invalid
