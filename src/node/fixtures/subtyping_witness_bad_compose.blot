open import "blot:prelude"
const W = import "../../../examples/lib/subtyping_witness.blot"

const Rich = { .path = Text; .trace = Text; }
const Path = { .path = Text; }
const Healthy = #Ready | #Degraded Text
const Status = Healthy | #Failed Text

const to_path: W.Witness (Rich, Path)
const to_path = W.derive (Rich, Path)
const to_status: W.Witness (Healthy, Status)
const to_status = W.derive (Healthy, Status)

// The first target and second source are unrelated, so there is no shared
// intermediate carrier through which these witnesses can compose.
return W.compose (to_path, to_status)
