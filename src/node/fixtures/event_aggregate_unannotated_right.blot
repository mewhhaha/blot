open import "blot:prelude"
const A = import "../../../examples/lib/event_aggregate.blot"

const LeftCommand = #Add Int
const LeftEvent = #Added Int
const LeftError = #LeftRejected
const left :: A.Aggregate (Int, LeftCommand, LeftEvent, LeftError)
const left =
  {
    .initial = 0;
    .decide = fn (_, #Add amount) => Ok [#Added amount];
    .evolve = fn (state, #Added amount) => state + amount;
  }

const RightCommand = #Enable
const RightEvent = #Enabled
const RightError = #RightRejected
const right :: A.Aggregate (Bool, RightCommand, RightEvent, RightError)
const right =
  {
    .initial = #False;
    .decide = fn (_, #Enable) => Ok [#Enabled];
    .evolve = fn (_, #Enabled) => #True;
  }

// Pain point: this natural unannotated right branch currently checks as bottom
// even though evaluator and emitted-Wasm execution produce an Ok value.
const system = A.product (left, right)
return { .value = A.execute (system, (0, #False), #Right #Enable); }
