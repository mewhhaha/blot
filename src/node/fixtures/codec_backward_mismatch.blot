open import "blot:prelude"
const C = import "../../../examples/lib/codec.blot"

const Error = #Invalid
const Wrapped = { .value = Text; }
const base: C.Codec (Text, Text, Error)
const base = C.identity

const invalid: C.Codec (Wrapped, Text, Error)
const invalid =
  C.imap (
    base,
    fn value => { .value = value; },
    fn _wrapped => 1
  )
return invalid
