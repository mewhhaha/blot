open import "blot:prelude"
const Space = import "../../../examples/lib/coordinate_space.blot"

const Model = Space.space #Model
const World = Space.space #World
const Screen = Space.space #Screen

const model_to_world: Space.Transform (Model.tag, World.tag)
const model_to_world = {
  .point = fn point => { .frame = #World; .x = point.x; .y = point.y; };
  .vector = fn vector => { .frame = #World; .dx = vector.dx; .dy = vector.dy; };
}

const screen_to_world: Space.Transform (Screen.tag, World.tag)
const screen_to_world = {
  .point = fn point => { .frame = #World; .x = point.x; .y = point.y; };
  .vector = fn vector => { .frame = #World; .dx = vector.dx; .dy = vector.dy; };
}

return Space.compose (model_to_world, screen_to_world)
