open import "blot:prelude"
const Domain = import "../../../examples/lib/bounded_int_domain.blot"

const Percent = Domain.bounded (range (0, 100))
const CanaryPercent = Domain.bounded (range (5, 25))

let narrow: Percent.Type -> CanaryPercent.Type
let narrow = fn value => value

return { .default = narrow 50; }
