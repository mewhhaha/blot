open import "blot:prelude"
const Nominal = import "../../../examples/lib/nominal_domain.blot"

const First = Nominal.domain ("example.collision.v1", Int)
const Second = Nominal.domain ("example.collision.v1", Int)

const accept :: First -> Int
const accept = First.value

// Pain point: identical public name + carrier intentionally reconstructs one
// seal, even when two application authors intended different business domains.
return { .default = accept (Second.of 9); }
