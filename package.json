{
  "name": "@mewhhaha/blot",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./compiler": "./src/compiler.ts"
  },
  "scripts": {
    "blot": "tsx --import ./src/node/polyfills.mjs src/node/cli.ts",
    "check": "tsx --import ./src/node/polyfills.mjs src/node/cli.ts check examples/minimal.blot",
    "test": "pnpm test:node && pnpm test:regression",
    "test:node": "tsx --import ./src/node/polyfills.mjs --test src/node/*.test.ts",
    "test:regression": "node scripts/node_regression_tests.mjs",
    "smoke": "tsx --import ./src/node/polyfills.mjs src/node/cli.ts build examples/minimal.blot",
    "benchmark": "tsx --import ./src/node/polyfills.mjs experiments/node-wasm-benchmark.ts",
    "benchmark:owned-arrays": "tsx --import ./src/node/polyfills.mjs experiments/owned-arrays/benchmark.ts",
    "benchmark:owned-regions": "tsx --import ./src/node/polyfills.mjs experiments/owned-regions/benchmark.ts",
    "benchmark:owned-maps": "tsx --import ./src/node/polyfills.mjs experiments/owned-maps/benchmark.ts",
    "benchmark:owned-sorts": "tsx --import ./src/node/polyfills.mjs experiments/owned-sorts/benchmark.ts",
    "benchmark:predicate-refinements": "tsx --import ./src/node/polyfills.mjs experiments/predicate-refinements/benchmark.ts",
    "compiler:build": "deno run --allow-read --allow-write --allow-run=cargo,git,rustc --allow-env scripts/build_compiler.ts",
    "test:compiler": "cargo test --manifest-path compiler/Cargo.toml && deno run --allow-read scripts/verify_runtime.ts",
    "conformance": "deno run --allow-read scripts/verify_runtime.ts",
    "verify:compiler": "pnpm conformance",
    "compiler:download": "deno run --allow-read --allow-write --allow-run=gh,git scripts/download_compiler.ts",
    "compile:corpus": "deno run --allow-read scripts/compile_corpus.ts",
    "generate:health": "deno run --allow-read --allow-write scripts/generate_language_health.ts",
    "health": "deno run --allow-read scripts/generate_language_health.ts --check"
  },
  "dependencies": {
    "@mewhhaha/baba": "npm:@jsr/mewhhaha__baba@9.0.0",
    "@mewhhaha/gpupaper": "npm:@jsr/mewhhaha__gpupaper@0.1.6",
    "@std/path": "npm:@jsr/std__path@1.1.6"
  },
  "devDependencies": {
    "@std/assert": "npm:@jsr/std__assert@1.0.19",
    "@types/node": "22.20.1",
    "tsx": "4.23.5"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@11.21.0"
}
