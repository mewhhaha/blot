open import "blot:prelude"

const Terminal =
  @effect.host {
    .read_line = Unit -> Text;
    .write = Text -> Unit;
  }

const Model =
  @effect.host {
    .complete = Text -> Text;
  }

let transcript = ""
let turns = 0

for ever:
  use Terminal.write "You:"
  use prompt <- Terminal.read_line ()
  if text_eq (prompt, ""):
    break

  let request = transcript <> "\nUser: " <> prompt <> "\nAssistant:"
  use reply <- Model.complete request
  use Terminal.write (Text.append "Agent: " reply)
  transcript := request <> " " <> reply
  turns := turns + 1

return turns
