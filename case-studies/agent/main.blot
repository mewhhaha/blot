operators {
  infixl 65 (++) = Text.append;
}

open import "blot:prelude"

const Terminal =
  @effect.host {
    .read_line = Unit -> Str;
    .write = Str -> Unit;
  }

const Model =
  @effect.host {
    .complete = Str -> Str;
  }

let transcript = ""
let turns = 0

for ever:
  <- Terminal.write "You:"
  prompt <- Terminal.read_line ()
  if text_eq (prompt, ""):
    break

  let request = transcript ++ "\nUser: " ++ prompt ++ "\nAssistant:"
  reply <- Model.complete request
  <- Terminal.write (Text.append "Agent: " reply)
  transcript := request ++ " " ++ reply
  turns := turns + 1

return turns
