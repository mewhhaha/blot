open import "blot:prelude"

const Terminal =
  @effect.host {
    .read_line = Unit -> Str;
    .write = Str -> Unit;
  }

<- Terminal.write "What is your name?"
name <- Terminal.read_line ()

if text_eq (name, ""):
  <- Terminal.write "Hello, stranger."
  return ()

result <- Terminal.write (Text.append "Hello, " name)
export result
