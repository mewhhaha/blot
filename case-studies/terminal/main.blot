open {} = (@import "blot:prelude") ();

const Terminal = @effect.host {
  .read_line = Unit -> Str;
  .write = Str -> Unit;
};

let _ = Terminal.write "What is your name?";
name <- Terminal.read_line;

if text_eq (name, "") then do
  return Terminal.write "Hello, stranger.";
end;

return Terminal.write (Text.append "Hello, " name);
