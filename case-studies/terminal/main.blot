open import "blot:prelude"

const Terminal =
  @effect.host {
    .read_line = Unit -> Text;
    .write = Text -> Unit;
  }

use Terminal.write "What is your name?"
use name <- Terminal.read_line ()

if text_eq (name, ""):
  use Terminal.write "Hello, stranger."
  return ()

use result <- Terminal.write ("Hello, " <> name)
return result
