open import "blot:prelude"
const Mat4 = import "./matrix.blot"
const Transforms = import "./transforms.blot"
const Particles = import "./particles.blot"

const summarize ::
  Transforms.Scalar.Entity -> { .Id = Int; .Projected = Mat4.Vector; .Age = Int; }
const summarize =
  fn row => { .Id = row.Id; .Projected = row.Projected; .Age = row.Age; }
return { .default = {
  .batches = Transforms.Simd.plan.batches;
  .simd = map (Transforms.tick (Transforms.seed 3), summarize);
  .scalar = map (Transforms.Scalar.tick (Transforms.seed 3), summarize);
  .particles = Particles.run (Particles.seed 5, 3);
}; }
