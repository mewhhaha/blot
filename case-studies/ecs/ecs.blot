open import "blot:prelude"

const Stream = import "./streams.blot"
const Messages = import "./messages.blot"
const Systems = import "./systems.blot"
const Planning = import "./planning.blot"

const component = fn (name, T) => do:
  const Read = @effect { .get = Unit -> T; }
  return {
    .Type = T;
    .name = name;
    .Read = Read;
    .get = Read.get;
    .replace = fn (row, value) => { ...row; .[name] = @satisfies value T; };
  }

const archetype = fn schema => do:
  let components = Unit
  for name in Iter.items (@shape.names schema):
    components := @type.attach components name (component (name, @shape.get schema name))

  return schema <+ { .components = components; }

const Guard = @effect { .require = Bool -> Unit; }
const run_query = fn work => @handle (
  Guard,
  work,
  {
    .require = fn (condition, ?resume) => case condition of
      #True => resume ()
      #False => #None
    ;
    .return = fn value => #Some value;
  }
)

const has = fn name => fn Row => case @type.reflect Row of
  #Shape fields => @shape.has fields name
  _ => @fail "component queries require a record type"

const Query =
  {
    .has = has;
    .without = fn name => fn Row => not (has name Row);
    .all = fn (first, second) => fn Row => first Row && second Row;
    .any = fn (first, second) => fn Row => first Row || second Row;
    .not = fn predicate => fn Row => not (predicate Row);
    .guard = Guard.require;
    .run = run_query;
    .table = fn (Row, predicate) => do:
      const matches = predicate Row
      if matches:
        return fn (rows, select) => Stream.choose (
          Iter.items (@satisfies rows [Row]),
          select
        )
      else:
        return fn (rows, select) => { .state = 0; .step = fn _ => #None; }
    ;
    .merge = fn (left, right) => fn () => do:
      use first <- left ()
      use second <- right ()
      return (first, second)
    ;
    .map = fn (source, transform) => fn () => do:
      use value <- source ()
      return transform value
    ;
    .and_then = fn (source, choose) => fn () => do:
      use value <- source ()
      use result <- choose value ()
      return result
    ;
  }

// Only pure functions of one row enter a fused schedule. The arrow also
// requires every stage to preserve the archetype's complete component shape.
const Schedule = fn Row => do:
  const System = Row -> Row
  return {
    .empty = @satisfies identity System;
    .merge = fn (left, right) => do:
      let first = @satisfies left System
      let second = @satisfies right System
      return @satisfies (fn row => second (first row)) System
    ;
    .each = fn system => do:
      let step = @satisfies system System
      return @satisfies (fn rows => map (rows, step)) ([Row] -> [Row])
    ;
  }

return
  { .archetype; .Query; .Stream; .Messages; .Schedule; .Systems; .Planning; }
