open @import "blot:prelude" ()

const Arguments = @effect.host {
  .pattern = Unit -> Str;
}

const File = @effect.host {
  .line_count = Unit -> Int;
  .line = Int -> Str;
}

const Console = @effect.host {
  .write = Str -> Unit;
}

let count = 0
pattern <- Arguments.pattern ()
line_count <- File.line_count ()
for index in Iter.range (0, line_count):
  line <- File.line index
  let matching = Text.contains line pattern
  if matching:
    _ <- Console.write line

  count := if matching:
    return count + 1
  else:
    return count

return count
