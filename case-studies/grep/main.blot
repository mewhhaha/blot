open import "blot:prelude"

const Arguments =
  @effect.host {
    .pattern = Unit -> Text;
  }

const File =
  @effect.host {
    .line_count = Unit -> Int;
    .line = Int -> Text;
  }

const Console =
  @effect.host {
    .write = Text -> Unit;
  }

let count = 0
use pattern <- Arguments.pattern ()
use line_count <- File.line_count ()
for index in Iter.range (0, line_count):
  use line <- File.line index
  let matching = Text.contains line pattern
  if matching:
    use Console.write line

  count := case matching of
    #True => count + 1
    #False => count

return count
