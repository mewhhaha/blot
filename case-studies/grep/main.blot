open {} = (@import "blot:prelude") ();

const Arguments = @effect.host {
  .pattern = Unit -> Str;
};

const File = @effect.host {
  .line_count = Unit -> Int;
  .line = Int -> Str;
};

const Console = @effect.host {
  .write = Str -> Unit;
};

let count = 0;
pattern <- Arguments.pattern;
line_count <- File.line_count;
for index in Iter.range (0, line_count) do
  let line = File.line index;
  let matching = Text.contains line pattern;
  if matching then do
    let _ = Console.write line;
  end;
  count := if matching then count + 1 else count end;
end;

return count;
