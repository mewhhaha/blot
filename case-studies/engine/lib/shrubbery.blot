// Deterministic procedural voxels inspired by Shrubbery's source recipes.
//
// Every asset below is another Blot module. The runtime seed changes fine
// surface detail while the written records own silhouettes and colors.

open import "blot:prelude"

const oak = import "../shrubberies/oak.blot"
const fir = import "../shrubberies/fir.blot"
const flowers = import "../shrubberies/flowers.blot"
const rocks = import "../shrubberies/rocks.blot"
const R = import "./render.blot"

const DETAIL = 2
const VOXEL_SIZE = 225

const Stream =
  @effect.host {
    .batch_size = Unit -> Int;
    .yield = Unit -> Unit;
  }

const VoxelCanvas =
  @effect.host {
    .enabled = Unit -> Bool;
    .clear = Unit -> Unit;
    .voxel = {
      .x = Int; .y = Int; .z = Int;
      .scale = Int;
      .color = { .red = Int; .green = Int; .blue = Int; };
    } -> Unit;
    .present = Unit -> Unit;
    .redraw = Unit -> Unit;
  }

const Color = { .red = Int; .green = Int; .blue = Int; }
const Point = { .x = Int; .y = Int; .z = Int; }
const Voxel =
  {
    .id = Int;
    .x = Int;
    .y = Int;
    .z = Int;
    .color = Color;
  }
const Shrubbery = #Mixed | #Oak | #Fir | #FlowerPatch | #RockCluster
const Selection = { .key = Int; .name = Text; .shrubbery = Shrubbery; }
let selections :: [Selection]
let selections =
  [
    { .key = 1; .name = "mixed shrubbery"; .shrubbery = #Mixed; },
    { .key = 2; .name = "oak"; .shrubbery = #Oak; },
    { .key = 3; .name = "fir"; .shrubbery = #Fir; },
    { .key = 4; .name = "flower patch"; .shrubbery = #FlowerPatch; },
    { .key = 5; .name = "rock cluster"; .shrubbery = #RockCluster; }
  ]
const point :: (Int, Int, Int) -> Point
const point = fn (x, y, z) => { .x = x; .y = y; .z = z; }

const placement = fn (x, y, z) => point (x * DETAIL, y * DETAIL, z * DETAIL)

let selection_of = fn key => do:
  let selected = Array.expect_get ((&selections), 0)
  for candidate in Iter.items (Array.copy (&selections)):
    if candidate.key == key:
      selected := candidate

  return selected

const render_voxels_with_simd = fn &voxels => do:
  let count = Array.length (&voxels)
  let paint = fn draw => do:
    for index in Iter.range (0, count):
      let voxel = Array.expect_get ((&voxels), index)
      use draw.mesh {
        .position = R.point (
          voxel.x * VOXEL_SIZE,
          voxel.y * VOXEL_SIZE,
          voxel.z * VOXEL_SIZE
        );
        .angle = 0;
        .scale = R.unit VOXEL_SIZE;
        .color = voxel.color;
      }
  use R.frame (&paint)

const upload_voxels = fn &voxels => do:
  use accelerated <- VoxelCanvas.enabled ()
  use case accelerated of
    #False => render_voxels_with_simd (&voxels)
    #True => do:
      use VoxelCanvas.clear ()
      let count = Array.length (&voxels)
      for index in Iter.range (0, count):
        let voxel = Array.expect_get ((&voxels), index)
        use VoxelCanvas.voxel {
          .x = voxel.x * VOXEL_SIZE;
          .y = voxel.y * VOXEL_SIZE;
          .z = voxel.z * VOXEL_SIZE;
          .scale = VOXEL_SIZE;
          .color = voxel.color;
        }

      use VoxelCanvas.present ()

const render_voxels = fn &voxels => do:
  use accelerated <- VoxelCanvas.enabled ()
  use case accelerated of
    #False => render_voxels_with_simd (&voxels)
    #True => VoxelCanvas.redraw ()

const push_voxel = fn (?voxels, position, color) => do:
  let id = Array.length (&voxels)
  let first = Array.expect_get ((&voxels), 0)
  let duplicate =
    position.x == first.x && position.y == first.y && position.z == first.z
  let next = case duplicate of
    #True => voxels
    #False => @array.push voxels {
      .id = id;
      .x = position.x;
      .y = position.y;
      .z = position.z;
      .color = color;
    }
  return next

const start_voxels = fn (position, color) => do:
  let voxels :: [Voxel]
  let voxels =
    [
      {
        .id = 0;
        .x = position.x;
        .y = position.y;
        .z = position.z;
        .color = color;
      }
    ]
  use Stream.yield ()
  use upload_voxels (&voxels)
  return voxels

const push_voxel_if = fn (?voxels, visible, position, color) => case visible of
  #True => push_voxel (?voxels, position, color)
  #False => voxels

const stream_batch = fn (before, &voxels, batch, batches, batch_size) => do:
  let after = Array.length (&voxels)
  if after / batch_size > before / batch_size || batch + 1 == batches:
    use Stream.yield ()
    use upload_voxels (&voxels)

const generate_oak_batch = fn (
  ?voxels, start, volume, origin, seed, batch_size
) => do:
  let radius = 6 * DETAIL
  let trunk_height = oak.trunk_height * DETAIL
  let trunk_radius = oak.trunk_radius * DETAIL
  let height = trunk_height + 5 * DETAIL
  let width = radius * 2 + 1
  for offset in Iter.range (0, batch_size):
    let index = start + offset
    let x = index % width - radius
    let y = (index / width) % height
    let z = index / (width * height) - radius
    let distance = x * x + z * z
    let trunk = y <= trunk_height && distance <= trunk_radius * trunk_radius
    let branch_height = y - 6 * DETAIL
    let branch = False
    for direction in Iter.items (Array.copy (&oak.branches)):
      let branch_x = direction.x * branch_height / 5
      let branch_z = direction.z * branch_height / 5
      let branch_dx = x - branch_x
      let branch_dz = z - branch_z
      branch := branch || (
        y >= 6 * DETAIL && y <= 11 * DETAIL &&
        branch_dx * branch_dx + branch_dz * branch_dz <= DETAIL * DETAIL
      )

    let crown_y = y - 11 * DETAIL
    let crown =
      x * x * 2 + crown_y * crown_y * 3 + z * z * 2 <=
        75 * DETAIL * DETAIL
    let edge = Int.abs (x * 19 + y * 31 + z * 43 + seed) % 11
    let visible = index < volume && (trunk || branch || crown && edge > 1)
    let color = case trunk || branch, edge < 5, edge > 8 of
      #True, _, _ => oak.bark
      #False, #True, _ => oak.leaf_shadow
      #False, #False, #True => oak.leaf_sun
      #False, #False, #False => oak.leaf_green
    let next =
      push_voxel_if (
        ?voxels,
        visible,
        point (origin.x + x, origin.y + y, origin.z + z),
        color
      )
    voxels := next

  return voxels

const generate_oak = fn (?voxels, origin, seed, batch_size) => do:
  let radius = 6 * DETAIL
  let width = radius * 2 + 1
  let height = oak.trunk_height * DETAIL + 5 * DETAIL
  let volume = width * height * width
  let batches = (volume + batch_size - 1) / batch_size
  for batch in Iter.range (0, batches):
    let before = Array.length (&voxels)
    let next =
      generate_oak_batch (
        ?voxels, batch * batch_size, volume, origin, seed, batch_size
      )
    voxels := next
    use stream_batch (before, &voxels, batch, batches, batch_size)

  return voxels

const generate_fir_batch = fn (
  ?voxels, start, volume, origin, seed, batch_size
) => do:
  let radius = 6 * DETAIL
  let height = fir.height * DETAIL
  let width = radius * 2 + 1
  for offset in Iter.range (0, batch_size):
    let index = start + offset
    let x = index % width - radius
    let y = (index / width) % (height + 1)
    let z = index / (width * (height + 1)) - radius
    let trunk = x * x + z * z <= DETAIL * DETAIL
    let layer_radius = 7 * DETAIL - y / 2
    let along_x = Int.abs x <= layer_radius && Int.abs z <= DETAIL
    let along_z = Int.abs z <= layer_radius && Int.abs x <= DETAIL
    let cross =
      y >= fir.first_layer * DETAIL && y < height && (along_x || along_z)
    let sparse = Int.abs (x * 23 + y * 37 + z * 41 + seed) % 9
    let visible = index < volume && (trunk || cross && sparse > 0)
    let y_mod = y % 3
    let color = case (trunk, y_mod)  of
      (#True, _) => fir.trunk
      (_, 0) => fir.pine_shadow
      (_, 1) => fir.pine_green
      _ => fir.pine_tip

    let next =
      push_voxel_if (
        ?voxels,
        visible,
        point (origin.x + x, origin.y + y, origin.z + z),
        color
      )
    voxels := next

  return voxels

const generate_fir = fn (?voxels, origin, seed, batch_size) => do:
  let radius = 6 * DETAIL
  let width = radius * 2 + 1
  let height = fir.height * DETAIL
  let volume = width * (height + 1) * width
  let batches = (volume + batch_size - 1) / batch_size
  for batch in Iter.range (0, batches):
    let before = Array.length (&voxels)
    let next =
      generate_fir_batch (
        ?voxels, batch * batch_size, volume, origin, seed, batch_size
      )
    voxels := next
    use stream_batch (before, &voxels, batch, batches, batch_size)

  return voxels

const generate_flower_batch = fn (
  ?voxels, start, volume, origin, batch_size
) => do:
  let radius = 2 * DETAIL
  let width = radius * 2 + 1
  let height = 4 * DETAIL
  let flower_volume = width * height * width
  for offset in Iter.range (0, batch_size):
    let index = start + offset
    let flower_index =
      (index / flower_volume) % Array.length (&flowers.flowers)
    let flower = Array.expect_get ((&flowers.flowers), flower_index)
    let local = index % flower_volume
    let x = local % width - radius
    let y = (local / width) % height
    let z = local / (width * height) - radius
    let stem = x == 0 && z == 0 && y < 3 * DETAIL
    let blossom = y >= 3 * DETAIL && (x == 0 || z == 0)
    let visible = index < volume && (stem || blossom)
    let color = case stem, x, z of
      #True, _, _ => flowers.stem
      #False, 0, 0 => flowers.centre
      #False, _, _ => flower.petals
    let next =
      push_voxel_if (
        ?voxels,
        visible,
        point (
          origin.x + flower.x * DETAIL + x,
          origin.y + y,
          origin.z + flower.z * DETAIL + z
        ),
        color
      )
    voxels := next

  return voxels

const generate_flowers = fn (?voxels, origin, batch_size) => do:
  let radius = 2 * DETAIL
  let width = radius * 2 + 1
  let volume =
    Array.length (&flowers.flowers) * width * (4 * DETAIL) * width
  let batches = (volume + batch_size - 1) / batch_size
  for batch in Iter.range (0, batches):
    let before = Array.length (&voxels)
    let next =
      generate_flower_batch (
        ?voxels, batch * batch_size, volume, origin, batch_size
      )
    voxels := next
    use stream_batch (before, &voxels, batch, batches, batch_size)

  return voxels

const generate_rock_batch = fn (
  ?voxels, start, volume, max_volume, origin, batch_size
) => do:
  for offset in Iter.range (0, batch_size):
    let index = start + offset
    let rock_index = (index / max_volume) % Array.length (&rocks)
    let rock = Array.expect_get ((&rocks), rock_index)
    let local = index % max_volume
    let radius_x = rock.radii.x * DETAIL
    let radius_y = rock.radii.y * DETAIL
    let radius_z = rock.radii.z * DETAIL
    let width = radius_x * 2 + 1
    let height = radius_y * 2 + 1
    let depth = radius_z * 2 + 1
    let rock_volume = width * height * depth
    let xx = radius_y * radius_y * radius_z * radius_z
    let yy = radius_x * radius_x * radius_z * radius_z
    let zz = radius_x * radius_x * radius_y * radius_y
    let boundary = radius_x * radius_x * xx
    let x = local % width - radius_x
    let y = (local / width) % height - radius_y
    let z = local / (width * height) - radius_z
    let inside = x * x * xx + y * y * yy + z * z * zz <= boundary
    let visible = index < volume && local < rock_volume && inside
    let next =
      push_voxel_if (
        ?voxels,
        visible,
        point (
          origin.x + rock.centre.x * DETAIL + x,
          origin.y + rock.centre.y * DETAIL + y,
          origin.z + rock.centre.z * DETAIL + z
        ),
        rock.color
      )
    voxels := next

  return voxels

const generate_rocks = fn (?voxels, origin, batch_size) => do:
  let max_volume = 0
  for rock in Iter.items rocks:
    let radius_x = rock.radii.x * DETAIL
    let radius_y = rock.radii.y * DETAIL
    let radius_z = rock.radii.z * DETAIL
    let rock_volume =
      (radius_x * 2 + 1) * (radius_y * 2 + 1) * (radius_z * 2 + 1)
    if rock_volume > max_volume:
      max_volume := rock_volume

  let volume = Array.length (&rocks) * max_volume
  let batches = (volume + batch_size - 1) / batch_size
  for batch in Iter.range (0, batches):
    let before = Array.length (&voxels)
    let next =
      generate_rock_batch (
        ?voxels, batch * batch_size, volume, max_volume, origin, batch_size
      )
    voxels := next
    use stream_batch (before, &voxels, batch, batches, batch_size)

  return voxels

let build_mixed_shrubbery = fn (seed, batch_size) => do:
  use first <- start_voxels (placement (-5, 0, -2), oak.bark)
  let voxels = first
  use next <- generate_oak (
    Array.copy (&voxels), placement (-5, 0, -2), seed + 1729, batch_size
  )
  voxels := next
  use next <- generate_fir (
    Array.copy (&voxels), placement (6, 0, 5), seed + 3571, batch_size
  )
  voxels := next
  use next <- generate_flowers (
    Array.copy (&voxels), placement (0, 0, 0), batch_size
  )
  voxels := next
  use next <- generate_rocks (
    Array.copy (&voxels), placement (0, 0, 0), batch_size
  )
  voxels := next
  return voxels

let build_oak = fn (seed, batch_size) => do:
  use first <- start_voxels (placement (0, 0, 0), oak.bark)
  let voxels = first
  use next <- generate_oak (
    Array.copy (&voxels), placement (0, 0, 0), seed + 101, batch_size
  )
  voxels := next
  return voxels

let build_fir = fn (seed, batch_size) => do:
  use first <- start_voxels (placement (0, 0, 0), fir.trunk)
  let voxels = first
  use next <- generate_fir (
    Array.copy (&voxels), placement (0, 0, 0), seed + 503, batch_size
  )
  voxels := next
  return voxels

let build_flower_patch = fn batch_size => do:
  use first <- start_voxels (placement (-10, 0, -7), flowers.stem)
  let voxels = first
  use next <- generate_flowers (
    Array.copy (&voxels), placement (0, 0, 0), batch_size
  )
  voxels := next
  return voxels

let build_rock_cluster = fn batch_size => do:
  let first_rock = Array.expect_get ((&rocks), 0)
  use first <- start_voxels (placement (-10, 0, 6), first_rock.color)
  let voxels = first
  use next <- generate_rocks (
    Array.copy (&voxels), placement (0, 0, 0), batch_size
  )
  voxels := next
  return voxels

let build_shrubbery = fn (seed, selection) => do:
  use batch_size <- Stream.batch_size ()
  return case selection.shrubbery of
    #Mixed => build_mixed_shrubbery (seed, batch_size)
    #Oak => build_oak (seed, batch_size)
    #Fir => build_fir (seed, batch_size)
    #FlowerPatch => build_flower_patch batch_size
    #RockCluster => build_rock_cluster batch_size
return {
  .build_shrubbery = build_shrubbery;
  .render = render_voxels;
  .selection_of = selection_of;
  .selections = selections;
}
