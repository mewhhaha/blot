// Fixed-point arithmetic and trigonometry.
//
// Blot has one numeric type and it is an integer, so a 3D engine here is a
// fixed-point engine. `ONE` is the scale: a value of `4096` means 1.0, and the
// twelve fractional bits are enough for a scene measured in units and drawn to
// a few hundred pixels.
//
// The trig table is not shipped with this file and not built at startup — it
// is computed by the comptime evaluator, from the Taylor series below, and
// reaches WebAssembly as data. `const` is what forces that: the series runs
// while compiling or the program does not compile.

open {} = (@import "blot:prelude") ();

const ONE = 4096;

// A turn is 256 units, so an angle fits a byte and wraps by masking. The table
// covers one quarter turn inclusive, and the other three are reflections.
const TURN = 256;
const QUARTER = 64;

// pi/2 in fixed point, which is the widest argument the series is asked for.
const HALF_PI = 6434;

const mul = (a, b) => a * b / ONE;

// `b` is a fixed-point value, so the numerator is scaled first to keep the
// result in the same units.
const ratio = (a, b) => a * ONE / b;

// sin over [0, pi/2], four terms. Odd powers only, which is why the error at
// the endpoint is zero to the last bit: `sin_quarter QUARTER` is `ONE`.
const sin_quarter = k => do
  let x = HALF_PI * k / QUARTER;
  let x2 = x * x / ONE;
  let x3 = x2 * x / ONE;
  let x5 = x3 * x2 / ONE;
  let x7 = x5 * x2 / ONE;
  in x - x3 / 6 + x5 / 120 - x7 / 5040
end;

const table = fold (
  upto (0, QUARTER + 1),
  @array.empty,
  ((built, k) => @array.push built (sin_quarter k))
);

// `angle` is any integer; the quadrant decides which end of the table to read
// and which sign to give it.
const sin = angle => do
  let a = @int.rem (@int.rem angle TURN + TURN) TURN;
  let quadrant = a / QUARTER;
  let step = @int.rem a QUARTER;
  in if quadrant == 0 then @array.get table step
  else if quadrant == 1 then @array.get table (QUARTER - step)
  else if quadrant == 2 then 0 - @array.get table step
  else 0 - @array.get table (QUARTER - step)
  end
end;

const cos = angle => sin (angle + QUARTER);

// Newton's method on integers, for a fixed-point square root. Twelve rounds
// converge for every magnitude this engine produces, and a fixed count is what
// keeps it a plain expression rather than a loop with a termination argument.
const sqrt = value =>
  if value <= 0 then 0
  else fold (
    upto (0, 12),
    value,
    ((guess, _) => (guess + value * ONE / guess) / 2)
  )
  end;

return {
  .one = ONE;
  .turn = TURN;
  .quarter = QUARTER;
  .mul = mul;
  .ratio = ratio;
  .sin = sin;
  .cos = cos;
  .sqrt = sqrt;
};
