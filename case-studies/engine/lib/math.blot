// Trigonometry, in single precision.
//
// This file used to be fixed point at 4096, because blot had one numeric type
// and it was an integer, and the series had to avoid overflowing on the way to
// an answer it could only approach. It has been evaluated on the numbers it was
// derived for since the language had a float.
//
// The lanes are `F32` because the engine that reads them keeps its geometry in
// four-lane vectors and a lane is an `F32`. A table in double precision would
// be narrowed at every lookup, which is the same rounding done in the hottest
// place rather than once.
//
// Once, then: the series is evaluated in double precision and narrowed per
// entry as the table is built. Rounding the intermediates instead would be a
// worse table for nothing, because the arithmetic runs in the comptime
// evaluator, where an `F64` costs the artifact neither a byte nor an
// instruction.
//
// The table is built by the comptime evaluator. `const` is what forces that:
// the series runs while compiling or the program does not compile, so a quarter
// turn of sines reaches WebAssembly as data and the polynomial that produced it
// is not in the artifact.

open @import "blot:prelude" ()

const PI = 3.141592653589793
const TAU = 6.283185307179586
const HALF_PI = 1.5707963267948966

// A turn is 256 steps, which is what the host sends and what a spin counts in.
// Keeping the table indexed by step rather than by radians is what lets a
// lookup be an array read instead of a range reduction.
const TURN = 256
const QUARTER = 64

const STEP_RADIANS = Float32.of_float (Float.div TAU 256.0)

const radians = fn steps => Float32.mul (Float32.of_int steps) STEP_RADIANS

// sin over [0, pi/2], seven terms. Odd powers only, and evaluated left to
// right so each is the previous one times x squared — which keeps the largest
// intermediate at x to the thirteenth rather than a factorial.
const sin_quarter = fn k =>
  let x = Float.mul (Float.of_int k) (Float.div HALF_PI (Float.of_int QUARTER))
  let x2 = Float.mul x x
  let x3 = Float.mul x2 x
  let x5 = Float.mul x3 x2
  let x7 = Float.mul x5 x2
  let x9 = Float.mul x7 x2
  let x11 = Float.mul x9 x2
  let x13 = Float.mul x11 x2
  return Float.add
    (Float.sub
    (Float.add
    (Float.sub
    (Float.add
    (Float.sub x (Float.div x3 6.0))
    (Float.div x5 120.0))
    (Float.div x7 5040.0))
    (Float.div x9 362880.0))
    (Float.div x11 39916800.0))
    (Float.div x13 6227020800.0)

const table = fold (
  upto (0, QUARTER + 1),
  Array.empty,
  fn (built, k) => @array.push built (Float32.of_float (sin_quarter k))
)

const table_at = fn index => case Array.get (table, index) of
  #Some value => value
  #None => Float32.of_int 0

// `steps` is any integer; the quadrant decides which end of the table to read
// and which sign to give it.
const sin_steps = fn steps =>
  let a = @int.rem (@int.rem steps TURN + TURN) TURN
  let quadrant = a / QUARTER
  let step = @int.rem a QUARTER
  if quadrant == 0:
    return table_at step
  else if quadrant == 1:
    return table_at (QUARTER - step)
  else if quadrant == 2:
    return Float32.negate (table_at step)
  else:
    return Float32.negate (table_at (QUARTER - step))

const cos_steps = fn steps => sin_steps (steps + QUARTER)

return {
  .pi = Float32.of_float PI;
  .tau = Float32.of_float TAU;
  .turn = TURN;
  .quarter = QUARTER;
  .radians = radians;
  .sin = sin_steps;
  .cos = cos_steps;
  .sqrt = Float32.sqrt;
}
