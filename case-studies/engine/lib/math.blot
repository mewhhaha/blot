// Trigonometry, in floats.
//
// This file used to be fixed point at 4096, because blot had one numeric type
// and it was an integer. It does not any more, so angles are radians and the
// series below is evaluated on the numbers it was derived for rather than on
// scaled integers that had to avoid overflowing on the way to the answer.
//
// The table is still built by the comptime evaluator. `const` is what forces
// that: the series runs while compiling or the program does not compile, so a
// quarter turn of sines reaches WebAssembly as data and the polynomial that
// produced it is not in the artifact.

open {} = (@import "blot:prelude") ();

const PI = 3.141592653589793;
const TAU = 6.283185307179586;
const HALF_PI = 1.5707963267948966;

// A turn is 256 steps, which is what the host sends and what a spin counts in.
// Keeping the table indexed by step rather than by radians is what lets a
// lookup be an array read instead of a range reduction.
const TURN = 256;
const QUARTER = 64;

const radians = steps => Float.mul (Float.of_int steps) (Float.div TAU 256.0);

// sin over [0, pi/2], seven terms. Odd powers only, and evaluated left to
// right so each is the previous one times x squared — which keeps the largest
// intermediate at x to the thirteenth rather than a factorial.
const sin_quarter = k => do
  let x = Float.mul (Float.of_int k) (Float.div HALF_PI (Float.of_int QUARTER));
  let x2 = Float.mul x x;
  let x3 = Float.mul x2 x;
  let x5 = Float.mul x3 x2;
  let x7 = Float.mul x5 x2;
  let x9 = Float.mul x7 x2;
  let x11 = Float.mul x9 x2;
  let x13 = Float.mul x11 x2;
  in Float.add
    (Float.sub
      (Float.add
        (Float.sub
          (Float.add
            (Float.sub x (Float.div x3 6.0))
            (Float.div x5 120.0))
          (Float.div x7 5040.0))
        (Float.div x9 362880.0))
      (Float.div x11 39916800.0))
    (Float.div x13 6227020800.0)
end;

const table = fold (
  upto (0, QUARTER + 1),
  @array.empty,
  ((built, k) => @array.push built (sin_quarter k))
);

// `steps` is any integer; the quadrant decides which end of the table to read
// and which sign to give it.
const sin_steps = steps => do
  let a = @int.rem (@int.rem steps TURN + TURN) TURN;
  let quadrant = a / QUARTER;
  let step = @int.rem a QUARTER;
  in if quadrant == 0 then @array.get table step
  else if quadrant == 1 then @array.get table (QUARTER - step)
  else if quadrant == 2 then Float.negate (@array.get table step)
  else Float.negate (@array.get table (QUARTER - step))
  end
end;

const cos_steps = steps => sin_steps (steps + QUARTER);

return {
  .pi = PI;
  .tau = TAU;
  .turn = TURN;
  .quarter = QUARTER;
  .radians = radians;
  .sin = sin_steps;
  .cos = cos_steps;
  .sqrt = Float.sqrt;
};
