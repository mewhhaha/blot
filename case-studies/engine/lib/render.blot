// Fixed-function rendering: an orbit camera with two lenses, a unit cube, one
// light, and the two draw calls that reach the page.
//
// The geometry is four-lane vectors. A point is an `F32x4` whose fourth lane is
// 1 and a direction is one whose fourth lane is 0, which is the convention that
// turns a transform into a matrix and a matrix row into a dot product: the
// row's fourth lane is its translation and the point's decides whether that
// translation applies. So a model rotation, a camera, and a light are the same
// pair of operations over different rows — a lane-wise multiply and a
// horizontal sum — and a three-component vector rides in a four-lane register
// with the spare lane doing the work a fourth component would otherwise be.
//
// The two capabilities this module draws through are declared here rather than
// handed in. An effect's identity is its declaration site: a renderer that took
// a canvas as a module input would be taking a compile-time value with no
// runtime representation, and two modules that each declared their own would be
// two capabilities and two host imports. A library that uses an authority
// therefore owns it, and its importer receives that authority in its own effect
// row by importing the library.
//
// The boundary is also where the units change, because a float cannot cross a
// module boundary at all: the scene and the camera arrive as thousandths and
// the screen leaves as 1/256-pixel fixed point, and everything between them is
// a lane.

open import "blot:prelude"

const M = import "./math.blot"

// Residual host and loop signatures admit integer carriers, not narrowed range
// types. The constructor still requires U8 inputs, and scene hosts enforce the
// same range before returning a color.
const Color =
  {
    .red = Int;
    .green = Int;
    .blue = Int;
  }

const rgb :: (U8, U8, U8) -> Color
const rgb = fn (red, green, blue) => {
  .red = red;
  .green = green;
  .blue = blue;
}

// There is one float token in the grammar and it reads as an `F64`, so every
// single-precision constant below is a narrowing the module wrote down.
const lane = F32.of_float

const ZERO = lane 0.0
const ONE = lane 1.0

// Whole units on the far side of a module boundary are thousandths on the wire.
// One conversion at the edge, and nothing downstream knows.
const unit = fn value => F32.div (F32.of_int value) (lane 1000.0)

// A world point out of the host's thousandths. Its fourth lane is 1, which is
// what lets a camera row's translation reach it.
const point = fn (x, y, z) => F32x4.of (unit x, unit y, unit z, ONE)

// --- the host boundary ------------------------------------------------------

const Canvas =
  @effect.host {
    .clear = Unit -> Unit;
    // A projected triangle. Each vertex keeps its view depth so the host can
    // rasterize slanted faces without reducing them to a painter-order guess.
    .tri = {
    .ax = Int; .ay = Int; .az = Int;
    .bx = Int; .by = Int; .bz = Int;
    .cx = Int; .cy = Int; .cz = Int;
    .shade = Int;
    .color = Color;
    } -> Unit;
    // A 2D texture, always square to the screen. Under an orthographic lens this
    // is a plain sprite; under a perspective one it is a billboard, and the only
    // difference is what scaled its size.
    .sprite = {
    .x = Int; .y = Int;
    .size = Int;
    .depth = Int;
    .texture = Text;
    } -> Unit;
    .present = Unit -> Unit;
  }

// The camera lives in the host because the host owns the input device. Keeping
// it there is what lets the code hot-reload without losing the view.
const View =
  @effect.host {
    .yaw = Unit -> Int;
    .pitch = Unit -> Int;
    .distance = Unit -> Int;
    // `0` is a perspective lens and `1` is orthographic. A 2D scene is this
    // engine with the lens switched, not a second renderer.
    .lens = Unit -> Int;
  }

const Lens = #Perspective | #Orthographic

const lens_of :: Int -> Lens
const lens_of = fn encoded => case encoded of
  0 => #Perspective
  _ => #Orthographic

// --- the screen -------------------------------------------------------------

// The centre is what projection needs, so the extent is written as the centre
// rather than derived from a width and a height nothing else would read.
const CX = lane 240.0
const CY = lane 150.0

// Pixels across one unit at one unit of depth, and how close a vertex may come
// before its face is dropped.
const FOCAL = lane 420.0
const NEAR = lane 0.25
const SCREEN_SCALE = lane 256.0

// The screen centre, and the axes a view point is measured along to reach it. A
// screen's y counts down and a world's counts up, so the flip rides in the axis
// vector rather than in a subtraction that only one of the two lanes wants.
const SCREEN_CENTRE = F32x4.of (CX, CY, ZERO, ZERO)
const FOCAL_AXES = F32x4.of (FOCAL, F32.negate FOCAL, ZERO, ZERO)

// --- geometry ---------------------------------------------------------------
//
// A unit cube, as six faces with a normal each. Corners are named by index, so
// a face is four numbers rather than four points and its winding stays visible.
//
// A corner and a normal are both directions — a corner is an offset from the
// model's own origin — so both carry 0 in the fourth lane. Scaling and turning
// them is then lane-wise across all four, and adding the entity's position,
// whose fourth lane is 1, is the step that makes a corner a point.

const HALF = lane 0.5
const NEG_HALF = F32.negate HALF
const NEG_ONE = F32.negate ONE

const corners =
  [
    F32x4.of (NEG_HALF, NEG_HALF, NEG_HALF, ZERO),
    F32x4.of (HALF, NEG_HALF, NEG_HALF, ZERO),
    F32x4.of (HALF, HALF, NEG_HALF, ZERO),
    F32x4.of (NEG_HALF, HALF, NEG_HALF, ZERO),
    F32x4.of (NEG_HALF, NEG_HALF, HALF, ZERO),
    F32x4.of (HALF, NEG_HALF, HALF, ZERO),
    F32x4.of (HALF, HALF, HALF, ZERO),
    F32x4.of (NEG_HALF, HALF, HALF, ZERO)
  ]

const faces =
  [
    { .a = 1; .b = 0; .c = 3; .d = 2; .n = F32x4.of (ZERO, ZERO, NEG_ONE, ZERO); },
    { .a = 4; .b = 5; .c = 6; .d = 7; .n = F32x4.of (ZERO, ZERO, ONE, ZERO); },
    { .a = 0; .b = 4; .c = 7; .d = 3; .n = F32x4.of (NEG_ONE, ZERO, ZERO, ZERO); },
    { .a = 5; .b = 1; .c = 2; .d = 6; .n = F32x4.of (ONE, ZERO, ZERO, ZERO); },
    { .a = 3; .b = 7; .c = 6; .d = 2; .n = F32x4.of (ZERO, ONE, ZERO, ZERO); },
    { .a = 0; .b = 1; .c = 5; .d = 4; .n = F32x4.of (ZERO, NEG_ONE, ZERO, ZERO); }
  ]

// A fixed light, normalized in advance so shading stays one dot product. A
// direction, so its fourth lane is 0 and a normal's fourth lane never reaches
// the sum whatever it holds.
const LIGHT = F32x4.of (lane 0.53, lane 0.76, lane 0.38, ZERO)

// --- transforms -------------------------------------------------------------

// Rotation about Y, the only model rotation this engine has: a scene of
// spinning boxes needs one axis, and a second would be more code and no more
// to look at.
//
// Two rows rather than three, because the y row is (0, 1, 0, 0) and reading a
// lane is cheaper than dotting against it. Neither row translates, so the
// fourth lane passes through and a direction stays a direction.
const rotation_of = fn angle => do:
  let s = M.sin angle
  let c = M.cos angle
  return {
    .to_x = F32x4.of (c, ZERO, s, ZERO);
    .to_z = F32x4.of (F32.negate s, ZERO, c, ZERO);
  }

const turn_y = fn (point, rotation) => do:
  return F32x4.of (
    F32x4.dot point rotation.to_x,
    F32x4.y point,
    F32x4.dot point rotation.to_z,
    F32x4.w point
  )

// World to view: one dot per view coordinate, against the camera's own axes.
const to_view = fn (point, camera) => do:
  return F32x4.of (
    F32x4.dot point camera.right,
    F32x4.dot point camera.up,
    F32x4.dot point camera.forward,
    ONE
  )

// View to screen. The two lenses differ in what the view point is measured
// against: focal axes over its own depth, or zoom axes and no divide at all.
// That is the whole of "2D is an orthographic camera".
const to_screen = fn (view, camera) => case camera.lens of
  #Perspective => F32x4.add
      SCREEN_CENTRE
      (F32x4.div (F32x4.mul view FOCAL_AXES) (F32x4.splat (F32x4.z view)))

  #Orthographic => F32x4.add SCREEN_CENTRE (F32x4.mul view camera.zoom_axes)

// Where the camera sits, and the three rows that take a world point to it.
// Built once a frame rather than per vertex, because every vertex wants the
// same four sines.
const camera_of = fn (yaw, pitch, distance, lens) => do:
  let sin_yaw = M.sin_precise yaw
  let cos_yaw = M.cos_precise yaw
  let sin_pitch = M.sin_precise pitch
  let cos_pitch = M.cos_precise pitch
  // Pixels across one world unit, which is what the perspective divide works
  // out to at the camera's own distance — so switching lenses holds the scene
  // at roughly the size it already was, and pulling back still zooms out.
  let zoom = F32.div FOCAL distance
  return {
    .eye = F32x4.of (
    F32.mul distance (F32.mul cos_pitch sin_yaw),
    F32.mul distance sin_pitch,
    F32.mul distance (F32.mul cos_pitch cos_yaw),
    ONE
  );
    // `right` and `up` span the screen and `forward` grows away from the eye,
    // which is the sign the divide, the near test, and the host's sort all
    // want — so it is settled here rather than three times downstream.
    .right = F32x4.of (cos_yaw, ZERO, F32.negate sin_yaw, ZERO);
    .up = F32x4.of (
    F32.negate (F32.mul sin_pitch sin_yaw),
    cos_pitch,
    F32.negate (F32.mul sin_pitch cos_yaw),
    ZERO
  );
    // A row's fourth lane is its translation, and the eye is the whole of it.
    // Because the camera orbits the origin, that translation collapses: the eye
    // only ever moves along `forward`, so the two screen rows translate by
    // nothing and the depth row translates by the orbit radius. Subtracting the
    // eye per vertex would arrive at these same three numbers.
    .forward = F32x4.of (
    F32.negate (F32.mul cos_pitch sin_yaw),
    F32.negate sin_pitch,
    F32.negate (F32.mul cos_pitch cos_yaw),
    distance
  );
    .lens = lens;
    .zoom = zoom;
    .zoom_axes = F32x4.of (zoom, F32.negate zoom, ZERO, ZERO);
  }

// --- drawing ----------------------------------------------------------------

// How lit a face is: its world normal against the light, clamped, widened to
// the 0..255 the host multiplies the color by. The dot product is what the
// four lanes are for — one multiply and one horizontal sum.
const shade_of = fn normal => do:
  let dot = F32x4.dot normal LIGHT
  let lit = case is_less (F32.cmp dot ZERO) of
    #True => ZERO
    #False => dot
  return 60 + F32.truncate (F32.mul lit (lane 195.0))

// One face of one box: place its corners, project them, and hand the host two
// triangles. A face pointing away, or crossing the near plane, is dropped
// before either triangle is built.
const draw_face = fn (position, angle, scale, color, camera, face) => do:
  // Every corner of a box turns by the same angle, so the rows are built once
  // here rather than once per corner.
  let rotation = rotation_of angle
  // Scale, turn, place, and view — four steps and no field ever named. The add
  // is where the fourth lane changes from 0 to 1, and so where an offset from
  // the model's origin becomes a point the camera can translate.
  let corner = fn index => do:
    let local = case Array.get (corners, index) of
      #Some value => value
      #None => F32x4.splat ZERO
    let spun = turn_y (F32x4.scale (local, scale), rotation)
    return to_view (F32x4.add spun position, camera)
  let a = corner face.a
  let b = corner face.b
  let c = corner face.c
  let d = corner face.d
  let normal = turn_y (face.n, rotation)
  // Backface culling: a face is visible when its normal leans towards the
  // camera. Comparing against the box's centre rather than the face's own is
  // exact enough for convex geometry and costs one subtract and one dot.
  let outward = F32x4.dot normal (F32x4.sub position camera.eye)
  // The four view depths share one register. The comparison produces a mask,
  // and `any` decides whether one corner crossed the near plane.
  let za = F32x4.z a
  let zb = F32x4.z b
  let zc = F32x4.z c
  let zd = F32x4.z d
  let depths = F32x4.of (za, zb, zc, zd)
  let behind = F32x4.any (F32x4.less depths (F32x4.splat NEAR))
  let hidden = is_greater (F32.cmp outward ZERO)
  use case behind || hidden of
    #True => ()
    #False => do:
      // Fixed-point screen coordinates are the last place a float exists in
      // this function. `Canvas` is a module import, so its record is the
      // boundary a float cannot cross.
      let pixel = fn point => {
        .x = F32.truncate (F32.mul (F32x4.x point) SCREEN_SCALE);
        .y = F32.truncate (F32.mul (F32x4.y point) SCREEN_SCALE);
      }
      let pa = pixel (to_screen (a, camera))
      let pb = pixel (to_screen (b, camera))
      let pc = pixel (to_screen (c, camera))
      let pd = pixel (to_screen (d, camera))
      let millimetres = lane 1000.0
      let shade = shade_of normal
      use Canvas.tri {
        .ax = pa.x; .ay = pa.y;
        .az = F32.truncate (F32.mul za millimetres);
        .bx = pb.x; .by = pb.y;
        .bz = F32.truncate (F32.mul zb millimetres);
        .cx = pc.x; .cy = pc.y;
        .cz = F32.truncate (F32.mul zc millimetres);
        .shade = shade; .color = color;
      }
      use Canvas.tri {
        .ax = pa.x; .ay = pa.y;
        .az = F32.truncate (F32.mul za millimetres);
        .bx = pc.x; .by = pc.y;
        .bz = F32.truncate (F32.mul zc millimetres);
        .cx = pd.x; .cy = pd.y;
        .cz = F32.truncate (F32.mul zd millimetres);
        .shade = shade; .color = color;
      }

// A box. Six faces, each culled on its own, which is the whole of the mesh
// path — an application that wants a second shape adds geometry here rather
// than a second renderer.
const draw_mesh = fn (position, angle, scale, color, camera) => do:
  use each (
      faces,
      fn face => do:
        use draw_face (position, angle, scale, color, camera, face)
    )

// A 2D texture placed in the 3D world. Its size divides by depth under a
// perspective lens and does not under an orthographic one — the same one-line
// difference `to_screen` makes.
const draw_sprite = fn (position, scale, texture, camera) => do:
  let view = to_view (position, camera)
  let depth = F32x4.z view
  use case is_less (F32.cmp depth NEAR) of
    #True => ()
    #False => do:
      let point = to_screen (view, camera)
      let size = case camera.lens of
        #Perspective => F32.div (F32.mul scale FOCAL) depth
        #Orthographic => F32.mul scale camera.zoom
      use Canvas.sprite {
        .x = F32.truncate (F32.mul (F32x4.x point) SCREEN_SCALE);
        .y = F32.truncate (F32.mul (F32x4.y point) SCREEN_SCALE);
        .size = F32.truncate (F32.mul size SCREEN_SCALE);
        .depth = F32.truncate (F32.mul depth (lane 1000.0));
        .texture = texture;
      }

// A frame: clear, read the camera the host is holding, let the application say
// what is in the world, and present. The camera stays inside this module and
// the application receives the two brushes already carrying it, which is both
// how it gets read once a frame rather than once an entity and how an
// application never sees the four host integers or the lanes behind them.
//
// It is also what keeps the projection coherent. A camera is one record here
// and a different field subset at each of the four places that reads one, and
// the shapes only agree because inference sees the record reach them — which it
// can only do while the record does not leave.
let frame ::
  ({
    .mesh = {
      .position = F32x4;
      .angle = Int;
      .scale = F32;
      .color = Color;
    } -> Unit ~ { Canvas };
    .sprite = {
      .position = F32x4;
      .scale = F32;
      .texture = Text;
    } -> Unit ~ { Canvas };
  } -> Unit ~ { Canvas }) -> Unit ~ { Canvas, View }
let frame = fn &paint => do:
  use Canvas.clear ()
  use yaw <- View.yaw ()
  use pitch <- View.pitch ()
  use distance <- View.distance ()
  use encoded_lens <- View.lens ()
  let lens = lens_of encoded_lens
  let camera =
    camera_of (
      yaw,
      pitch,
      unit distance,
      lens
    )
  use paint {
    .mesh = (fn mesh => do:
      use draw_mesh (
        mesh.position,
        mesh.angle,
        mesh.scale,
        mesh.color,
        camera
      )
    );
    .sprite = (fn sprite => do:
      use draw_sprite (
        sprite.position,
        sprite.scale,
        sprite.texture,
        camera
      )
    );
  }
  use Canvas.present ()

// `Canvas` and `View` are not exported. An effect is a compile-time value and a
// module's exported record is a runtime one, so a capability cannot be handed
// out — and it does not need to be, because importing this module is already
// what puts `Canvas` and `View` in the importer's effect row.
return {
  .Color = Color;
  .rgb = rgb;
  .unit = unit;
  .point = point;
  .frame = frame;
}
