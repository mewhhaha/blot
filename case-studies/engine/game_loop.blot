// Procedural voxel shrubbery in an explicit immutable game state.
//
// Shrubbery recipes are Blot modules rather than serialized assets. The seed
// changes their surface detail while their source records own the silhouettes
// and colors.

open import "blot:prelude"

const R = import "./lib/render.blot"

const Host =
  @effect.host {
    .frame = Unit -> Int;
    .option = { .key = Int; .name = Text; } -> Unit;
    .seed = Unit -> Int;
    .selected = { .key = Int; .name = Text; } -> Unit;
    .selection = Unit -> Int;
  }

const S = import "./lib/shrubbery.blot"

const MeshDraft =
  {
    .x = Int;
    .y = Int;
    .z = Int;
    .color = R.Color;
  }
const Mesh = { .id = Int; ...MeshDraft; }

const Game =
  {
    .meshes = [Mesh];
  }

let render = fn game => do:
  use S.render (&game.meshes)

for option in Iter.items (Array.copy (&S.selections)):
  use Host.option { .key = option.key; .name = option.name; }

use seed <- Host.seed ()
use requested_selection <- Host.selection ()
let selection = S.selection_of requested_selection
use Host.selected { .key = selection.key; .name = selection.name; }
use meshes <- S.build_shrubbery (seed, selection)
let game :: Game
let game = { .meshes = meshes; }

let frames = 0
for ever:
  use remaining <- Host.frame ()
  if remaining <= 0:
    break

  use render game
  frames := frames + 1

return frames
