// A broad crown described as branch directions and named surface materials.

open import "blot:prelude"

const C = import "../lib/color.blot"

const Direction = { .x = Int; .z = Int; }
const OakRecipe =
  {
    .trunk_height = Int;
    .trunk_radius = Int;
    .branches = [Direction];
    .bark = C.Color;
    .leaf_shadow = C.Color;
    .leaf_green = C.Color;
    .leaf_sun = C.Color;
  }

let weathered_bark = C.rgb (88, 57, 38)
let deep_leaf_shadow = C.rgb (37, 92, 48)
let summer_leaf = C.rgb (55, 129, 62)
let sunlit_leaf = C.rgb (92, 164, 71)

let oak :: OakRecipe
let oak =
  {
    .trunk_height = 11;
    .trunk_radius = 1;
    .branches = [
      { .x = 5; .z = 1; },
      { .x = -4; .z = 3; },
      { .x = -2; .z = -5; },
      { .x = 4; .z = -3; },
      { .x = 1; .z = 5; }
    ];
    .bark = weathered_bark;
    .leaf_shadow = deep_leaf_shadow;
    .leaf_green = summer_leaf;
    .leaf_sun = sunlit_leaf;
  }

return oak
