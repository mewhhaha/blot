// Rounded boulders use the same voxel interpreter as the plants.

open import "blot:prelude"

const C = import "../lib/color.blot"

const Point = { .x = Int; .y = Int; .z = Int; }
const Rock = { .centre = Point; .radii = Point; .color = C.Color; }

let cool_granite = C.rgb (111, 119, 124)
let sun_warmed_stone = C.rgb (139, 124, 105)

let rocks :: [Rock]
let rocks =
  [
    {
      .centre = { .x = -10; .y = 0; .z = 6; };
      .radii = { .x = 3; .y = 2; .z = 2; };
      .color = cool_granite;
    },
    {
      .centre = { .x = 10; .y = -1; .z = -5; };
      .radii = { .x = 4; .y = 2; .z = 3; };
      .color = sun_warmed_stone;
    }
  ]

return rocks
