// Flower locations and colors are source values rather than host-side assets.

open import "blot:prelude"

const C = import "../lib/color.blot"

const Flower = { .x = Int; .z = Int; .petals = C.Color; }
const FlowerRecipe =
  { .stem = C.Color; .centre = C.Color; .flowers = [Flower]; }

let fresh_stem = C.rgb (49, 119, 61)
let pollen_centre = C.rgb (105, 67, 38)
let golden_petals = C.rgb (255, 188, 74)
let coral_petals = C.rgb (244, 113, 111)

let flowers :: FlowerRecipe
let flowers =
  {
    .stem = fresh_stem;
    .centre = pollen_centre;
    .flowers = [
      { .x = -10; .z = -7; .petals = golden_petals; },
      { .x = -7; .z = 9; .petals = coral_petals; },
      { .x = 8; .z = -10; .petals = coral_petals; },
      { .x = 11; .z = 7; .petals = golden_petals; }
    ];
  }

return flowers
