// A conifer recipe: height, crown profile, and its four source-level colors.

open import "blot:prelude"

const C = import "../lib/color.blot"

const FirRecipe =
  {
    .height = Int;
    .first_layer = Int;
    .trunk = C.Color;
    .pine_shadow = C.Color;
    .pine_green = C.Color;
    .pine_tip = C.Color;
  }

let red_brown_trunk = C.rgb (91, 61, 42)
let pine_shadow = C.rgb (26, 76, 54)
let pine_green = C.rgb (39, 111, 70)
let new_growth = C.rgb (78, 145, 82)

let fir :: FirRecipe
let fir =
  {
    .height = 14;
    .first_layer = 4;
    .trunk = red_brown_trunk;
    .pine_shadow = pine_shadow;
    .pine_green = pine_green;
    .pine_tip = new_growth;
  }

return fir
