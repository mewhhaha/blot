// A small 3D engine, in a language with no assignment.
//
// The world is a set of parallel arrays keyed by entity, and each system is a
// function over the arrays it reads — the layout an ECS arrives at. What the
// language adds is that the world does not have to be a value: a `for` body's
// `:=` names are its accumulator, so the frame loop at the bottom *is* the
// world. A system that does not rebind a name cannot affect it, which is the
// property an ECS normally arranges with scheduling and declared access.
//
// The geometry is in floats. It was fixed point at 4096 until the language had
// a second numeric type, and the only thing that changed at the boundary is
// where the conversion sits: a float cannot cross the module boundary, so the
// scene arrives as thousandths and the screen leaves as pixels, and everything
// between them is an `F64`. `lib/math.blot` still builds its trig table with
// the comptime evaluator, so the series that produced it is not in the
// artifact.
//
// The scene comes from the host and is rebuilt whenever the host says its
// generation changed, so editing `assets/scene.json` restocks the world without
// recompiling. The camera comes from the host too — which is what lets a code
// reload keep your viewpoint, since the viewpoint was never in here.

// `!=` is not in the default fixity table, and a default fixity names a binding
// by string — so declaring it here is the ordinary way to get one, not a
// workaround. It resolves to whatever `Eq.ne` the prelude opened below.
operators {
  infix 40 (!=) = Eq.ne;
};

open {} = (@import "blot:prelude") ();

const M = (@import "./lib/math.blot") ();

// The scene is whole units in the file and thousandths on the wire, because
// `Assets.entry` is a module import and a float has no layout to cross one in.
// One conversion at load, and nothing downstream knows.
const unit = value => Float.div (Float.of_int value) 1000.0;

// --- the host boundary ------------------------------------------------------
//
// Four capabilities and nothing else. There is no canvas handle, no file
// handle, and no clock; this program cannot reach the page except through them.

const Canvas = @effect.host {
  .clear = Unit -> Unit;
  // A projected triangle. `depth` is the view distance the host sorts by — the
  // guest owns geometry and the host owns rasterization order, which is the
  // same split a depth buffer makes.
  .tri = {
    .ax = Int; .ay = Int;
    .bx = Int; .by = Int;
    .cx = Int; .cy = Int;
    .depth = Int;
    .shade = Int;
    .colour = Str;
  } -> Unit;
  // A 2D texture, always square to the screen. Under an orthographic lens this
  // is a plain sprite; under a perspective one it is a billboard, and the only
  // difference is what scaled its size.
  .sprite = {
    .x = Int; .y = Int;
    .size = Int;
    .depth = Int;
    .texture = Str;
  } -> Unit;
  .present = Unit -> Unit;
};

// The camera lives in the host because the host owns the input device. Keeping
// it there is what lets the code hot-reload without losing the view.
const View = @effect.host {
  .yaw = Unit -> Int;
  .pitch = Unit -> Int;
  .distance = Unit -> Int;
  // `0` is a perspective lens and `1` is orthographic. A 2D scene is this
  // engine with the lens switched, not a second renderer.
  .lens = Unit -> Int;
};

const Assets = @effect.host {
  .generation = Unit -> Int;
  .count = Unit -> Int;
  .entry = Int -> {
    .kind = Int;
    .x = Int; .y = Int; .z = Int;
    .scale = Int;
    .spin = Int;
    .colour = Str;
  };
};

const Host = @effect.host {
  .frame = Unit -> Int;
};

// --- the screen -------------------------------------------------------------

const WIDTH = 480;
const HEIGHT = 300;
const CX = 240.0;
const CY = 150.0;

// Pixels across one unit at one unit of depth, and how close a vertex may come
// before its face is dropped.
const FOCAL = 420.0;
const NEAR = 0.25;

const KIND_MESH = 0;

// --- components -------------------------------------------------------------

const Vec3 = { .x = F64; .y = F64; .z = F64; };
// `angle` and `spin` stay integers: an angle is a step of a 256-part turn,
// which is what indexes the trig table and what the scene file counts in.
const Transform = { .position = Vec3; .angle = Int; .spin = Int; .scale = F64; };
const Model = { .kind = Int; .colour = Str; };

const Store = component => [Option component];

const attach = (store, value) => @array.push store (Some value);
const at = (store, id) => @array.get store id;
const count = store => @array.len store;

// The join every system here wants: rebuild the left store for entities that
// have both components and skip the rest. Written once, so the systems stay one
// expression each.
//
// The nesting is not a preference. `case (at (l, id), at (r, id)) of` with a
// tuple pattern says this in one arm, and that shape does not lower yet.
const each_2 = (left, right, step) => fold (
  upto (0, count left),
  left,
  ((state, id) => case at (left, id) of
    #Some a => case at (right, id) of
      #Some b => @array.set state id (Some (step (a, b))),
      #None => state
    end,
    #None => state
  end)
);

const visit_2 = (left, right, visit) => each (
  upto (0, count left),
  (id => case at (left, id) of
    #Some a => case at (right, id) of
      #Some b => visit (a, b),
      #None => ()
    end,
    #None => ()
  end)
);

// --- geometry ---------------------------------------------------------------
//
// A unit cube, as six faces with a normal each. Corners are named by index, so
// a face is four numbers rather than four points and its winding stays visible.

const HALF = 0.5;
const NHALF = Float.negate 0.5;
const ONE_F = 1.0;
const NONE_F = Float.negate 1.0;
const ZERO = 0.0;

const corners = [
  { .x = NHALF; .y = NHALF; .z = NHALF; },
  { .x = HALF; .y = NHALF; .z = NHALF; },
  { .x = HALF; .y = HALF; .z = NHALF; },
  { .x = NHALF; .y = HALF; .z = NHALF; },
  { .x = NHALF; .y = NHALF; .z = HALF; },
  { .x = HALF; .y = NHALF; .z = HALF; },
  { .x = HALF; .y = HALF; .z = HALF; },
  { .x = NHALF; .y = HALF; .z = HALF; }
];

const faces = [
  { .a = 1; .b = 0; .c = 3; .d = 2; .nx = ZERO; .ny = ZERO; .nz = NONE_F; },
  { .a = 4; .b = 5; .c = 6; .d = 7; .nx = ZERO; .ny = ZERO; .nz = ONE_F; },
  { .a = 0; .b = 4; .c = 7; .d = 3; .nx = NONE_F; .ny = ZERO; .nz = ZERO; },
  { .a = 5; .b = 1; .c = 2; .d = 6; .nx = ONE_F; .ny = ZERO; .nz = ZERO; },
  { .a = 3; .b = 7; .c = 6; .d = 2; .nx = ZERO; .ny = ONE_F; .nz = ZERO; },
  { .a = 0; .b = 1; .c = 5; .d = 4; .nx = ZERO; .ny = NONE_F; .nz = ZERO; }
];

// A fixed light, normalized in advance so shading stays one dot product.
const LIGHT = { .x = 0.53; .y = 0.76; .z = 0.38; };

// --- transforms -------------------------------------------------------------

// Rotation about Y, the only model rotation this engine has: a scene of
// spinning boxes needs one axis, and a second would be more code and no more
// to look at.
const turn_y = (point, angle) => do
  let s = M.sin angle;
  let c = M.cos angle;
  in {
    .x = Float.add (Float.mul point.x c) (Float.mul point.z s);
    .y = point.y;
    .z = Float.sub (Float.mul point.z c) (Float.mul point.x s);
  }
end;

// World to view. The camera orbits the origin, so its rotation is the inverse
// of the yaw and pitch that placed it.
const to_view = (point, camera) => do
  let dx = Float.sub point.x camera.eye.x;
  let dy = Float.sub point.y camera.eye.y;
  let dz = Float.sub point.z camera.eye.z;
  let x1 = Float.sub (Float.mul dx camera.cos_yaw) (Float.mul dz camera.sin_yaw);
  let z1 = Float.add (Float.mul dx camera.sin_yaw) (Float.mul dz camera.cos_yaw);
  in {
    .x = x1;
    .y = Float.sub
      (Float.mul dy camera.cos_pitch)
      (Float.mul z1 camera.sin_pitch);
    // Negated because the rotations above put the forward axis at -z, the
    // convention a projection matrix expects. Everything downstream wants a
    // depth that grows away from the eye, so the sign is fixed here rather
    // than in the divide, the near test, and the sort.
    .z = Float.negate (Float.add
      (Float.mul dy camera.sin_pitch)
      (Float.mul z1 camera.cos_pitch));
  }
end;

// View to screen. The two lenses differ in one line: a perspective divide, or
// no divide at all. That is the whole of "2D is an orthographic camera".
const to_screen = (view, camera) =>
  if camera.lens == 0
  then {
    .x = Float.add CX (Float.div (Float.mul view.x FOCAL) view.z);
    .y = Float.sub CY (Float.div (Float.mul view.y FOCAL) view.z);
  }
  else {
    .x = Float.add CX (Float.mul view.x camera.zoom);
    .y = Float.sub CY (Float.mul view.y camera.zoom);
  }
  end;

// Where the camera sits, and the rotations that undo getting it there. Built
// once a frame rather than per vertex, because every vertex wants the same four
// sines.
const camera_of = (yaw, pitch, distance, lens) => do
  let flat = M.cos pitch;
  in {
    .eye = {
      .x = Float.mul distance (Float.mul flat (M.sin yaw));
      .y = Float.mul distance (M.sin pitch);
      .z = Float.mul distance (Float.mul flat (M.cos yaw));
    };
    .sin_yaw = M.sin yaw;
    .cos_yaw = M.cos yaw;
    .sin_pitch = M.sin pitch;
    .cos_pitch = M.cos pitch;
    .lens = lens;
    // Pixels across one world unit, which is what the perspective divide works
    // out to at the camera's own distance — so switching lenses holds the scene
    // at roughly the size it already was, and pulling back still zooms out.
    .zoom = Float.div FOCAL distance;
  }
end;

// --- systems ----------------------------------------------------------------

sig advance = Store Transform -> Store Transform;
let advance = ts => fold (
  upto (0, count ts),
  ts,
  ((state, id) => case at (ts, id) of
    #Some t => @array.set state id (Some {
      .position = t.position;
      .angle = @int.rem (t.angle + t.spin) M.turn;
      .spin = t.spin;
      .scale = t.scale;
    }),
    #None => state
  end)
);

// How lit a face is: its world normal against the light, clamped, widened to
// the 0..255 the host multiplies the colour by.
const shade_of = normal => do
  let dot = Float.add
    (Float.add (Float.mul normal.x LIGHT.x) (Float.mul normal.y LIGHT.y))
    (Float.mul normal.z LIGHT.z);
  let lit = if is_less (Float.cmp dot 0.0) then 0.0 else dot end;
  in 60 + Float.truncate (Float.mul lit 195.0)
end;

// One face of one box: place its corners, project them, and hand the host two
// triangles. A face pointing away, or crossing the near plane, is dropped
// before either triangle is built.
const draw_face = (transform, model, camera, face) => do
  let corner = index => do
    let local = @array.get corners index;
    let spun = turn_y ({
      .x = Float.mul local.x transform.scale;
      .y = Float.mul local.y transform.scale;
      .z = Float.mul local.z transform.scale;
    }, transform.angle);
    in to_view ({
      .x = Float.add spun.x transform.position.x;
      .y = Float.add spun.y transform.position.y;
      .z = Float.add spun.z transform.position.z;
    }, camera)
  end;

  let a = corner face.a;
  let b = corner face.b;
  let c = corner face.c;
  let d = corner face.d;

  let normal = turn_y (
    { .x = face.nx; .y = face.ny; .z = face.nz; },
    transform.angle
  );

  // Backface culling: a face is visible when its normal leans towards the
  // camera. Comparing against the box's centre rather than the face's own is
  // exact enough for convex geometry and costs one vector.
  let outward = Float.add
    (Float.add
      (Float.mul normal.x (Float.sub transform.position.x camera.eye.x))
      (Float.mul normal.y (Float.sub transform.position.y camera.eye.y)))
    (Float.mul normal.z (Float.sub transform.position.z camera.eye.z));

  let near = point => is_less (Float.cmp point.z NEAR);
  let behind = near a || near b || near c || near d;
  let hidden = is_greater (Float.cmp outward 0.0);

  in if behind || hidden then ()
  else do
    // Pixels, and the last place a float exists in this function. `Canvas` is
    // a module import, so its record is the boundary a float cannot cross.
    let pixel = point => {
      .x = Float.truncate point.x;
      .y = Float.truncate point.y;
    };
    let pa = pixel (to_screen (a, camera));
    let pb = pixel (to_screen (b, camera));
    let pc = pixel (to_screen (c, camera));
    let pd = pixel (to_screen (d, camera));
    // Millimetres of depth, so the host's sort keeps its resolution across an
    // integer boundary.
    let depth = Float.truncate (Float.mul
      (Float.div (Float.add (Float.add a.z b.z) (Float.add c.z d.z)) 4.0)
      1000.0);
    let shade = shade_of normal;
    let _ = Canvas.tri {
      .ax = pa.x; .ay = pa.y;
      .bx = pb.x; .by = pb.y;
      .cx = pc.x; .cy = pc.y;
      .depth = depth; .shade = shade; .colour = model.colour;
    };
    in Canvas.tri {
      .ax = pa.x; .ay = pa.y;
      .bx = pc.x; .by = pc.y;
      .cx = pd.x; .cy = pd.y;
      .depth = depth; .shade = shade; .colour = model.colour;
    }
  end
  end
end;

// A 2D texture placed in the 3D world. Its size divides by depth under a
// perspective lens and does not under an orthographic one — the same one-line
// difference `to_screen` makes.
const draw_sprite = (transform, model, camera) => do
  let view = to_view (transform.position, camera);
  in if is_less (Float.cmp view.z NEAR) then ()
  else do
    let point = to_screen (view, camera);
    let size = if camera.lens == 0
      then Float.div (Float.mul transform.scale FOCAL) view.z
      else Float.mul transform.scale camera.zoom
      end;
    in Canvas.sprite {
      .x = Float.truncate point.x;
      .y = Float.truncate point.y;
      .size = Float.truncate size;
      .depth = Float.truncate (Float.mul view.z 1000.0);
      .texture = model.colour;
    }
  end
  end
end;

// `render` is the one binding here with no `sig`: an effectful arrow's type
// includes its row, and a row is printed but never written.
let render = (transforms, models, camera) => do
  let _ = Canvas.clear ();
  let _2 = visit_2 (transforms, models, ((transform, model) =>
    if model.kind == KIND_MESH
    then each (faces, (face => draw_face (transform, model, camera, face)))
    else draw_sprite (transform, model, camera)
    end));
  in Canvas.present ()
end;

// --- loading ----------------------------------------------------------------
//
// The scene is the host's. Reading it is a fold over `Assets.count`, so a
// reload runs the same code as the first load and there is no second path to
// keep correct.

let load_transforms = () => fold (
  upto (0, Assets.count ()),
  @array.empty,
  ((store, id) => do
    let entry = Assets.entry id;
    in attach (store, {
      .position = { .x = unit entry.x; .y = unit entry.y; .z = unit entry.z; };
      .angle = 0;
      .spin = entry.spin;
      .scale = unit entry.scale;
    })
  end)
);

let load_models = () => fold (
  upto (0, Assets.count ()),
  @array.empty,
  ((store, id) => do
    let entry = Assets.entry id;
    in attach (store, { .kind = entry.kind; .colour = entry.colour; })
  end)
);

// --- the frame loop ---------------------------------------------------------
//
// The two stores and the generation are the accumulator, so this is the world
// and the fold at once. Adding a component means adding a name.

let transforms = load_transforms ();
let models = load_models ();
let generation = Assets.generation ();
let frames = 0;

for ever do
  let remaining = Host.frame ();
  if remaining <= 0 then do
    break;
  end;

  // Hot reload. The host bumps its generation when a watched file changes, and
  // the world is rebuilt from the new scene; nothing else has to know.
  current <- Assets.generation;
  if current != generation then do
    transforms := load_transforms ();
    models := load_models ();
    generation := current;
  end;

  let camera = camera_of (
    View.yaw (),
    View.pitch (),
    unit (View.distance ()),
    View.lens ()
  );

  transforms := advance transforms;
  let _ = render (transforms, models, camera);

  frames := frames + 1;
end;

return frames;
