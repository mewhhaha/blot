// A small 3D engine, in a language with no assignment.
//
// This file is the game: the components it chose, the systems over them, the
// scene it loads, and the frame loop. The engine underneath it is three
// modules — `lib/ecs.blot` owns entities and needs no authority at all,
// `lib/render.blot` owns pixels and declares the authority it needs for them,
// and `lib/math.blot` owns the trigonometry the renderer indexes by step.
//
// None of them knows what a component means. The renderer rotates about one
// axis and takes the angle from its caller, so the boxes spin because this
// file gives them a `spin` and steps it, not because anything below knows the
// word.
//
// The world is a set of parallel arrays keyed by entity, and each system is a
// function over the arrays it reads — the layout an ECS arrives at. What the
// language adds is that the world does not have to be a value: a `for` body's
// `:=` names are its accumulator, so the frame loop at the bottom *is* the
// world. A system that does not rebind a name cannot affect it, which is the
// property an ECS normally arranges with scheduling and declared access.
//
// The two capabilities this file declares are the ones the game owns: the scene
// it reads and the clock it runs on. `Canvas` and `View` belong to the renderer
// and are declared there, because an effect's identity is its declaration site
// and a library that draws must own what it draws through. Importing that
// library is therefore how this program acquires the authority to draw, and the
// row on the frame loop says so.
//
// The scene comes from the host and is rebuilt whenever the host says its
// generation changed, so editing `assets/scene.json` restocks the world without
// recompiling. The camera comes from the host too — which is what lets a code
// reload keep your viewpoint, since the viewpoint was never in here.

// `!=` is not in the default fixity table, and a default fixity names a binding
// by string — so declaring it here is the ordinary way to get one, not a
// workaround. It resolves to whatever `Eq.ne` the prelude opened below.
operators {
  infix 40 (!=) = Eq.ne;
};

open @import "blot:prelude" ();

const E = (@import "./lib/ecs.blot") ();
const M = (@import "./lib/math.blot") ();
const R = (@import "./lib/render.blot") ();

const Store = E.Store;

// --- the host boundary ------------------------------------------------------
//
// The scene format is this game's and the frame clock is this game's loop, so
// both stay here. Together with the renderer's two, that is four capabilities
// and nothing else: this program cannot reach the page except through them.

const Assets = @effect.host {
  .generation = Unit -> Int;
  .count = Unit -> Int;
  .entry = Int -> {
    .kind = Int;
    .x = Int; .y = Int; .z = Int;
    .scale = Int;
    .spin = Int;
    .colour = Str;
  };
};

const Host = @effect.host {
  .frame = Unit -> Int;
};

// The scene file says a box or a texture, and the renderer offers a call for
// each. Which integer means which is the scene format's business, so the
// dispatch is here rather than inside the renderer.
const KIND_MESH = 0;

// --- components -------------------------------------------------------------

// `angle` and `spin` stay integers: an angle is a step of a 256-part turn,
// which is what indexes the trig table and what the scene file counts in.
// `position` is a point, so its fourth lane is 1 and a camera row's translation
// reaches it.
const Transform = {
  .position = F32x4;
  .angle = Int;
  .spin = Int;
  .scale = F32;
};
const Model = { .kind = Int; .colour = Str; };

// --- systems ----------------------------------------------------------------

sig advance = Store Transform -> Store Transform;
let advance = fn ts => E.each_1 (ts, (fn t => {
  .position = t.position;
  .angle = @int.rem (t.angle + t.spin) M.turn;
  .spin = t.spin;
  .scale = t.scale;
}));

// The two loaders below name their rows: an effectful arrow's type includes
// what it performs, and `~ { Assets }` is how a signature says so. `render`
// still carries none, and now for a different reason — a row names effects, an
// effect is an ordinary compile-time value, and `Canvas` and `View` are the
// renderer's own and are not in this module's scope. Importing the library is
// what grants the authority; nothing hands over the name.
//
// The renderer opens the frame and hands back the two brushes it has; which
// entity gets which is the scene format's question, so it is answered here. A
// brush takes placement and a colour rather than a component, because a record
// carries its whole field set across a module boundary and the renderer has no
// business knowing that a transform of this game's also has a spin.
let render = fn (transforms, models) => do
  _ <- R.frame (fn draw => do
    _ <- E.visit_2 (transforms, models, (fn (transform, model) => do
      _ <- if model.kind == KIND_MESH
        then draw.mesh (
        transform.position, transform.angle, transform.scale, model.colour
        )
        else draw.sprite (transform.position, transform.scale, model.colour)
      end;

    end));

  end);

end;

// --- loading ----------------------------------------------------------------
//
// The scene is the host's. Reading it is a fold over `Assets.count`, so a
// reload runs the same code as the first load and there is no second path to
// keep correct. The scene contract carries coordinates as thousandths, and
// `R.point` and `R.unit` turn them into lanes. Those two return floats across a
// blot module boundary, which costs nothing: the modules are inlined into one
// artifact.

sig load_transforms = Unit -> Store Transform ~ { Assets };
let load_transforms = fn () => do
  count <- Assets.count ();
  store <- fold (
  upto (0, count),
  @array.empty,
  (fn (store, id) => do
    entry <- Assets.entry id;
    return E.attach (store, {
      .position = R.point (entry.x, entry.y, entry.z);
      .angle = 0;
      .spin = entry.spin;
      .scale = R.unit entry.scale;
    });
  end)
  );
  return store;
end;

sig load_models = Unit -> Store Model ~ { Assets };
let load_models = fn () => do
  count <- Assets.count ();
  store <- fold (
  upto (0, count),
  @array.empty,
  (fn (store, id) => do
    entry <- Assets.entry id;
    return E.attach (store, { .kind = entry.kind; .colour = entry.colour; });
  end)
  );
  return store;
end;

// --- the frame loop ---------------------------------------------------------
//
// The two stores and the generation are the accumulator, so this is the world
// and the fold at once. Adding a component means adding a name.

transforms <- load_transforms ();
models <- load_models ();
generation <- Assets.generation ();
let frames = 0;

for ever do
  remaining <- Host.frame ();
  if remaining <= 0 then
    break;
  end;

  // Hot reload. The host bumps its generation when a watched file changes, and
  // the world is rebuilt from the new scene; nothing else has to know.
  current <- Assets.generation ();
  if current != generation then
    transforms <- load_transforms ();
    models <- load_models ();
    generation := current;
  end;

  transforms := advance transforms;
  _ <- render (transforms, models);

  frames := frames + 1;
end;

return frames;
