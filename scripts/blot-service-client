#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "usage: blot-service-client <file.blot> [service-url]" >&2
  exit 2
fi

source_directory=$(dirname -- "$1")
source_name=$(basename -- "$1")
source_path=$(cd "$source_directory" && printf '%s/%s' "$(pwd -P)" "$source_name")
service_url="http://127.0.0.1:4765"
if [ "$#" -eq 2 ]; then
  service_url=$2
fi
service_url=${service_url%/}

curl --fail-with-body --silent --show-error \
  --header "x-blot-protocol: 1" \
  --data-urlencode "path=$source_path" \
  "$service_url/v1/build-file"
