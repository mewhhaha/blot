grammar Blot

// Every source token has one fixed terminal identity. The three private-use
// terminals are inserted by Blot's layout elaborator after Baba has lexed the
// original source; they can never occur in user source.

token IDENT = /[a-z_][A-Za-z0-9_]*/ ;
token TYPE_IDENT = /[A-Z][A-Za-z0-9_]*/ ;
token INTEGER = /[0-9]+/ ;
// A float needs a digit on both sides of the point. That is what keeps it
// disjoint from `INTEGER "." field_name`, which is how `pair.0` reads: the
// field there has no digit before the dot, and a float always does. The
// priority states the tie rather than leaving it to longest-match, because the
// GPU profile wants terminal identity fixed rather than resolved.
token FLOAT priority 3 = /[0-9]+\.[0-9]+/ ;
token TEXT = /"([^"\\]|\\[ntr"\\])*"/ ;
token ELSE_IF priority 3 = /else[ \t\r\n]+if/ ;
token INTRINSIC priority 3 = /@[a-z_][A-Za-z0-9_]*(\.[a-z_][A-Za-z0-9_]*)*/ ;
token ANGLE_LEFT = /</ ;
token ANGLE_RIGHT = />/ ;
token QUESTION = /\?/ ;
token LAYOUT_NEWLINE = // ;
token LAYOUT_INDENT = // ;
token LAYOUT_DEDENT = // ;

// One operator class rather than an enumerated set. Custom operators are
// therefore lexically ordinary; precedence and meaning come from the
// source declarations and are resolved semantically by fold-fixity, never by
// grammar recursion.
//
// An operator may contain `/` anywhere except as a doubled prefix, which is
// what keeps `/` available for division while `//` stays unambiguously a
// comment. Spelled out rather than as `[...]+` because the lexer requires
// disjoint terminal identities, not a longest-match tiebreak.
token OPERATOR =
  /[+\-*=|&^%!~$:\\][+\-*\/<>=|&^%!?~$:\\]*|\?[+\-*\/<>=|&^%!?~$:\\]+|<[+\-*<>=|&^%!?~$:\\][+\-*\/<>=|&^%!?~$:\\]*|>[+\-*\/>=|&^%!?~$:\\][+\-*\/<>=|&^%!?~$:\\]*|\/[+\-*<=|&^%!?~$:\\][+\-*\/<>=|&^%!?~$:\\]*|\// ;

// Exact angle brackets retain fixed terminal identities while longer operators
// such as `<=` remain OPERATOR tokens by longest match. They stay available to
// infix chains and the fixity table through this shared rule.
operator_token = OPERATOR | ANGLE_LEFT | ANGLE_RIGHT | QUESTION ;

skip WHITESPACE = /[ \t\r\n]+/ ;
skip COMMENT = /\/\/[^\r\n]*/ ;

// A module is an implicit `do` block: bounded headers followed by repeated
// line-terminated declarations. `return` supplies its value; falling through
// supplies unit.
program = (
  header:module_header?
  operators:fixity_declaration*
  declarations:declaration*
) ;

module_header = (
  "module"
  "with"
  parameter:binding_pattern
  LAYOUT_NEWLINE
) ;

// Fixities are a bounded source header. They precede executable declarations
// because the whole table must be known before flat expression chains fold.
fixity_declaration = (
  associativity:("infixl" | "infixr" | "infix" | "prefix")
  precedence:INTEGER
  "("
  operator:operator_token
  ")"
  "="
  target:qualified_name
  ";"?
  LAYOUT_NEWLINE
) ;

// `type`, `interface`, `effect`, `duck`, and every other binder in the
// reference language collapse into `const`, because types are ordinary
// compile-time values.
declaration =
  signature | binding | rebinding | sequencing
  | opening | iteration | breaking
  | conditional_statement | result ;

// `statement` is `declaration` under a second name. The duplication is
// mechanical and keeps declaration and nested statement regions distinct in
// the compact CST.
statement =
  signature | binding | rebinding | sequencing
  | opening | iteration | breaking
  | conditional_statement | result ;

signature = (
  kind:("let" | "const")
  recursive:"rec"?
  name:(IDENT | TYPE_IDENT)
  "::"
  value:(value | indented_value)
  LAYOUT_NEWLINE
) ;

binding = (
  tags:declaration_tag*
  kind:("let" | "const")
  recursive:"rec"?
  pattern:binding_pattern
  "="
  value:(value | indented_value)
  LAYOUT_NEWLINE
) ;

indented_value = (
  LAYOUT_NEWLINE
  LAYOUT_INDENT
  value:(lambda | continued_expression)
  LAYOUT_NEWLINE
  LAYOUT_DEDENT
) ;

// A declaration tag is a compile-time descriptor whose transformer wraps the
// binding value during CST lowering. `@[` is disjoint from INTRINSIC: an
// intrinsic always continues with a lower-case name, while a tag continues
// with `[`. That keeps terminal identity fixed for the GPU profile.
declaration_tag = (
  "@"
  "["
  descriptor:value
  "]"
  line:LAYOUT_NEWLINE?
) ;

// A stable rebinding shadows one existing name with a value of the same stable
// type. A new `let` or `const` is how a name is shadowed with another type.
rebinding = (
  pattern:binding_pattern
  ":="
  value:value
  LAYOUT_NEWLINE
) ;

// Effect sequencing is a declaration rather than a prefix operator: it orders
// one computation in the surrounding scope and either binds or discards its
// produced result. `use` decides the statement form, and the head remains a
// value until a following `<-` reclassifies it as a pattern during lowering.
// That is the same delayed decision used by `for pattern in source`. An
// already-applied effectful expression remains valid; a nullary effect value is
// forced with `()` by this declaration.
sequencing = (
  "use"
  head:value
  ("<-" value:value)?
  LAYOUT_NEWLINE
) ;

// Looping. A declaration rather than an expression, because what a loop
// produces is an effect on the enclosing scope: the names its body rebinds
// with `:=` are the accumulator, and the last iteration's are what escape.
// That is a fold with the state inferred, which is why blot can have `for`
// without having assignment.
//
//   for source:              runs the body once per element
//   for x in source:         binds each element
//   for case #Some x in source: binds, and explicitly skips non-matches
//
// `break` stops the nearest `for` with its accumulator as it exists at that
// point. An unbounded loop is an ordinary iteration over an infinite iterator:
// `for ever:` followed by an indented body.
iteration = (
  "for"
  kind:"case"?
  head:value
  drawn:iteration_source?
  ":"
  body:statement_suite
  LAYOUT_NEWLINE
) ;

// `head` is parsed as a value and reclassified into a pattern when `in`
// follows. Making the binder a separate alternative would need the parser to
// decide between a pattern and an expression from the first token, which they
// share; deciding after `in` costs nothing and keeps the FIRST sets disjoint.
// A lambda escapes this because `fn` announces it, but `for` has no second
// keyword to spend and needs none.
//
// A keyword rather than an arrow, so `<-` stays in the operator class and is
// free for perform-binding an effect.
iteration_source = ( "in" source:value ) ;

breaking = (
  "break"
  LAYOUT_NEWLINE
) ;

// Spreading a module's exports into scope. Selective binding and renaming use
// an ordinary record pattern instead. The prelude is an ordinary module with
// no privilege, so this is how `+` finds `Int.add` — a source fixity whose
// target is not in scope is useless, and `open` is what puts it there.
opening = (
  "open"
  value:value
  LAYOUT_NEWLINE
) ;

// `return` supplies the result of the nearest explicit `do` scope or module.
// Reaching the end of either scope supplies unit.
result = (
  "return"
  value:(value | indented_value)
  LAYOUT_NEWLINE
) ;

// Patterns. The qualifier carries `!` (linear, consumed exactly once), `&` (bounded borrow), and `^` (pin an existing scalar), and absorbs `-` so that
// negative literal patterns need no separate rule. It is OPERATOR rather than a
// set of literals because spelling those as literals would shadow them out of
// the shared operator token class.
binding_pattern = (
  qualifier:operator_token?
  value:pattern_core
) ;

// TYPE_IDENT binds like any other name: types are values, so `const I32 = ...`
// is an ordinary binding and the capitalization is convention, not syntax.
// Constructors always carry `#`, so a bare TYPE_IDENT is never a match.
// `_` is deliberately absent as a literal: it also matches IDENT, so a parser
// would have to choose between the two by context, and requirement 2 of the GPU
// profile forbids contextual terminal identity. `_` is an ordinary name that
// lowering treats as a wildcard, which costs nothing — a binding nobody reads
// is exactly what a wildcard is.
pattern_core = (
  IDENT
  | TYPE_IDENT
  | INTEGER
  | FLOAT
  | TEXT
  | unit_pattern
  | tuple_pattern
  | array_pattern
  | constructor_pattern
  | shape_pattern
) ;

unit_pattern = ("(" ")") ;

tuple_pattern = (
  "("
  first:binding_pattern
  ","
  rest:(binding_pattern % ",")
  ")"
) ;

array_pattern = (
  "["
  elements:(binding_pattern % ",")?
  "]"
) ;

constructor_pattern = (
  "#"
  constructor:TYPE_IDENT
  payload:binding_pattern?
) ;

// Shape patterns terminate members with `;`, matching shape construction.
shape_pattern = (
  "{"
  fields:shape_pattern_field*
  "}"
) ;

shape_pattern_field = (
  "."
  name:field_name
  value:("=" binding_pattern)?
  ";"
) ;

// Expressions are flat operand/operator chains. Precedence is a semantic
// recipe, so the contracted grammar has no residual recursion here.
expression = (
  first:operand
  rest:infix_operation*
) ;

// A value continued after `=` cannot begin with a statement conditional. Its
// layout would be indistinguishable from the binding continuation itself. An
// explicit statement value begins with the disjoint `do` token.
continued_expression = (
  first:continued_operand
  rest:infix_operation*
) ;

continued_operand = (
  prefixes:prefix_operator*
  value:continued_postfix_expression
) ;

continued_postfix_expression = (
  value:continued_primary_expression
  suffixes:field_suffix*
  arguments:application_argument*
) ;

continued_primary_expression = (
  IDENT
  | TYPE_IDENT
  | INTEGER
  | FLOAT
  | TEXT
  | INTRINSIC
  | import_expression
  | constructor_expression
  | unit
  | case_expression
  | do_block
  | array
  | shape
  | effect_row
  | parenthesized_or_tuple
) ;

infix_operation = (
  operator:operator_token
  right:(operand | bounded_lambda)
) ;

// A block-bodied lambda has a structural end at its layout dedent, so it can
// be an unparenthesized operator operand without putting the unbounded
// `expression -> lambda -> expression` cycle back into the island plan. It is
// not specific to `$`: fixity lowering treats it like every other right
// operand, and typing decides whether the operator accepts a function.
bounded_lambda = (
  parameters:lambda_parameter+
  body:do_block
) ;

operand = (
  prefixes:prefix_operator*
  value:postfix_expression
) ;

// `...` is deliberately absent: spreading is only meaningful in array and
// shape positions, and having it in both places made the two readings of
// `[...x]` ambiguous.
prefix_operator = (OPERATOR | QUESTION) ;

// Unary application by juxtaposition: `f x y` is `(f x) y`. The semantic AST
// uses that same unary shape, so lowering needs no currying pass.
postfix_expression = (
  value:primary_expression
  suffixes:field_suffix*
  arguments:application_argument*
) ;

application_argument = (
  value:application_primary
  suffixes:field_suffix*
) ;

field_suffix = ("." field:field_name) ;

// Field names accept every keyword and TYPE_IDENT. blot has few keywords, but
// `.const`, `.type`, `.of`, and `.end` are all natural member names, and types
// are values so `.I32` and `.Int` are ordinary members too. Enumerating the
// keyword set here is static — it needs no contextual token, which the GPU
// profile forbids outright.
field_name = (IDENT | TYPE_IDENT | INTEGER | keyword) ;

keyword = (
  "module" | "with" | "import"
  | "infixl" | "infixr" | "infix" | "prefix"
  | "let" | "const" | "return" | "use"
  | "if" | "else" | "case" | "of" | "rec" | "open"
  | "for" | "in" | "break" | "do" | "fn"
) ;

primary_expression = (
  IDENT
  | TYPE_IDENT
  | INTEGER
  | FLOAT
  | TEXT
  | INTRINSIC
  | import_expression
  | constructor_expression
  | unit
  | case_expression
  | do_block
  | array
  | shape
  | effect_row
  | parenthesized_or_tuple
) ;

// Importing never exposes the compiler's internal module closure. Omitting an
// input instantiates with unit; `with` supplies the one explicit input value.
// The literal edge remains visible to graph discovery after surface lowering.
import_expression = (
  "import"
  specifier:TEXT
  input:("with" value)?
) ;

// The set of effects a function may perform, written the way the printer
// prints it: `A -> B ~ { Console }`. A row's members carry no leading `.`
// where a shape's members always do, so one token after `{` tells the two
// brace forms apart and neither needs a keyword to announce it. A row is
// never empty — a function that performs nothing is written without `~` —
// which is what leaves `{}` unambiguously the empty shape.
//
// A `..e` member names the rest of the row in a signature. The flat member list
// keeps the comma decision local: after each comma, `..` and an expression have
// disjoint starts. Lowering requires the tail to be last and gives every tail
// name signature-local scope.
effect_row = (
  "{"
  first:(expression | effect_row_tail)
  rest:effect_row_part*
  "}"
) ;

effect_row_part = (
  ","
  value:(expression | effect_row_tail)
) ;

effect_row_tail = (
  ".."
  name:IDENT
) ;

application_primary = (
  IDENT
  | TYPE_IDENT
  | INTEGER
  | FLOAT
  | TEXT
  | INTRINSIC
  | constructor_expression
  | unit
  | array
  | shape
  | parenthesized_or_tuple
) ;

constructor_expression = (
  "#"
  constructor:TYPE_IDENT
) ;

unit = ("(" ")") ;

parenthesized_or_tuple = (
  "("
  first:value
  tail:("," rest:(value % ","))?
  ")"
) ;

array = (
  "["
  elements:(array_element % ",")?
  "]"
) ;

array_element = (
  spread:"..."?
  value:value
) ;

// A lambda is admissible wherever a value is. Its first token is `fn`, which
// does not begin an expression, so this remains a decision the parser makes
// without lookahead.
value = lambda | expression ;

// One structural aggregate. Tuples are shapes with integer labels; the
// reference language's stored-tuple versus transient-pack distinction is gone.
shape = (
  "{"
  members:shape_member*
  "}"
) ;

shape_member = shape_spread | computed_shape_field | shape_field ;

shape_spread = (
  "..."
  value:expression
  ";"
) ;

shape_field = (
  "."
  name:field_name
  optional:QUESTION?
  "="
  value:value
  ";"
) ;

computed_shape_field = (
  "."
  "["
  name:expression
  "]"
  optional:QUESTION?
  "="
  value:value
  ";"
) ;

// `fn` is the only lambda form, and it is what makes a lambda lexically
// identifiable from its first token. Checked cost assertions are declaration
// tags, not a second lambda syntax.
//
// A curried chain is a repetition rather than a lambda whose body is another
// lambda. Both accept exactly the same source — `fn f => fn x => f (f x)` — but
// an island with no closing terminal cannot contain itself as a placeholder, so
// the recursive spelling is residual recursion and the flat one is a bounded
// transducer. Lowering folds the parameters to the right, which is the same
// division of labour `expression` has with `fold-fixity`: the grammar stays
// flat and the tree is built semantically.
lambda = (
  parameters:lambda_parameter+
  body:expression
) ;

lambda_parameter = (
  "fn"
  pattern:binding_pattern
  "=>"
) ;


// A standalone conditional is control flow in the surrounding body rather
// than a value. Its branches contain statements, so `return` and `break` may
// target the surrounding function or loop. `else` is optional because the
// normal result is always `()`.
//
// Every branch is a layout suite. The statement context is what lets a return
// or break target the surrounding function or loop rather than the branch.
conditional_statement = (
  "if"
  body:(conditional_statement_guard | conditional_statement_branches)
  LAYOUT_NEWLINE
) ;

// A deconstructing guard has no success block: matching binds the pattern for
// the statements that follow it, while the `else` body must transfer control.
//
//   if let #Some value = option else:
//     return fallback
//   // value is in scope here
conditional_statement_guard = (
  "let"
  pattern:binding_pattern
  "="
  value:value
  "else"
  ":"
  alternative:statement_suite
) ;

conditional_statement_branches = (
  condition:expression
  ":"
  consequence:statement_suite
  alternatives:conditional_statement_else_if_clause*
  fallback:conditional_statement_else_clause?
) ;

conditional_statement_else_if_clause = (
  LAYOUT_NEWLINE?
  ELSE_IF
  condition:expression
  ":"
  consequence:statement_suite
) ;

conditional_statement_else_clause = (
  LAYOUT_NEWLINE?
  "else"
  ":"
  alternative:statement_suite
) ;

case_expression = (
  "case"
  targets:(expression % ",")
  "of"
  LAYOUT_NEWLINE
  LAYOUT_INDENT
  first:case_arm
  rest:case_arm*
  LAYOUT_DEDENT
) ;

// An arm may refine its pattern with a guard: the arm is taken when the
// pattern matches *and* the guard holds, and a failed guard falls through to
// the arms below. The guard is spelled with `if`, which costs no lexer state
// because the keyword already exists, and no ambiguity because a pattern never
// ends where one could continue it — the only keyword a pattern admits is a
// shape field's name, which is preceded by `.` and terminated by `;`.
case_arm = (
  patterns:(binding_pattern % ",")
  guard:case_guard?
  "=>"
  body:value
  LAYOUT_NEWLINE
) ;

case_guard = ( "if" condition:expression ) ;



// `do:` is the explicit statement scope available as a value. Parentheses are
// only grouping/tuple syntax and never announce a statement suite.
do_block = (
  "do"
  ":"
  LAYOUT_NEWLINE
  LAYOUT_INDENT
  statements:statement*
  LAYOUT_DEDENT
) ;

statement_suite = (
  LAYOUT_NEWLINE
  LAYOUT_INDENT
  statements:statement*
  LAYOUT_DEDENT
) ;

qualified_name = (
  root:(IDENT | TYPE_IDENT | INTRINSIC)
  rest:qualified_name_part*
) ;

qualified_name_part = ("." name:field_name) ;
