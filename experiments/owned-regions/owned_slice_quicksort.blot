open import "blot:prelude"

const Source = @effect.host { .value = Int -> Int; }

sig keep_swap = (Slice.of Int, Int, Int) -> Slice.of Int
let keep_swap = fn (!region, left, right) =>
  return case Slice.swap ((!region), left, right) of
    #Updated !updated => updated
    #SwapOutOfBounds !original => original

sig sort_work = (Slice.of Int, [(Int, Int)], Int) -> Slice.of Int
let rec sort_work =
  fn (!region, work, cursor) =>
    let count = Array.length work
    if count <= cursor:
      return region
    else:
      let (low, high) = case Array.get (work, cursor) of
        #Some entry => entry
        #None => @panic "work index escaped its queue"
      if high - low < 2:
        return sort_work (!region, work, cursor + 1)
      else:
        let last = high - 1
        let pivot = case Slice.get ((&region), last) of
          #Some value => value
          #None => @panic "pivot index escaped its Region"
        let (!partitioned, boundary) = case Slice.partition_range (
          (!region),
          low,
          last,
          fn value => value <= pivot
        ) of
          #Partitioned (!updated, middle) => (updated, middle)
          #PartitionOutOfBounds (!original, fallback) => (original, fallback)
        let updated = keep_swap ((!partitioned), boundary, last)
        let pending =
          @array.push (@array.push work (low, boundary)) (boundary + 1, high)
        return sort_work (!updated, pending, cursor + 1)

dynamic <- Source.value 0
let region = Slice.claim [dynamic, 4, 7, 3, 8, 2, 6, 1, 5]
let length = Slice.length (&region)
let sorted_region = sort_work (!region, [(0, length)], 0)
let sorted = Slice.freeze (!sorted_region)

let first = case Array.get (sorted, 0) of
  #Some value => value
  #None => 0
let middle = case Array.get (sorted, 4) of
  #Some value => value
  #None => 0
let last = case Array.get (sorted, 8) of
  #Some value => value
  #None => 0
return first * 100 + middle * 10 + last
