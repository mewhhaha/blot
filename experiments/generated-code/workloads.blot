open import "blot:prelude"

const scalar_mix = fn input => do:
  let state = (input * 48271 + 1) % 2147483647
  state := (state * 48271 + 2) % 2147483647
  state := (state * 48271 + 3) % 2147483647
  state := (state * 48271 + 4) % 2147483647
  state := (state * 48271 + 5) % 2147483647
  state := (state * 48271 + 6) % 2147483647
  state := (state * 48271 + 7) % 2147483647
  state := (state * 48271 + 8) % 2147483647
  state := (state * 48271 + 9) % 2147483647
  state := (state * 48271 + 10) % 2147483647
  state := (state * 48271 + 11) % 2147483647
  state := (state * 48271 + 12) % 2147483647
  state := (state * 48271 + 13) % 2147483647
  state := (state * 48271 + 14) % 2147483647
  state := (state * 48271 + 15) % 2147483647
  state := (state * 48271 + 16) % 2147483647
  return state

const branch_mix = fn input => do:
  if input % 2 == 0:
    return (input * 3 + 1) % 2147483647
  else:
    if input % 3 == 0:
      return (input * 5 + 2) % 2147483647
    else:
      if input % 5 == 0:
        return (input * 7 + 3) % 2147483647
      else:
        if input % 7 == 0:
          return (input * 11 + 4) % 2147483647
        else:
          if input % 11 == 0:
            return (input * 13 + 5) % 2147483647
          else:
            if input % 13 == 0:
              return (input * 17 + 6) % 2147483647
            else:
              return (input * 19 + 7) % 2147483647

const call_step = fn value => (value * 48271 + 1) % 2147483647

const function_chain = fn input => do:
  let state = call_step input
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  state := call_step state
  return state

const array_pipeline = fn input => do:
  let values =
    [
      (input + 1),
      (input + 2),
      (input + 3),
      (input + 4),
      (input + 5),
      (input + 6),
      (input + 7),
      (input + 8)
    ]
  let [a, b, c, d, e, f, g, h] = values
  return a + b + c + d + e + f + g + h

return {
  .scalar_mix = scalar_mix;
  .branch_mix = branch_mix;
  .function_chain = function_chain;
  .fixed_array = array_pipeline;
}
