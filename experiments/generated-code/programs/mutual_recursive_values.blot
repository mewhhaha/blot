open import "../../../src/prelude/prelude.blot"

let rec build_even = fn count => do:
  if count == 0:
    return #Done
  else:
    return #Even (count, build_odd (count - 1))
let rec build_odd = fn count => do:
  if count == 0:
    return #Done
  else:
    return #Odd (count, build_even (count - 1))

let rec total_even = fn values => case values of
  #Done => 0
  #Even node => node.0 + total_odd node.1
let rec total_odd = fn values => case values of
  #Done => 0
  #Odd node => node.0 + total_even node.1

sig mutual_recursive_values = Int -> Int
let mutual_recursive_values = fn count => total_even (build_even count)

return { .mutual_recursive_values = mutual_recursive_values; }
