open import "blot:prelude"

const table = [F32.of_int 10, F32.of_int 20, F32.of_int 30]

sig classify = Int -> Int
const classify = fn index => do:
  let value = case Array.get (table, index) of
    #Some found => found
    #None => F32.of_int 0

  if index == 0:
    return F32.truncate value
  else if index == 1:
    return F32.truncate (F32.add value (F32.of_int 1))
  else:
    return F32.truncate (F32.negate value)

return { .classify = classify; }
