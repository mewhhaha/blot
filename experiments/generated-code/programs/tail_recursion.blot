open import "blot:prelude"

const rec sum_go :: (Int, Int) -> Int
const rec sum_go = fn (remaining, total) => do:
  if remaining <= 0:
    return total

  return sum_go (remaining - 1, total + remaining)

const sum_to :: Int -> Int
const sum_to = fn count => sum_go (count, 0)

return { .sum_to = sum_to; }
