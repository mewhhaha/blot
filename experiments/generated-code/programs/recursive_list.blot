open import "../../../src/prelude/prelude.blot"

let rec build = fn n => do:
  if n == 0:
    return #Nil
  else:
    return #Cons (n, build (n - 1))

let rec total = fn list => case list of
  #Nil => 0
  #Cons node => node.0 + total node.1

let recursive_list :: Int -> Int
let recursive_list = fn count => total (build count)

return { .recursive_list = recursive_list; }
