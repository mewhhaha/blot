open import "blot:prelude"

const rec fold_go :: (Int, Int) -> Int
const rec fold_go = fn (remaining, total) => do:
  if remaining <= 0:
    return total

  return fold_go (remaining - 1, total + remaining)

const fold :: Int -> Int
const fold = fn count => fold_go (count, 0)

return { .fold = fold; }
