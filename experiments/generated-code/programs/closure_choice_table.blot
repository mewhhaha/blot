open @import "../../../src/prelude/prelude.blot" ()

// A nested dynamic choice over three lambdas with mutually different capture
// products. The first captures two runtime values, the second one, and the
// third one that only exists inside its own branch. Both applications go
// through the same joined table.
sig select = (Int, Int) -> Int
let select = fn (flag, value) =>
  let bias = value * 2
  let selected = case flag > 10 of
    #True => do:
      let inner = case flag > 100 of
        #True => fn n => n + flag + bias
        #False => fn n => n + flag
      return inner
    #False => do:
      let offset = value - flag
      return fn n => n - offset
  let first = selected value
  let second = selected 7
  return first + second

return { .select = select; }
