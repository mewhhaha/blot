open import "../../../src/prelude/prelude.blot"

sig run = (Int, Int) -> Int
let run = fn (flag, value) => do:
  let selected = case flag > 0 of
    #True => fn record => record.x + flag
    #False => fn record => record.x - flag
  let left = selected { .x = value; .left = 0; }
  let right = selected { .x = value; .right = 0; }
  return left + right

return { .run = run; }
