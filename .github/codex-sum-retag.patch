+    #[allow(clippy::too_many_arguments)]
+    fn coerce_runtime_sum_case(
+        &mut self,
+        value: &RuntimeValue,
+        source_cases: &[RuntimeCase],
+        source_case_index: usize,
+        expected_type: usize,
+        expected_sum: usize,
+        expected_cases: &[RuntimeCase],
+        span: crate::ast::Span,
+    ) -> Result<RuntimeValue, Diagnostic> {
+        let source_case = source_cases
+            .get(source_case_index)
+            .ok_or_else(|| hir_error("A residual sum case is outside its runtime type."))?;
+        let expected_case = expected_cases
+            .iter()
+            .position(|case_| case_.name == source_case.name)
+            .ok_or_else(|| {
+                hir_error(&format!(
+                    "Constructor `#{}` is absent from its joined runtime type.",
+                    source_case.name
+                ))
+            })?;
+        let payload = self.sum_payload(value, source_case_index, span)?;
+        let payload = self.lower_value_as(
+            &payload,
+            expected_cases[expected_case].payload_type,
+            span,
+        )?;
+        let mut widened = self.operation_with_case(
+            "sum.make",
+            expected_sum,
+            vec![payload.id],
+            span,
+            expected_case,
+        );
+        if expected_sum != expected_type {
+            widened = self.operation(
+                "indirect.make",
+                expected_type,
+                vec![widened.id],
+                span,
+                None,
+            );
+        }
+        widened.meaning = RuntimeMeaning::Sum {
+            cases: expected_cases
+                .iter()
+                .map(|case_| case_.name.clone())
+                .collect(),
+        };
+        Ok(widened)
+    }
