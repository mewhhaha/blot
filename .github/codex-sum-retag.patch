+    fn coerce_runtime_sum(
+        &mut self,
+        value: &RuntimeValue,
+        source_cases: &[RuntimeCase],
+        expected_type: usize,
+        span: crate::ast::Span,
+    ) -> Result<RuntimeValue, Diagnostic> {
+        let (expected_sum, expected_cases) = self
+            .sum_representation(expected_type)
+            .map(|(type_id, cases)| (type_id, cases.to_vec()))
+            .ok_or_else(|| {
+                hir_error("A checked sum representation was joined with a non-sum type.")
+            })?;
+        if source_cases.len() == 1 {
+            return self.coerce_runtime_sum_case(
+                value,
+                source_cases,
+                0,
+                expected_type,
+                expected_sum,
+                &expected_cases,
+                span,
+            );
+        }
+
+        let tag = self.sum_tag(value, span)?;
+        let explicit_cases = source_cases
+            .len()
+            .checked_sub(1)
+            .expect("a residual sum has at least one case");
+        let values = (0..explicit_cases)
+            .map(|case| {
+                i32::try_from(case)
+                    .map(WireConstant::SignedInteger32)
+                    .map_err(|_| hir_error("A residual sum has too many constructors."))
+            })
+            .collect::<Result<Vec<_>, Diagnostic>>()?;
+        let switch = self.begin_switch(&tag, values, span)?;
+        let mut branch_blocks = switch.arms.clone();
+        branch_blocks.push(switch.fallback);
+        let mut branches = Vec::with_capacity(source_cases.len());
+        for (source_case, block) in branch_blocks.into_iter().enumerate() {
+            self.current_block = block;
+            let result = self.coerce_runtime_sum_case(
+                value,
+                source_cases,
+                source_case,
+                expected_type,
+                expected_sum,
+                &expected_cases,
+                span,
+            )?;
+            branches.push((self.current_block, result));
+        }
+        for (end, result) in &branches {
+            self.blocks[*end].terminator = Some(RuntimeTerminator::Branch {
+                target: switch.join,
+                arguments: vec![result.id],
+                span: self.span(span),
+            });
+        }
+        let joined = self.next_value();
+        let ownership = self.ownership(expected_type);
+        let runtime_span = self.span(span);
+        self.blocks[switch.join]
+            .parameters
+            .push(RuntimeBlockParameter {
+                value: joined,
+                type_id: expected_type,
+                ownership,
+                span: runtime_span,
+            });
+        self.current_block = switch.join;
+        Ok(RuntimeValue {
+            id: joined,
+            type_id: expected_type,
+            meaning: RuntimeMeaning::Sum {
+                cases: expected_cases
+                    .iter()
+                    .map(|case_| case_.name.clone())
+                    .collect(),
+            },
+        })
+    }
