+    #[test]
+    fn reordered_residual_sums_are_retagged_by_constructor_name() {
+        let mut trace = ResidualTrace::new("sum-retag-test.blot");
+        let span = crate::ast::Span { start: 0, end: 0 };
+        let payload_type =
+            trace.insert_type("signed-integer-64", RuntimeType::SignedInteger64);
+        let source_type = trace.sum_type(
+            &["Some".to_owned(), "None".to_owned()],
+            &[payload_type, 0],
+        );
+        let expected_type = trace.sum_type(
+            &["None".to_owned(), "Some".to_owned()],
+            &[0, payload_type],
+        );
+        let source = trace.next_value();
+        let ownership = trace.ownership(source_type);
+        let runtime_span = trace.span(span);
+        trace.blocks[0].parameters.push(RuntimeBlockParameter {
+            value: source,
+            type_id: source_type,
+            ownership,
+            span: runtime_span,
+        });
+        let value = RuntimeValue {
+            id: source,
+            type_id: source_type,
+            meaning: RuntimeMeaning::Sum {
+                cases: vec!["Some".to_owned(), "None".to_owned()],
+            },
+        };
+
+        let coerced = trace
+            .coerce_runtime_value(&value, expected_type, span)
+            .expect("equivalent residual sums should be retagged");
+
+        assert_eq!(coerced.type_id, expected_type);
+        let emitted_cases = trace
+            .blocks
+            .iter()
+            .flat_map(|block| &block.operations)
+            .filter(|operation| operation.kind == "sum.make")
+            .map(|operation| operation.case)
+            .collect::<Vec<_>>();
+        assert_eq!(emitted_cases, vec![Some(1), Some(0)]);
+    }
