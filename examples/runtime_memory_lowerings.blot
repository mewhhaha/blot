// Runtime collection paths share the same generic implementations used at
// compile time. This fixture keeps their element representations residual so
// the lowering audit observes the actual loops and Store updates.

open import "blot:prelude"

let collect_range :: Int -> [Int]
let collect_range = fn count => Iter.collect (Iter.range (0, count))

let map_range :: Int -> [Int]
let map_range = fn count => do:
  let values = @linear.freeze (Iter.collect (Iter.range (0, count)))
  let transform = fn value => value * 2
  return map ((&values), ?transform)

let filter_range :: Int -> [Int]
let filter_range = fn count => do:
  let values = @linear.freeze (Iter.collect (Iter.range (0, count)))
  let keep = fn value => value % 2 == 0
  return filter ((&values), ?keep)

let partition_range :: Int -> ([Int], [Int])
let partition_range = fn count => do:
  let values = @linear.freeze (Iter.collect (Iter.range (0, count)))
  let belongs_left = fn value => value % 2 == 0
  return partition ((&values), ?belongs_left)

let split_text :: (Text, Text) -> [Text]
let split_text = fn (text, separator) => Text.split (text, separator)

let replace_text :: (Text, Text, Text) -> Text
let replace_text =
  fn (text, query, replacement) => Text.replace (text, query, replacement)

let build_map :: Int -> Map.of (Int, Int)
let build_map = fn count => do:
  let entries :: Map.of (Int, Int)
  let entries = [(0, 0)]
  for value in Iter.range (1, count):
    entries := (Map.put (Int.eq, entries, value, value * 2)).1

  return entries

// Keep the success constructor first so this fixture also verifies that
// residual sum layout is independent of source branch order.
let take_at :: ([Int], Int) -> Option (Int, [Int])
let take_at = fn (values, index) => do:
  if index >= 0 && index < Array.length (&values):
    return Some (@array.take values index)

  return None

return {
  .collect_range = collect_range;
  .map_range = map_range;
  .filter_range = filter_range;
  .partition_range = partition_range;
  .split_text = split_text;
  .replace_text = replace_text;
  .build_map = build_map;
  .take_at = take_at;
}
