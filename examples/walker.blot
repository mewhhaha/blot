// Two functions that cannot be written apart.
//
// A recursive-descent walker is the shape mutual recursion exists for: `walk`
// reads one node and hands an operator node to `combine`, and `combine` reads
// that node's two children by calling `walk` back. Neither is a function until
// the other is, so no ordering of the two declarations puts both names in
// scope — which is what a recursive group is for.
//
// The two are one group because they are adjacent `rec` bindings of the same
// kind. Their `sig`s sit between them and separate nothing: a signature has to
// be followed by the binding it constrains, so a `sig` inside a run belongs to
// a member of that run.

open import "blot:prelude"

// One expression tree, flattened into prefix order. `0` is a sum node and `1`
// a product node; every larger token is the literal `token - 2`. So this is
// `(2 + 3) * (4 + 5)`, and the answer is 45.
let program = [1, 0, 4, 5, 0, 6, 7]

// A read past the end is a malformed tree rather than a trap. The guard is
// what proves the index, exactly as in `indexed.blot`.
sig token = [Int] -> Int -> Int
let token = fn source => fn at =>
  if at >= 0 && at < @array.len source:
    return @array.get source at

  return 0

// Each walker returns the value it read and the position after it, so the
// caller knows where its next child begins.
sig walk = [Int] -> Int -> (Int, Int)
let walk =
  rec (fn source => fn at =>
    let head = token source at
    if head < 2:
      return combine source (at + 1) head
    else:
      return (head - 2, at + 1)
  )

sig combine = [Int] -> Int -> Int -> (Int, Int)
let combine =
  rec (fn source => fn at => fn operator =>
    let (left, after_left) = walk source at
    let (right, after_right) = walk source after_left
    if operator == 0:
      return (left + right, after_right)
    else:
      return (left * right, after_right)
  )

let (value, consumed) = walk program 0

// A well-formed tree consumes the whole array; anything left over means the
// walk stopped early.
return { .value = value; .whole = consumed == @array.len program; }
