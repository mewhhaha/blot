open import "blot:prelude"

const Result = #Accepted Int | #Rejected Text
const Summary =
  {
    .accepted = [Int];
    .errors = [Text];
  }

let validate :: Int -> Result
let validate = fn value => do:
  if value <= 0:
    return #Rejected "not positive"

  if value % 2 != 0:
    return #Rejected "not even"

  return #Accepted value

let rec summarize :: ([Int], Int, [Int], [Text]) -> Summary
let rec summarize = fn (&values, index, accepted, errors) => case Array.get (
  (&values),
  index
  ) of
  #None => { .accepted = accepted; .errors = errors; }
  #Some value => case validate value of
    #Accepted accepted_value => summarize (
      (&values),
      index + 1,
      @array.push accepted accepted_value,
      !errors
    )

    #Rejected reason => summarize (
      (&values),
      index + 1,
      !accepted,
      @array.push errors reason
)

let values = [-2, 3, 4, 10]
return summarize ((&values), 0, [], [])
