// A small validation pipeline with tagged success and error values.
//
// Validation stays total: every input becomes either an accepted integer or a
// rejected reason, and a second fold summarizes those results.

open import "blot:prelude"

const Result = #Accepted Int | #Rejected Str
const Summary = {
  .accepted = [Int];
  .errors = [Str];
}

sig validate = Int -> Result
let validate = fn value =>
  if value <= 0:
    return #Rejected "not positive"
  else:
    if Num.rem value 2 == 0:
      return #Accepted value
    else:
      return #Rejected "not even"

sig summarize = (Summary, Result) -> Summary
let summarize = fn (state, result) => case result of
  #Accepted value => {
    .accepted = [...state.accepted, value];
    .errors = state.errors;
  }
  #Rejected reason => {
    .accepted = state.accepted;
    .errors = [...state.errors, reason];
  }

let results = map ([-2, 3, 4, 10], validate)
return fold (results, { .accepted = []; .errors = []; }, summarize)
