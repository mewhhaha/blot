// Handler composition is ordinary function composition. Each two-argument
// `@handle (Effect, handler)` is a computation transformer, so `|>` makes the
// written order inner-to-outer. Sequencing the final effect value executes the
// fully handled program.

open import "blot:prelude"

const Terminal = @effect { .read = Unit -> Int; }
const Clock = @effect { .now = Unit -> Int; }
const Random = @effect { .add = Int -> Int; }

let program = fn () => do:
  use input <- Terminal.read ()
  use time <- Clock.now ()
  use result <- Random.add (input + time)
  return result

let fake_terminal =
  {
    .read = fn ((), !resume) => do:
      use result <- resume 10
      return result
    ;
  }
let fake_clock =
  {
    .now = fn ((), !resume) => do:
      use result <- resume 20
      return result
    ;
  }
let fake_random =
  {
    .add = fn (value, !resume) => do:
      use result <- resume (value + 12)
      return result
    ;
  }

let handled =
  program
    |> @handle (Terminal, fake_terminal)
    |> @handle (Clock, fake_clock)
    |> @handle (Random, fake_random)

use result <- handled
use discarded <- handled

return {
  .named = result;
  .discarded = discarded;
}
