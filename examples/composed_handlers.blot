// A handler composition is static sugar over nested `@handle` calls. Each
// bound step names the program with that effect discharged; the final step
// executes the fully handled program.

open @import "blot:prelude" ();

const Terminal = @effect { .read = Unit -> Int; };
const Clock = @effect { .now = Unit -> Int; };
const Random = @effect { .add = Int -> Int; };

let program = fn () => do
  input <- Terminal.read ();
  time <- Clock.now ();
  result <- Random.add (input + time);
  break result;
end;

let fake_terminal = {
  .read = fn ((), ?resume) => do
    result <- resume 10;
    break result;
  end;
};
let fake_clock = {
  .now = fn ((), ?resume) => do
    result <- resume 20;
    break result;
  end;
};
let fake_random = {
  .add = fn (value, ?resume) => do
    result <- resume (value + 12);
    break result;
  end;
};

let result = try program with
  program_without_terminal <- @handle (Terminal, fake_terminal);
  program_without_clock <- @handle (Clock, fake_clock);
  @handle (Random, fake_random)
end;

let discarded = try program with
  _ <- @handle (Terminal, fake_terminal);
  _ <- @handle (Clock, fake_clock);
  @handle (Random, fake_random)
end;

return {
  .named = result;
  .discarded = discarded;
};
