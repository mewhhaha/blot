// Set algebra, and what "overloading an operator" means here.
//
// `|`, `&`, and `\` are not syntax. The fixity table binds each spelling to a
// field of a record named `Type`, exactly the way `+` is bound to `Num.add`:
//
//   infixl 45 (|)  = Type.union;
//   infixl 45 (&)  = Type.intersect;
//   infixl 45 (\)  = Type.diff;
//
// `Type` provides set algebra because types denote sets. The value-level `Set`
// below is an ordinary polymorphic collection factory with explicit equality.

open import "blot:prelude"

const Method = "GET" | "POST" | "PUT" | "DELETE"
const Safe = Method \ "PUT" \ "DELETE"
const Tag = (#X | #Y | #Z) & (#Y | #Z | #W)

// A field is a function, so an operator is a function. `Type.diff Method` is the
// section "everything in Method except", which is not a special form either.
const without = Type.diff Method
const readonly = without "PUT"

const IntSet = Set.with Ord.eq

const evens = [2, 4, 6]
const small = [1, 2, 3, 4]

export {
  .safe = Safe;
  .tag = Tag;
  .readonly = readonly;
  .union = IntSet.union evens small;
  .intersect = IntSet.intersect evens small;
  .diff = IntSet.diff small evens;
}
