// Operators are ordinary source declarations. This module adds one spelling
// while the prelude supplies the conventional standard header.

infixr 55 (<++>) = Text.append

open import "blot:prelude"

const Value = I32 | Text
const Method = "GET" | "POST" | "PUT"
const Verb = Method \ "PUT"

// Division and the comment marker coexist: an operator may contain `/`
// anywhere except as a doubled prefix, which is what keeps `//` a comment.
let ratio = 22 / 7
let remainder = 22 % 7
let chained = 1 + 2 * 3 - 4 / 2
let compared = 1 + 2 == 3
let distinct = remainder != 0

// Associativity and precedence come from source and are visible in LANGUAGE.md.
let joined = "a" <> "b" <> "c"
let custom_joined = "a" <++> "b" <++> "c"
let piped = 20 |> Int.add 2 |> Int.mul 2
let applied = Int.add 20 $ 22
let call = fn callback => callback 40 2
let block_applied = call $ fn left => fn right => do:
  return left + right
let bounded = Int.le 3 4
let negated = -7 + 10

// --- what the standard source levels mean -----------------------------------
//
// Precedence is grouped by what an operator does, and each of these pins a
// relationship that was wrong once. The parenthesised form is what the bare
// form must mean.

// An arrow is looser than the type algebra on either side of it, so each pair
// here prints the same value twice. `==` cannot state it: it compares scalars,
// and these are types.
const arrow_bare = Int | Text -> Int
const arrow_grouped = (Int | Text) -> Int

// Set algebra mirrors arithmetic: intersection is the product.
const algebra_bare = 0 | 1 & 1
const algebra_grouped = 0 | (1 & 1)

// `&&` and `||` are boolean logic, distinct from `&` and `|`, which are set
// algebra. Comparisons bind tighter than both, and `&&` tighter than `||`.
//
// The two logical spellings lower to conditionals and short-circuit.
let ranged = 1 < 2 && 3 < 4
let either = False && True || True
let precedence = True || False && False

// Append binds tighter than comparison and looser than arithmetic. `==` is
// `Int.eq` over `@int.cmp`, so it compares integers; `Text.cmp` compares text.
let appended = is_equal (Text.cmp ("a" <> "b") "ab")
let counted = "n" <> Text.of_int (1 + 2)

return {
  .arrow_bare = arrow_bare;
  .arrow_grouped = arrow_grouped;
  .algebra_bare = algebra_bare;
  .algebra_grouped = algebra_grouped;
  .ranged = ranged;
  .either = either;
  .precedence = precedence;
  .appended = appended;
  .counted = counted;
  .value = Value;
  .verb = Verb;
  .ratio = ratio;
  .remainder = remainder;
  .chained = chained;
  .compared = compared;
  .distinct = distinct;
  .joined = joined;
  .custom_joined = custom_joined;
  .piped = piped;
  .applied = applied;
  .block_applied = block_applied;
  .bounded = bounded;
  .negated = negated;
  }
