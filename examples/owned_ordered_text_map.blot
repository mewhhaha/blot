// Binary-search lookup and independent value replacement over sorted key
// ranges. Keys stay immutable; split and join reuse Slice witnesses.

open import "blot:prelude"

sig replace_keep =
  (OrderedTextMap.of Int, Text, Int) -> (OrderedTextMap.of Int, Int)
let replace_keep = fn (!entries, key, value) => do:
  return case OrderedTextMap.replace ((!entries), key, value) of
    #MapReplaced (previous, !updated) => (updated, previous)
    #MapMissing (returned, !original) => (original, returned)

let source =
  [("alpha", 1), ("beta", 2), ("gamma", 3), ("omega", 4)]
let entries = OrderedTextMap.copy source

let beta = case OrderedTextMap.get ((&entries), "beta") of
  #Some value => value
  #None => 0

let (entries, previous_beta) = replace_keep ((!entries), "beta", 20)
let entries = case OrderedTextMap.split_before ((!entries), "gamma") of
  #Split (!left, !right, !rejoin) => do:
    let (left, previous_alpha) = replace_keep ((!left), "alpha", 10)
    let (right, previous_gamma) = replace_keep ((!right), "gamma", 30)
    let joined = OrderedTextMap.join ((!rejoin), (!left), (!right))
    return (joined, previous_alpha + previous_gamma)
  #SplitOutOfBounds !original => (original, 0)

let (entries, replaced_edges) = entries
let frozen = OrderedTextMap.freeze (!entries)
return (beta, previous_beta, replaced_edges, frozen)
