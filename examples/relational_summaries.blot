// A verified erased summary carries Array.length through an ordinary wrapper.
open import "blot:prelude"

const count = fn values => Array.length values

sig at = [Int] -> Int -> Int
let at = fn values => fn index => case index >= 0 && index < count values of
  #True => @array.get values index
  #False => 0

export at [10, 20, 30] 1
