// The textbook Fibonacci definition expresses overlapping non-tail recursion.
// Pure closed comptime calls reuse prior results, while the exported runtime
// function retains the written recursive algorithm.

open import "blot:prelude"

let rec fibonacci :: Int -> Int
let rec fibonacci = fn n => do:
  if n < 2:
    return n

  return fibonacci (n - 1) + fibonacci (n - 2)

return {
  .zero = fibonacci 0;
  .one = fibonacci 1;
  .ten = fibonacci 10;
  .twenty = fibonacci 20;
  .fibonacci = fibonacci;
  }
