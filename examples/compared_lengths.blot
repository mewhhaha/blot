// Array lengths are nonnegative, so a strictly longer array is nonempty.

open import "blot:prelude"

let first :: [Int] -> [Int] -> Int
let first = fn xs => fn ys => do:
  let xs_length = Array.length xs
  let ys_length = Array.length ys
  if xs_length < ys_length:
    return @array.get ys 0
  else:
    return 0

return { .larger = first [] [41]; .equal = first [0] [7]; .smaller = first [
  0,
  1
] [7]; }
