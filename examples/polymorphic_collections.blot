// Polymorphic collection namespaces are ordinary structural implementations.
// Equality-dependent collections are created explicitly, so no hidden
// typeclass lookup chooses how keys or values compare.

open import "blot:prelude"

let map_lengths ::
  Mappable (List.of Text, List.of Int, Text, Int) -> List.of Text -> List.of Int
let map_lengths = fn implementation => fn values => do:
  return implementation.map (values, Text.length)

let total_lengths :: Foldable (List.of Text, Text, Int) -> List.of Text -> Int
let total_lengths = fn implementation => fn values => do:
  return implementation.fold (
    values,
    0,
    fn (total, value) => total + Text.length value
    )

let retain_long ::
  Filterable (List.of Text, Text) -> List.of Text -> List.of Text
let retain_long = fn implementation => fn values => do:
  return implementation.filter (values, fn value => Text.length value > 3)

let collect_words ::
  Iterable (List.of Text, Text, List.of Text) -> List.of Text -> [Text]
let collect_words = fn implementation => fn values => do:
  let collected = Array.empty
  for value in implementation.items values:
    collected := @array.push collected value

  return collected

let map_name_lengths ::
  Mappable (
    Map.of (Int, Text),
    Map.of (Int, Int),
    Text,
    Int
  ) -> Map.of (Int, Text) -> Map.of (Int, Int)
let map_name_lengths = fn implementation => fn names => do:
  return implementation.map (names, Text.length)

let increment_members ::
  Mappable (
    Set.of Int,
    Set.of Int,
    Int,
    Int
  ) -> Set.of Int -> Set.of Int
let increment_members = fn implementation => fn members => do:
  return implementation.map (members, fn value => value + 1)

let words = List.from_array ["one", "two", "three"]
let lengths = map_lengths List words
let long_words = retain_long List words

const IntMap = Map.with Int.eq
let names :: Map.of (Int, Text)
let names = IntMap.empty
let names = (IntMap.put (names, 2, "two")).1
let names = (IntMap.put (names, 1, "one")).1
let replaced = IntMap.put (names, 2, "deux")
let previous :: Option Text
let previous = replaced.0
let name_lengths = map_name_lengths IntMap replaced.1

const TextSet = Set.with (fn left => fn right => text_eq (left, right))
let colours :: Set.of Text
let colours = TextSet.empty
let colours = (TextSet.insert (colours, "red")).1
let colours = (TextSet.insert (colours, "green")).1
let more_colours = ["green", "tan", "blue"]
let colours = TextSet.union colours more_colours
let colour_lengths = TextSet.map_with (colours, Int.eq, Text.length)
let incremented_lengths = increment_members (Set.with Int.eq) colour_lengths

return {
  .lengths = List.to_array lengths;
  .total_length = total_lengths List words;
  .long_words = List.to_array long_words;
  .iterated = collect_words List words;
  .map_previous = previous;
  .map_keys = IntMap.keys replaced.1;
  .map_values = IntMap.values name_lengths;
  .set_values = colours;
  .set_lengths = colour_lengths;
  .incremented_lengths = incremented_lengths;
  }
