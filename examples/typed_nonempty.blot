open import "blot:prelude"
const NonEmpty = import "./lib/nonempty.blot"

const Approver = {
  .name = Text;
  .weight = Int;
}

let base_chain :: NonEmpty.of Approver
let base_chain = {
  .head = { .name = "Ada"; .weight = 3; };
  .tail = [
    { .name = "Grace"; .weight = 2; },
    { .name = "Linus"; .weight = 1; }
  ];
}

let fallback = NonEmpty.singleton { .name = "Margaret"; .weight = 5; }

let combine ::
  Semigroup (NonEmpty.of Approver) ->
  NonEmpty.of Approver -> NonEmpty.of Approver -> NonEmpty.of Approver
let combine = fn implementation => fn left => fn right => implementation.append left right

let names ::
  Mappable (
    NonEmpty.of Approver,
    NonEmpty.of Text,
    Approver,
    Text
  ) -> NonEmpty.of Approver -> NonEmpty.of Text
let names = fn implementation => fn values => implementation.map (values, fn approver => approver.name)

let total_weight ::
  Foldable (NonEmpty.of Approver, Approver, Int) ->
  NonEmpty.of Approver -> Int
let total_weight = fn implementation => fn values => implementation.fold (
  values,
  0,
  fn (total, approver) => total + approver.weight
)

let count :: Length (NonEmpty.of Approver) -> NonEmpty.of Approver -> Int
let count = fn implementation => fn values => implementation.length values

let join_names :: NonEmpty.of Text -> Text
let join_names = fn values => NonEmpty.reduce (
  values,
  fn (left, right) => left <> " > " <> right
)

let chain = combine NonEmpty base_chain fallback
let mapped = names NonEmpty chain

// Pain point: NonEmpty can implement Semigroup, Mappable, Foldable, and Length
// structurally, but correctly has no `.empty`, so it cannot satisfy Monoid.
// `nonempty_monoid.blot` locks that useful rejection down.
return {
  .default = {
    .first = chain.head.name;
    .count = count NonEmpty chain;
    .weight = total_weight NonEmpty chain;
    .route = join_names mapped;
    .names = NonEmpty.to_array mapped;
  };
}
