// Capabilities.
//
// A module is an ordered computation from an input record to an export record.
// Importing one grants it nothing. The entry module's input is the entire
// authority the program has: there is no ambient filesystem, no ambient clock,
// and no ambient print. `init.print` below is an opaque host function — the
// program can call it and do nothing else with it.

module with init

open import "blot:prelude"

const Console =
  @effect {
    .write = Str -> Unit;
  }

// A host capability is simply a handler blot did not write. Here the handler is
// written in blot over the granted function, which is the ordinary case.
const to_host =
  {
    .write = fn (message, ?resume) =>
      <- init.print message
      result <- resume ()
      return result
    ;
    .return = fn value => value;
  }

// The same computation, discharged two different ways. Nothing in `report`
// mentions which.
const report = fn () =>
  <- Console.write "compiled"
  <- Console.write "linked"
  return "ok"

const to_memory =
  {
    .write = fn (message, ?resume) =>
      rest <- resume ()
      return @text.concat message rest
    ;
    .return = fn _ => "";
  }

export {
  .printed = @handle (Console, report, to_host);
  .captured = @handle (Console, report, to_memory);
}
