// `?` is affine: at most once. Never resuming is an abort and is fine; resuming
// twice would run the rest of the computation twice, and that is not.

open {} = (@import "blot:prelude") ();

let handler = fn ?resume => do
  first <- resume 1;
  second <- resume 2;
  in @int.add first second
end;
return handler (fn n => n);
