// A float reaching the module boundary.
//
// Blot Core Wasm ABI 1 has no float layout: gpufuck's canonical ABI is unit,
// integer, boolean, text, array, record, variant, and seal, so there is no
// stable way to hand a caller an `F64`. The Component Model's own canonical
// ABI does have `float64`, so this is a gap rather than a decision — but until
// the target can publish one, a program's floats are its own arithmetic and
// not its interface.
//
// `Float.truncate` at the export is the whole of the workaround, which is what
// `examples/floats.blot` does.

open {} = (@import "blot:prelude") ();

sig ratio = F64;
let ratio = Float.div 22.0 7.0;

return ratio;
