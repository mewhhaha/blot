// The other half of tuple coverage: a column with more values than arms can
// list. `Int` is such a column, so the first arm accounts for exactly one of
// its values and every other integer has to reach an arm that is irrefutable
// there. The one arm that is names `#None` in the second column, so
// `(2, #Some 1)` matches nothing.
//
// The single-column reading of this is `unbounded_case.blot`. Writing `(_, _)`
// as the last arm accepts it.

open {} = (@import "blot:prelude") ();

sig pick = (Int, Option Int) -> Int;
let pick = fn pair => case pair of
  (1, #Some a) => a,
  (_, #None) => 0
end;
return pick (2, Some 1);
