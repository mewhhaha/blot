// A guard's pattern types what it binds. `#Some 3` carries an integer, so
// appending text to `inner` is a type error at `blot check` rather than a
// surprise at run time.

open import "blot:prelude"

const counted = #Some 3

let shout = fn () =>
  if let #Some inner = counted else:
    return "none"
  return Text.append inner "!"

return shout ()
