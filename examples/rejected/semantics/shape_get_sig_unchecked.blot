// `@shape.get` names its field with a value, so no signature can state what it
// produces. That is not a reason to answer with a type variable: every
// constraint on a variable holds, so the `sig` below would be believed rather
// than checked and the program would export the type `0` for a value that is
// `7`.
//
// The name is known here — it is written in the source — so the projection is
// typed the way `r.a` is, and `7` is outside `0`.
//
// `member_sig_unchecked.blot` is the same mistake and the same fix for a
// namespace member.

open @import "blot:prelude" ()

let r = { .a = 7; }
sig z = 0
let z = @shape.get r "a"
return z
