// The other half of the same rule. A member call is typed by running it, and
// this one cannot be run: `amount` is a parameter, so the checker has no value
// to hand `.of`. Its result remains an open type variable whose identity can be
// settled only by compile-time specialization, so it cannot prove a `sig` at
// this unspecialized boundary.

open import "blot:prelude"

const Money = #Money I32 <+ { .of = fn n => #Money n; }

const priced = fn amount => do:
  sig converted = Money
  let converted = Money.of amount
  return converted

return priced 42
