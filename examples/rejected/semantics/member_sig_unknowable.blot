// The other half of the same rule. A member call is typed by running it, and
// this one cannot be run: `amount` is a parameter, so the checker has no value
// to hand `.of`. What the call produces is therefore unknown, which is `⊤` —
// and no `sig` is believed for a `⊤`.
//
// A type variable would be believed for any `sig` at all, which is why one is
// not what "the checker knows nothing" means here.

open @import "blot:prelude" ();

const Money = #Money I32 <+ { .of = fn n => #Money n; };

const priced = fn amount => do
  sig converted = Money;
  let converted = Money.of amount;
  break converted;
end;

return priced 42;
