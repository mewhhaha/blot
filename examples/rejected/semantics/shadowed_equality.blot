// A branch proves what the function it calls computes, not what its spelling
// suggests.
//
// `==` resolves through the source fixity table to `Int.eq`, and this module
// binds that name to a function that always answers `#True`. Every call takes
// the first branch, `n` may be any of `1 | 2 | 3` there, and `case n of 1 => ...`
// covers one of them.
//
// The checker refuses to narrow rather than reading the prelude's `Int` through a
// shadow of it: a plain `let` writes the type environment and not the
// compile-time one, so the value it would have read is not the value the program
// calls. With no proof, the inner `case` is judged against the whole of
// `1 | 2 | 3` and reported here instead of trapping at run time.
//
// The same refusal covers the case no analysis of a value could ever handle:
// `Int` arriving as a function parameter, chosen by the caller.

open import "blot:prelude"

let Op = { .eq = fn a => fn b => True; .ne = fn a => fn b => False; }

let name :: 1 | 2 | 3 -> Text
let name = fn n => do:
  if n == 1:
    return case n of
      1 => "one"
  else:
    return case n of
      2 => "two"
      3 => "three"

return name 2
