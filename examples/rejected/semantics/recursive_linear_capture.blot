// A function's own name is in scope in its body, which is what makes `rec` a
// recursive group of one. A recursive call may transfer a linear capture only
// in ownership-tail position. Wrapping the call in addition means work follows
// it, so no finite call-count certificate can justify the transfer.

open @import "blot:prelude" ();

let consume = fn !value => @int.add value 1;
let !token = 41;
let go = rec (fn n => if n < 1 then consume (!token)
  else @int.add (go (@int.sub n 1)) 0 end);
return go 3;
