// A guard that proves the wrong half.
//
// `n >= @array.len xs` adds that proposition to `Phi`. It places every possible
// `n` at or past the first index outside `xs`, so this read cannot succeed
// whatever the caller passes and is rejected where it is written.
//
// Nothing about the array's length is known here, and nothing has to be. `xs`
// is a parameter, so `length(identity(xs))` names an integer the compiler cannot
// see. The comparison and access use the same immutable identity, which is all
// the entailment check needs.
//
// Writing `<` instead of `>=` is the accepted program, in `examples/indexed.blot`.

open import "blot:prelude"

sig at = [Int] -> Int -> Int
let at = fn xs => fn n =>
  if n >= @array.len xs:
    return @array.get xs n
  else:
    return 0

return at [1, 2, 3] 0
