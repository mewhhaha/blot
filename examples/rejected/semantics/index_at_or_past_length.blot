// A guard that proves the wrong half.
//
// `n >= @array.len xs` proves `n : len xs..`, and the smallest value that range
// holds is the first index past the end of `xs`. Every value it holds is
// outside the array, so this read cannot succeed whatever the caller passes —
// and a read no execution of which could succeed is reported where it is
// written instead of trapping when it runs.
//
// Nothing about the array's length is known here, and nothing has to be. `xs`
// is a parameter, so `len xs` names an integer the compiler cannot see; the
// index and the array name the same binding, so the two bounds are the same
// integer, and `len xs..` cannot meet `0..len xs - 1` whatever that integer is.
//
// Writing `<` instead of `>=` is the accepted program, in `examples/indexed.blot`.

open {} = (@import "blot:prelude") ();

sig at = [Int] -> Int -> Int;
let at = xs => (n => if n >= @array.len xs then @array.get xs n else 0 end);

return at [1, 2, 3] 0;
