// A familiar field path is not a relational proof; the closure body must verify.
open import "blot:prelude"

let Array = { .length = fn _ => 10; }

sig at = [Int] -> Int -> Int
let at = fn values => fn index => case index >= 0 && index < Array.length values of
  #True => @array.get values index
  #False => 0

return at
