// A compile-time binding with the right field name is still not equality.
// Recognition interrogates the closure itself, so this constant cannot narrow
// `n` and the one-arm case remains non-exhaustive.

open import "blot:prelude"

const Eq = { .eq = fn _ => fn _ => True; .ne = fn _ => fn _ => False; }

sig name = 1 | 2 | 3 -> Str
let name = fn n => do:
  if n == 1:
    return case n of
      1 => "one"
  else:
    return case n of
      2 => "two"
      3 => "three"

return name 2
