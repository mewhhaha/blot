// An effect with no handler is an error, not a silent no-op. There is no
// ambient handler and no default to fall through to.

open {} = (@import "blot:prelude") ();

const Console = @effect { .write = Str -> Unit; };
_ <- case 1 of
  1 => Console.write "nobody is listening",
  _ => Console.write "still nobody"
end;
return ();
