// Spreading a record the function was handed, rather than one it wrote.
//
// `r`'s fields are not known where `tagging` is defined, so the shape it
// returns has `.tag` and nothing else — inventing names for a variable would
// mean typing `.x` on records that do not have one. Blot has width subtyping
// on what a function *reads*; it does not have a row variable for what a
// spread *carries through*, which is what typing this would need.
//
// Spread a record whose fields are written where the spread is, and this is a
// non-issue. The limit is on the parameter, not on the syntax.

open import "blot:prelude"

let tagging = fn r => { ...r; .tag = 1; }

let tagged = tagging { .x = 1; }

export tagged.x
