// `reuse` checks a cost contract; it cannot turn an ordinary value into owned
// storage. Removing `reuse` makes this the normal persistent array update.

open import "blot:prelude"

sig clear_first = [Int] -> [Int]
const clear_first = reuse fn values => do:
  if @array.len values > 0:
    return @array.set values 0 0

  return values

return clear_first
