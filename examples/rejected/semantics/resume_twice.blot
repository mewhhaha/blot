// An *unmarked* `resume` is still one-shot, but only the runtime knows it. Mark
// it `?resume` and the second call becomes a static error instead — compare
// `affine_resumed_twice.blot`. Both reject; only one does so before running.

open @import "blot:prelude" ();

const Choice = @effect { .pick = Unit -> I32; };
const twice = { .pick = fn (_, resume) => do
  first <- resume 1;
  second <- resume 2;
  in @int.add first second
end; .return = fn v => v; };
let work = fn () => do
  result <- Choice.pick ();
  in result
end;
return @handle (Choice, work, twice);
