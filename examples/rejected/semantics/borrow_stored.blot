// A borrow is a lexical view for an immediate borrowing call or projection.
// Storing it would require a lifetime in the value's type, which Blot does not
// have.

open @import "blot:prelude" ();

let consume = fn !value => value + 1;
let !token = 41;
let view = &token;

return { .view = view; .consumed = consume (!token); };
