// Two shapes reaching one projection.
//
// Width subtyping accepts this: `fn v => v.x` asks only for an `.x`, and both
// records have one. `blot check` types it and prints its principal type. Core
// records are nominal and invariant, so there is no single record type behind
// that one projection — `{ .x; .y; }` and `{ .x; .z; }` are two of them, and
// their union is a record neither call site builds.
//
// So this is refused at build, by name, rather than compiled against an
// invented third shape. Give the two call sites the same fields, or read `.x`
// at each of them.

open {} = (@import "blot:prelude") ();

const Console = @effect.host {
  .write = Str -> Unit;
};

let get_x = fn v => v.x;

let here = do
  let _ = Console.write "disagreeing";
  in { .x = 1; .y = 2; }
end;

return get_x here + get_x { .x = 3; .z = 4; };
