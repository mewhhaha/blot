// A generic instantiated with a type it refuses. The diagnostic is the one the
// program wrote, not one the compiler invented.
open {} = (@import "blot:prelude") ();

const adding = T => do
  let _ = expect (refines (T, Int), "adding is integers only, and this is not one");
  in (a, b) => @int.add a b
end;

const broken = adding Str;

return broken ("a", "b");
