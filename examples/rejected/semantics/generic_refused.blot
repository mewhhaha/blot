// A generic instantiated with a type it refuses. The diagnostic is the one the
// program wrote, not one the compiler invented.
open import "blot:prelude"

const adding = fn T => case expect (
  refines (T, Int),
  "adding is integers only, and this is not one"
  ) of
  () => fn (a, b) => @int.add a b

const broken = adding Str

return broken ("a", "b")
