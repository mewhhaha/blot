// The arms of a `case` must cover the scrutinee, and a literal union is a
// scrutinee like any other. `1 | 2 | 3` is a three-element set, so arms that
// name only `1` leave two values reaching runtime with nothing to match.
//
// The sibling `missing_case.blot` is the same rule over a constructor set.

open import "blot:prelude"

let describe :: 1 | 2 | 3 -> Text
let describe = fn level => case level of
  1 => "low"
return describe
