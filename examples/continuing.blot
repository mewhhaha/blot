open import "blot:prelude"

const run :: Int -> Int = fn limit => do:
  let total = 0
  for outer in Iter.range (0, limit):
    total := total + 1
    if outer % 2 == 0:
      continue

    for inner in Iter.range (0, 3):
      if inner == 1:
        continue

      total := total + 10

    total := total + 100

  let matched = 0
  for index in Iter.range (0, limit):
    let optional = case index % 2 == 0 of
      #True => None
      #False => Some index
    if let #Some value = optional else:
      continue

    matched := matched + value

  return total + matched

return run 4
