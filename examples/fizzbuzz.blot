// A familiar loop written as an ordinary Blot program.
//
// The labels are text values, and the array grows through rebinding rather
// than assignment. `%` resolves through the ordinary prelude.

open import "blot:prelude"

let label = fn value => case value of
  n if n % 15 == 0 => "fizzbuzz"
  n if n % 3 == 0 => "fizz"
  n if n % 5 == 0 => "buzz"
  n => Text.of_int n

let output = []
for value in Iter.range (1, 16):
  output := [...output, label value]

return output
