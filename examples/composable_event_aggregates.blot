open import "blot:prelude"
const A = import "./lib/event_aggregate.blot"

const Amount = refine (Int, fn amount => amount >= 1 && amount <= 100)
const CounterCommand = #Deposit Amount | #Withdraw Amount
const CounterEvent = #Deposited Amount | #Withdrawn Amount
const CounterError = #Insufficient Amount

const counter :: A.Aggregate (Int, CounterCommand, CounterEvent, CounterError)
const counter =
  {
    .initial = 0;
    .decide = fn (balance, command) => case command of
      #Deposit amount => Ok [#Deposited amount]
      #Withdraw amount => do:
        if amount <= balance:
          return Ok [#Withdrawn amount]

        return Error (#Insufficient amount)
    ;
    .evolve = fn (balance, event) => case event of
      #Deposited amount => balance + amount
      #Withdrawn amount => balance - amount
    ;
  }

const GateState = #Closed | #Open
const GateCommand = #OpenGate | #CloseGate
const GateEvent = #Opened | #ClosedEvent
const GateError = #AlreadyOpen | #AlreadyClosed

const gate :: A.Aggregate (GateState, GateCommand, GateEvent, GateError)
const gate =
  {
    .initial = #Closed;
    .decide = fn (state, command) => case (state, command) of
      (#Closed, #OpenGate) => Ok [#Opened]
      (#Open, #CloseGate) => Ok [#ClosedEvent]
      (#Open, #OpenGate) => Error #AlreadyOpen
      (#Closed, #CloseGate) => Error #AlreadyClosed
    ;
    .evolve = fn (_, event) => case event of
      #Opened => #Open
      #ClosedEvent => #Closed
    ;
  }

const SystemCommand = A.ProductCommand (CounterCommand, GateCommand)
const SystemEvent = A.ProductEvent (CounterEvent, GateEvent)
const SystemError = A.ProductError (CounterError, GateError)
const SystemState = (Int, GateState)

const system ::
  A.Aggregate (SystemState, SystemCommand, SystemEvent, SystemError)
const system = A.product (counter, gate)

const system_left ::
  Result (A.Execution (SystemState, SystemEvent), SystemError)
const system_left = A.execute (system, system.initial, #Left (#Deposit 8))

const system_right ::
  Result (A.Execution (SystemState, SystemEvent), SystemError)
const system_right = A.execute (system, (8, #Closed), #Right #OpenGate)

const system_left_error ::
  Result (A.Execution (SystemState, SystemEvent), SystemError)
const system_left_error =
  A.execute (system, (2, #Closed), #Left (#Withdraw 5))

const system_right_error ::
  Result (A.Execution (SystemState, SystemEvent), SystemError)
const system_right_error =
  A.execute (system, (0, #Open), #Right #OpenGate)

const history :: [SystemEvent]
const history =
  [#Left (#Deposited 8), #Right #Opened, #Left (#Withdrawn 3)]

return {
  .default = {
    .deposit = A.execute (counter, 4, #Deposit 6);
    .withdraw = A.execute (counter, 10, #Withdraw 3);
    .insufficient = A.execute (counter, 2, #Withdraw 5);
    .opened = A.execute (gate, #Closed, #OpenGate);
    .duplicate_open = A.execute (gate, #Open, #OpenGate);
    .system_left;
    .system_right;
    .system_left_error;
    .system_right_error;
    .replayed = A.replay (system, history);
    .empty = A.replay (system, []);
  };
}
