open import "../src/prelude/prelude.blot"

let taken = Array.take ([10, 20, 30], 1)
let missed = Array.take ([10, 20, 30], 9)
let split = Array.split ([10, 20, 30], 1)
let taken_value = case taken of
  #Taken (value, _) => value
  #TakeOutOfBounds _ => 0
let missed_length = case missed of
  #Taken (_, remainder) => Array.length remainder
  #TakeOutOfBounds original => Array.length original
let split_lengths = case split of
  #Split (before, value, after) => (
    Array.length before,
    value,
    Array.length after
  )
  #SplitOutOfBounds _ => (0, 0, 0)
let head = case Array.uncons [10, 20, 30] of
  #Some (value, remainder) => (value, Array.length remainder)
  #None => (0, 0)
let empty_head = case Array.uncons [] of
  #Some _ => False
  #None => True
let (even, odd) =
  Array.partition (
  [1, 2, 3, 4, 5, 6],
  fn value => value % 2 == 0
)

return {
  .taken_value = taken_value;
  .missed_length = missed_length;
  .split_lengths = split_lengths;
  .head = head;
  .empty_head = empty_head;
  .even = even;
  .odd = odd;
}
