open import "../src/prelude/prelude.blot"

let (taken_value, remainder) = @array.take [10, 20, 30] 1
let (before, split_value, after) = @array.split [10, 20, 30] 1
let split_lengths =
  (
    Array.length before,
    split_value,
    Array.length after
  )
let head = case Array.uncons [10, 20, 30] of
  #Some (value, remainder) => (value, Array.length remainder)
  #None => (0, 0)
let empty_head = case Array.uncons [] of
  #Some _ => False
  #None => True
let (even, odd) =
  Array.partition (
  [1, 2, 3, 4, 5, 6],
  fn value => value % 2 == 0
)

return {
  .taken_value = taken_value;
  .remainder_length = Array.length remainder;
  .split_lengths = split_lengths;
  .head = head;
  .empty_head = empty_head;
  .even = even;
  .odd = odd;
}
