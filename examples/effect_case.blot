open import "blot:prelude"

const Console = @effect { .write = Text -> Unit; }

let choose = fn selected => do:
  use case selected of
    1 => Console.write "one"
    _ => Console.write "other"

let recording =
  {
    .write = fn (message, ?resume) => message;
    .return = fn _ => "none";
  }

return {
  .first = @handle (
    Console,
    (fn () => do:
      use result <- choose 1
      return result
    ),
    recording
  );
  .other = @handle (
    Console,
    (fn () => do:
      use result <- choose 2
      return result
    ),
    recording
  );
}
