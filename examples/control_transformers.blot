// Surface control elaborates to ordinary recursion and cases. Each pair below
// computes the same value once through the surface form and once through the
// shape it elaborates to: a loop with `break` next to its `rec`/`case` fold, a
// `do` block with early `return` next to its `case` equivalent, and a handler
// step next to its saturated `@handle` call.

open import "blot:prelude"

// A loop is a fold: the names rebound with `:=` are the accumulator, and
// `break` carries that accumulator out of the nearest `for`.
let loop_sum = 0
for value in Iter.range (0, 5):
  loop_sum := loop_sum + value
  if value >= 3:
    break

// The same fold written as ordinary recursion over the same iterator. The
// explicit `rec` threads the accumulator and stops on the same condition.
let source = Iter.range (0, 5)
let rec walk = fn (state, carried) => case source.step state of
  #None => carried
  #Some pair => do:
    let advanced = carried + pair.0
    if pair.0 >= 3:
      return advanced

    return walk (pair.1, advanced)

let folded_sum = walk (source.state, 0)

// Early `return` exits the nearest `do` with a tagged result the boundary
// eliminates; the `case` below decides the same value directly.
let describe = fn total => do:
  if total >= 6:
    return "reached"

  return "short"

let choose = fn total => case total >= 6 of
  #True => "reached"
  #False => "short"

// A handler step is a computation transformer awaiting its computation: piping
// saturates it to the ordinary three-argument `@handle` call.
const Bump = @effect { .add = Int -> Int; }

let program = fn () => do:
  use doubled <- Bump.add 5
  return doubled + 1

let adding =
  {
    .add = fn (value, ?resume) => do:
      use rest <- resume (value + 10)
      return rest
    ;
  }

let via_step = program |> @handle (Bump, adding)
let called = @handle (Bump, program, adding)
use stepped <- via_step

return {
  .loop_sum = loop_sum;
  .folded_sum = folded_sum;
  .early = describe loop_sum;
  .chosen = choose loop_sum;
  .short_early = describe 0;
  .short_chosen = choose 0;
  .stepped = stepped;
  .called = called;
}
