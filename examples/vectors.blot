// Four lanes, as one value.
//
// `F32x4` is a distinct type rather than a tuple of four `F32`. The point of
// naming it is that the operations over it are single instructions, and a shape
// blot could take apart field by field would not be — so the type says
// "register" and the primitives say which instruction.
//
// gpufuck ships scalar bodies for these operations, and its codegen replaces
// their call sites with `f32x4.*` instructions when it is asked for SIMD. The
// comptime evaluator does the same arithmetic one lane at a time and must agree
// with the register.

open @import "blot:prelude" ();

// There is no f32 literal and no vector literal. `Float32.of_int` narrows and
// `Vec4.of` gathers, which keeps the grammar at one float token and makes both
// steps something the program wrote down.
const lane = Float32.of_int;

sig axis = F32x4;
let axis = Vec4.of (lane 1, lane 2, lane 3, lane 4);

sig ten = F32x4;
let ten = Vec4.splat (lane 10);

// --- arithmetic -------------------------------------------------------------
//
// Lane-wise, and one instruction each. Strict chains stay in a `v128` across
// let bindings and calls when every argument is provably a vector; materialized
// closures and lazy boundaries still box because a heap value must outlive the
// native worker that produced it.

sig scaled = F32x4;
let scaled = Vec4.mul (Vec4.add axis ten) ten;

sig difference = F32x4;
let difference = Vec4.sub scaled ten;

sig halved = F32x4;
let halved = Vec4.div scaled (Vec4.splat (lane 2));

sig selected = F32x4;
let selected = Vec4.select (Vec4.less axis ten) ten axis;

sig shuffled = F32x4;
let shuffled = Vec4.shuffle (selected, halved, 0, 5, 2, 7);

// --- reading a lane ---------------------------------------------------------
//
// By name, not by index. The target has four extract instructions and no way to
// choose between them at run time, so a `get` taking a number could not lower —
// naming them is what makes that limit visible rather than a surprise.

sig first = Int;
let first = Float32.truncate (Vec4.x scaled);

sig last = Int;
let last = Float32.truncate (Vec4.w scaled);

// --- what the lanes are for -------------------------------------------------
//
// A dot product is a lane-wise multiply and a horizontal sum, so it is prelude
// source: it is writable over the two instructions below it.

sig dot = Int;
let dot = Float32.truncate (Vec4.dot axis axis);

// `dot` is `sum` over a lane-wise multiply, and `sum` is one instruction where
// four extracts and three adds would be seven. It is a primitive for the same
// reason the four arithmetic operations are: the target has an instruction and
// blot has no way to write one.
sig total = Int;
let total = Float32.truncate (Vec4.sum scaled);

// Single precision, still: the lanes round the way `F32` does, and a sum that
// needs more than 24 bits of mantissa says so here as much as anywhere.
sig thirds = Int;
let thirds = Float32.truncate (Vec4.dot
(Vec4.splat (Float32.of_float (Float.div 1.0 3.0)))
(Vec4.splat (lane 3)));

return {
  .first = first;
  .last = last;
  .second_of_difference = Float32.truncate (Vec4.y difference);
  .third_of_halved = Float32.truncate (Vec4.z halved);
  .dot = dot;
  .total = total;
  .thirds = thirds;
  .shuffled = Float32.truncate (Vec4.sum shuffled);
};
