// A parent-indexed layout table: each node reads its parent's resolved frame,
// then appends its own. `frames` is linear, so every append hands the backing
// Store to the next recursive step instead of rebuilding the whole prefix.

open @import "blot:prelude" ()

let nodes =
  [
    { .parent = -1; .offset = 10; .width = 100; },
    { .parent = 0; .offset = 20; .width = 40; },
    { .parent = 1; .offset = 5; .width = 10; }
  ]

let layout =
  rec (fn (index, !frames) =>
    if index < 0 || index >= @array.len nodes:
      return frames
    else:
      let node = @array.get nodes index
      let parent_x = case node.parent < 0 of
        #True => 0
        #False => case Array.get ((&frames), node.parent) of
          #Some parent => parent.x
          #None => 0

      let frame =
        {
          .x = parent_x + node.offset;
          .width = node.width;
        }
      return layout (index + 1, @array.push frames frame)

  )

let frames = layout (0, [])
return case Array.get (frames, 2) of
  #Some frame => frame.x + frame.width
  #None => 0
