open import "blot:prelude"
const Adapter = import "../lib/endpoint_adapter.blot"

const Maybe = fn Value => #Found Value | #Missing
const Checked = fn Value => #Ok Value | #Error Text
const Observed =
  fn Value => #Ok { .value = Value; .source = Text; } | #Error Text

const require :: Adapter.Natural (Maybe, Checked)
const require = fn candidate => case candidate of
  #Found value => #Ok value
  #Missing => #Error "missing"

const observe :: Adapter.Natural (Checked, Observed)
const observe = fn candidate => case candidate of
  #Ok value => #Ok { .value; .source = "registry"; }
  #Error error => #Error error

// Pain point: the composed value is returned from a Rank-N signature, but without
// restating that signature here specialization currently loses the payload and
// the applied result checks as bottom.
const require_observed =
  Adapter.compose (Maybe, Checked, Observed) (require, observe)
const observe_endpoint = Adapter.hoist (Maybe, Observed)

const lookup :: Text -> Maybe Text
const lookup = fn _ => #Found "Żaneta"
return observe_endpoint (require_observed, lookup) "owner"
