// Modules.
//
// A module is an ordered computation from an optional input to one exported
// value. Resolution and instantiation happen while compiling, and an imported
// module sees only the input its caller supplies.

const application =
  import "./lib/score.blot" with {
    .base = 40;
    .bonus = 2;
  }
const prelude = import "blot:prelude"

// The prelude is an ordinary module. Importing it without opening it keeps its
// exports behind the `prelude` name.
let explicit = prelude.Int.add 20 22

return {
  .run = application.run;
  .scaled = application.scaled;
  .explicit = explicit;
}
