// Generate runtime smart constructors and total clamping functions from one
// compile-time integer range. The same abstraction is reused for deployment,
// scheduling, and sensor domains without duplicating each refinement's bounds.

open import "blot:prelude"
const Domain = import "./lib/bounded_int_domain.blot"

const Percent = Domain.bounded (0, 100)
const CanaryPercent = Domain.bounded (5, 25)
const Priority = Domain.bounded (1, 5)
const TemperatureC = Domain.bounded (-40, 85)

// The narrower generated carrier is an ordinary subtype of the wider one.
// No conversion or unchecked cast is required.
let as_percent :: CanaryPercent.Type -> Percent.Type
let as_percent = fn value => value

let render_percent :: Percent.Type -> Text
let render_percent = fn value => Text.append (Text.of_int value) "%"

const canary = CanaryPercent.clamp 99
const scheduled = Priority.clamp 9
const safe_temperature = TemperatureC.clamp (-100)

// Pain point: the compiler proves numeric set membership and subtyping, not the
// application's unit meaning. `TemperatureC.Type` and another -40..85 range are
// structurally the same type even if the other range means Fahrenheit. Keep
// unit semantics in distinct data models rather than treating equal ranges as
// nominal domain identities.
return {
  .default = {
    .admitted_lower = CanaryPercent.admit 5;
    .admitted_middle = CanaryPercent.admit 17;
    .rejected_lower = CanaryPercent.admit 4;
    .rejected_upper = CanaryPercent.admit 26;
    .clamped_lower = CanaryPercent.clamp (-1);
    .clamped_upper = canary;
    .widened = render_percent (as_percent canary);
    .priority = scheduled;
    .temperature = safe_temperature;
    .percent_boundary = Percent.contains 100;
    .percent_over = Percent.contains 101;
  };
}
