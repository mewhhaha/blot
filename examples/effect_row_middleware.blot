// Reusable middleware adds its own effects while preserving every effect of the wrapped callback.
open import "blot:prelude"

const Middleware = import "./lib/effect_middleware.blot"
const Fetch = @effect { .get = Int -> Int; }

let service :: Int -> Int ~ { Fetch }
let service = fn key => do:
  use value <- Fetch.get key
  return value * 2

const instrument ::
  @forall (fn Input => @forall (fn Output => (Input -> Output ~ { ..e }) -> Input -> Output ~ { Middleware.Trace, Middleware.Metrics, ..e }))
const instrument =
  fn operation => Middleware.traced (Middleware.counted operation)

let instrumented :: Int -> Int ~ { Middleware.Trace, Middleware.Metrics, Fetch }
let instrumented = instrument service

const fetch_handler =
  {
    .get = fn (key, ?resume) => do:
      use result <- resume (key + 1)
      return result
    ;
  }

const trace_score =
  {
    .event = fn (_, ?resume) => do:
      use result <- resume ()
      return result + 100
    ;
    .return = fn result => result;
  }

const metric_score =
  {
    .increment = fn (_, ?resume) => do:
      use result <- resume ()
      return result + 10
    ;
    .return = fn result => result;
  }

let effectful_program ::
  Unit -> Int ~ { Middleware.Trace, Middleware.Metrics, Fetch }
let effectful_program = fn () => instrumented 20
let effectful =
  effectful_program
    |> @handle (Fetch, fetch_handler)
    |> @handle (Middleware.Trace, trace_score)
    |> @handle (Middleware.Metrics, metric_score)
use effectful_answer <- effectful

let pure_program :: Unit -> Int ~ { Middleware.Trace, Middleware.Metrics }
let pure_program =
  fn () => instrument (fn value => value + 1) 40
let pure =
  pure_program
    |> @handle (Middleware.Trace, trace_score)
    |> @handle (Middleware.Metrics, metric_score)
use pure_answer <- pure

return { .default = { .effectful = effectful_answer; .pure = pure_answer; }; }
