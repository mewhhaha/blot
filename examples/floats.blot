// Floats.
//
// Blot's second numeric type, and its first inexact one. A float literal needs
// a digit on both sides of the point, which is what keeps `1.5` a float and
// `pair.0` a projection: the field has no digit before its dot and a float
// always does.
//
// `F64` is the only float type. There is no `1.5` singleton the way there is a
// `1` singleton, because a float bound would have to be a real number and
// nothing the lattice does with bounds — adjacency, enumeration — has a
// meaning there. So a float literal inhabits `F64` and the narrowing machinery
// never has to answer a question about reals.

open import "blot:prelude"

// --- arithmetic -------------------------------------------------------------
//
// `Float.add` rather than `+`. An operator resolves to one binding by name, so
// a single `+` over both numeric types would have to dispatch on a value's
// type at run time, which is the typeclass machinery this language does not
// have. A module that wants an operator for these says so in its own header.

sig quarter = F64
let quarter = Float.div 1.0 4.0

sig sum = F64
let sum = Float.add 1.5 2.25

sig scaled = F64
let scaled = Float.mul quarter 8.0

// --- crossing between the two -----------------------------------------------
//
// Explicitly, in both directions. `truncate` rounds toward zero, which is what
// WebAssembly's saturating conversion does.

sig widened = F64
let widened = Float.of_int 7

sig narrowed = Int
let narrowed = Float.truncate 3.75

sig negative = Int
let negative = Float.truncate (Float.negate 3.75)

// --- comparison, and the value no ordering accepts --------------------------
//
// There is no `Float.eq`. Exact comparison is `is_equal (Float.cmp a b)`, and
// that is not a shorthand missing — it is the same test with the NaN case left
// in. An equality that answered `#False` for NaN would be answering a question
// the format says has no answer, and it would look exactly like the integer
// `==` that `0.1 + 0.2 == 0.3` is famous for failing.
//
// So `Float.cmp` refuses a NaN, in both executions: a diagnostic while
// compiling and a trap while running, the way `@int.div` by zero already does.
// A program that might hold one asks `Float.is_nan` first, and that question
// needs a primitive precisely because comparing is what refuses.

sig ordered = Bool
let ordered = is_less (Float.cmp 1.5 2.5)

sig same = Bool
let same = is_equal (Float.cmp 0.5 (Float.div 1.0 2.0))

sig tenth_is_exact = Bool
let tenth_is_exact = is_equal (Float.cmp (Float.add 0.1 0.2) 0.3)

sig nan_is_nan = Bool
let nan_is_nan = Float.is_nan (Float.div 0.0 0.0)

sig ordinary_is_not = Bool
let ordinary_is_not = Float.is_nan 1.0

// --- a root, written in blot ------------------------------------------------
//
// `@float.sqrt` is not a primitive. Core has no f64 square root either, so it
// would have been open-coded at lowering — and a primitive is for what blot
// cannot write, which this is not.

sig root = Int
let root = Float.truncate (Float.mul (Float.sqrt 2.0) 1000.0)

// --- the narrower one -------------------------------------------------------
//
// `F32` is a distinct type reached by conversion. There is no f32 literal: the
// grammar has one float token, and `Float32.of_float` is what makes the loss of
// precision a step the program takes rather than one performed on it.
//
// It is a separate type rather than a precision `F64` sometimes has, so mixing
// them is an error rather than a rounding nobody wrote down — and because it is
// the lane type a four-wide vector needs.

sig third_64 = Int
let third_64 = Float.truncate (Float.mul (Float.div 1.0 3.0) 1000000000.0)

// The same division, in single precision, widened back to compare. The digits
// stop earlier, which is the whole difference between the two types.
sig third_32 = Int
let third_32 =
  Float.truncate (Float.mul
    (Float32.widen (Float32.div (Float32.of_int 1) (Float32.of_int 3)))
  1000000000.0)

// A double that is exact in f32 survives the round trip; one that is not does
// not. This is the pair that shows the narrowing is real rather than a label.
sig exact_round_trip = Bool
let exact_round_trip =
  is_equal (Float.cmp
    (Float32.widen (Float32.of_float 0.5))
  0.5)

sig lossy_round_trip = Bool
let lossy_round_trip =
  is_equal (Float.cmp
    (Float32.widen (Float32.of_float 0.1))
  0.1)

// --- the boundary -----------------------------------------------------------
//
// Every export here is an `Int` or a `Bool`, and that is this file's choice
// rather than a limit: `F32` and `F64` are canonical `f32` and `f64` at the
// ABI, so a float crosses on its own — `examples/float_boundary.blot` is the
// program that exports one. Truncating here keeps every answer below an exact
// integer, which is what lets the interpreter, the GPU evaluator, and the
// emitted Wasm be compared without a rounding argument.
//
// `F32x4` is the value that genuinely cannot cross. Publishing one is
// `BLOT_VECTOR_AT_BOUNDARY`; extract a lane or select a vector first.

return {
  .quarter = Float.truncate (Float.mul quarter 100.0);
  .sum = Float.truncate (Float.mul sum 100.0);
  .scaled = Float.truncate scaled;
  .widened = Float.truncate widened;
  .narrowed = narrowed;
  .negative = negative;

  .ordered = ordered;
  .same = same;
  .tenth_is_exact = tenth_is_exact;
  .nan_is_nan = nan_is_nan;
  .ordinary_is_not = ordinary_is_not;

  .root = root;

  .third_64 = third_64;
  .third_32 = third_32;
  .exact_round_trip = exact_round_trip;
  .lossy_round_trip = lossy_round_trip;
}
