// Floats.
//
// Blot's second numeric type, and its first inexact one. A float literal needs
// a digit on both sides of the point, which is what keeps `1.5` a float and
// `pair.0` a projection: the field has no digit before its dot and a float
// always does.
//
// There is no `1.5` singleton the way there is a `1` singleton, because a
// float bound would have to be a real number and nothing the lattice does with
// bounds — adjacency, enumeration — has a meaning there. A float literal
// defaults to `F64`, while an `F32` context selects single precision directly.

open import "blot:prelude"

// --- arithmetic -------------------------------------------------------------
//
// `F64.add` rather than `+`. An operator resolves to one binding by name, so
// a single `+` over both numeric types would have to dispatch on a value's
// type at run time, which is the typeclass machinery this language does not
// have. A module that wants an operator for these says so in its own header.

let quarter :: F64
let quarter = F64.div 1.0 4.0

let sum :: F64
let sum = F64.add 1.5 2.25

let scaled :: F64
let scaled = F64.mul quarter 8.0

// --- crossing between the two -----------------------------------------------
//
// Explicitly, in both directions. `truncate` rounds toward zero, which is what
// WebAssembly's saturating conversion does.

let widened :: F64
let widened = F64.of_int 7

let narrowed :: Int
let narrowed = F64.truncate 3.75

let negative :: Int
let negative = F64.truncate (F64.negate 3.75)

// --- comparison, and the value no ordering accepts --------------------------
//
// There is no `F64.eq`. Exact comparison is `is_equal (F64.cmp a b)`, and
// that is not a shorthand missing — it is the same test with the NaN case left
// in. An equality that answered `#False` for NaN would be answering a question
// the format says has no answer, and it would look exactly like the integer
// `==` that `0.1 + 0.2 == 0.3` is famous for failing.
//
// So `F64.cmp` refuses a NaN, in both executions: a diagnostic while
// compiling and a trap while running, the way `@int.div` by zero already does.
// A program that might hold one asks `F64.is_nan` first, and that question
// needs a primitive precisely because comparing is what refuses.

let ordered :: Bool
let ordered = is_less (F64.cmp 1.5 2.5)

let same :: Bool
let same = is_equal (F64.cmp 0.5 (F64.div 1.0 2.0))

let tenth_is_exact :: Bool
let tenth_is_exact = is_equal (F64.cmp (F64.add 0.1 0.2) 0.3)

let nan_is_nan :: Bool
let nan_is_nan = F64.is_nan (F64.div 0.0 0.0)

let ordinary_is_not :: Bool
let ordinary_is_not = F64.is_nan 1.0

// --- a root, written in blot ------------------------------------------------
//
// `@float.sqrt` is not a primitive. Core has no f64 square root either, so it
// would have been open-coded at lowering — and a primitive is for what blot
// cannot write, which this is not.

let root :: Int
let root = F64.truncate (F64.mul (F64.sqrt 2.0) 1000.0)

// --- the narrower one -------------------------------------------------------
//
// `F32` is a distinct type. The grammar has one float token; an `F32` call or
// signature selects its single-precision representation. Conversion remains
// explicit for a value that was already bound as `F64`.
//
// It is a separate type rather than a precision `F64` sometimes has, so mixing
// bound values is an error rather than a rounding nobody wrote down — and
// because it is the lane type a four-wide vector needs.

let third_64 :: Int
let third_64 = F64.truncate (F64.mul (F64.div 1.0 3.0) 1000000000.0)

// The same division, in single precision, widened back to compare. The digits
// stop earlier, which is the whole difference between the two types.
let third_32 :: Int
let third_32 =
  F64.truncate (F64.mul
    (F32.widen (F32.div 1 3))
    1000000000.0)

// A double that is exact in f32 survives the round trip; one that is not does
// not. This is the pair that shows the narrowing is real rather than a label.
let exact_round_trip :: Bool
let exact_round_trip =
  is_equal (F64.cmp
    (F32.widen 0.5)
    0.5)

let lossy_round_trip :: Bool
let lossy_round_trip =
  is_equal (F64.cmp
    (F32.widen 0.1)
    0.1)

// --- the boundary -----------------------------------------------------------
//
// Every export here is an `Int` or a `Bool`, and that is this file's choice
// rather than a limit: `F32` and `F64` are canonical `f32` and `f64` at the
// ABI, so a float crosses on its own — `examples/float_boundary.blot` is the
// program that exports one. Truncating here keeps every answer below an exact
// integer, which is what lets the interpreter, the GPU evaluator, and the
// emitted Wasm be compared without a rounding argument.
//
// `F32x4` is the value that genuinely cannot cross. Publishing one is
// `BLOT_VECTOR_AT_BOUNDARY`; extract a lane or select a vector first.

return {
  .quarter = F64.truncate (F64.mul quarter 100.0);
  .sum = F64.truncate (F64.mul sum 100.0);
  .scaled = F64.truncate scaled;
  .widened = F64.truncate widened;
  .narrowed = narrowed;
  .negative = negative;

  .ordered = ordered;
  .same = same;
  .tenth_is_exact = tenth_is_exact;
  .nan_is_nan = nan_is_nan;
  .ordinary_is_not = ordinary_is_not;

  .root = root;

  .third_64 = third_64;
  .third_32 = third_32;
  .exact_round_trip = exact_round_trip;
  .lossy_round_trip = lossy_round_trip;
  }
