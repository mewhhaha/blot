// `return` exits the nearest module or explicit `do`, including from a
// statement branch or across a loop. A nested `do` catches its own return.

open @import "blot:prelude" ()

let describe = fn value =>
  if value < 0:
    return "negative"

  if value == 0:
    return "zero"

  return "positive"

let unwrap = fn option =>
  if let #Some value = option else:
    return -1

  return value

let find = fn wanted =>
  for value in Iter.range (0, 5):
    if value == wanted:
      return value

  return -1

let count_to = fn limit =>
  let count = 0
  for ever:
    count := count + 1
    if count >= limit:
      return count

  return 0

let count_or_stop = fn limit =>
  let count = 0
  for ever:
    count := count + 1
    if count >= limit:
      return count

    if count >= 5:
      break

  return -1

let nested_if = fn () =>
  let inner = if 1 < 2:
    return 41
  else:
    return 0
  return inner + 1

let nested_case = fn () =>
  let inner = case Some 41 of
    #Some value =>
      return value

    #None => 0
  return inner + 1

return {
  .negative = describe (-1);
  .zero = describe 0;
  .positive = describe 1;
  .unwrapped = unwrap (Some 7);
  .absent = unwrap None;
  .found = find 3;
  .missing = find 8;
  .counted = count_to 4;
  .returned_from_loop = count_or_stop 3;
  .broke_loop = count_or_stop 8;
  .nested_if = nested_if ();
  .nested_case = nested_case ();
}
