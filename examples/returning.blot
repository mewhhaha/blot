// `return` exits the nearest source function. `break value` exits the nearest
// `do` block, including from a statement branch or across a loop.

open @import "blot:prelude" ();

let describe = fn value => do
  if value < 0 then
    break "negative";
  end;
  if value == 0 then
    break "zero";
  end;
  break "positive";
end;

let unwrap = fn option => do
  if let #Some value = option else
    return -1;
  end;
  break value;
end;

let find = fn wanted => do
  for value in Iter.range (0, 5) do
    if value == wanted then
      return value;
    end;
  end;
  break -1;
end;

let count_to = fn limit => do
  let count = 0;
  for ever do
    count := count + 1;
    if count >= limit then
      break count;
    end;
  end;
  break 0;
end;

let count_or_stop = fn limit => do
  let count = 0;
  for ever do
    count := count + 1;
    if count >= limit then
      return count;
    end;
    if count >= 5 then
      break;
    end;
  end;
  break -1;
end;

return {
  .negative = describe (-1);
  .zero = describe 0;
  .positive = describe 1;
  .unwrapped = unwrap (Some 7);
  .absent = unwrap None;
  .found = find 3;
  .missing = find 8;
  .counted = count_to 4;
  .returned_from_loop = count_or_stop 3;
  .broke_loop = count_or_stop 8;
};
