// `return` exits the nearest module or explicit `do`, including from a
// statement branch or across a loop. A nested `do` catches its own return.

open @import "blot:prelude" ();

let describe = fn value => do
  if value < 0 then
    return "negative";
  end;
  if value == 0 then
    return "zero";
  end;
  return "positive";
end;

let unwrap = fn option => do
  if let #Some value = option else
    return -1;
  end;
  return value;
end;

let find = fn wanted => do
  for value in Iter.range (0, 5) do
    if value == wanted then
      return value;
    end;
  end;
  return -1;
end;

let count_to = fn limit => do
  let count = 0;
  for ever do
    count := count + 1;
    if count >= limit then
      return count;
    end;
  end;
  return 0;
end;

let count_or_stop = fn limit => do
  let count = 0;
  for ever do
    count := count + 1;
    if count >= limit then
      return count;
    end;
    if count >= 5 then
      break;
    end;
  end;
  return -1;
end;

let nested_if = fn () => do
  let inner = if 1 < 2 then do
    return 41;
  end else 0 end;
  return inner + 1;
end;

let nested_case = fn () => do
  let inner = case Some 41 of
    #Some value => do
      return value;
    end,
    #None => 0
  end;
  return inner + 1;
end;

return {
  .negative = describe (-1);
  .zero = describe 0;
  .positive = describe 1;
  .unwrapped = unwrap (Some 7);
  .absent = unwrap None;
  .found = find 3;
  .missing = find 8;
  .counted = count_to 4;
  .returned_from_loop = count_or_stop 3;
  .broke_loop = count_or_stop 8;
  .nested_if = nested_if ();
  .nested_case = nested_case ();
};
