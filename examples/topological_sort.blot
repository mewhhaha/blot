open import "blot:prelude"

const topological_sort = import "./lib/topological_sort.blot"

let vertices = ["shop", "design", "cook", "code", "eat", "test", "deploy"]
let graph = [
  [2],
  [3],
  [4],
  [5],
  [],
  [6],
  []
]

let cyclic = [
  [2],
  [3],
  [4],
  [5],
  [],
  [6],
  [1]
]
let { .order = dag_order; .acyclic = dag_acyclic; } = topological_sort (&graph)
let dag_names = []
for index in Iter.range (0, Array.length (&dag_order)):
  let vertex = Array.expect_get ((&dag_order), index)
  let name = Array.expect_get ((&vertices), vertex)
  dag_names := @array.push dag_names (name <> "")

let { .order = cycle_order; .acyclic = cycle_acyclic; } =
  topological_sort (&cyclic)
let cycle_names = []
for index in Iter.range (0, Array.length (&cycle_order)):
  let vertex = Array.expect_get ((&cycle_order), index)
  let name = Array.expect_get ((&vertices), vertex)
  cycle_names := @array.push cycle_names (name <> "")

return {
  .dag = { .order = dag_names; .acyclic = dag_acyclic; };
  .cycle = { .order = cycle_names; .acyclic = cycle_acyclic; };
}
