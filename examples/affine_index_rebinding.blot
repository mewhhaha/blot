// The loop invariant carries the index bound through each literal increment.

open import "blot:prelude"

let sum :: [Int] -> Int
let sum = fn values => do:
  let index = 0
  let total = 0
  if index >= 0 && index < Array.length values:
    for _ in Iter.range (0, Array.length values):
      total := total + @array.get values index
      index := index + 1

  return total

return { .empty = sum []; .one = sum [5]; .many = sum [3, 7, 11]; }
