// A custom iterator for the Collatz sequence.
//
// The iterator state is a tagged value, so the final `1` can be yielded before
// the following `#Done` state ends traversal without a sentinel integer.

open import "blot:prelude"

const collatz = fn start => {
    .state = #Running start;
    .step = fn state => case state of
      #Done => None
      #Running value => do:
        if value == 1:
          return Some (value, #Done)
        else:
          let next = do:
            if Int.rem value 2 == 0:
              return Int.div value 2
            else:
              return value * 3 + 1
          return Some (value, #Running next)
    ;
  }

let sequence = collect (collatz 13)
return {
  .sequence = sequence;
  .steps = Array.length sequence;
}
