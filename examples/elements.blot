open @import "blot:prelude" ()

const Draw = @effect {
  .write = Str -> Unit;
  }

let element = fn name => fn _properties => fn children =>
  _ <- Draw.write ("<" <> name <> ">")
  _ <- children ()
  _ <- Draw.write ("</" <> name <> ">")
  return name

let Render = {
  .text = fn text =>
    _ <- Draw.write text
  ;
  .div = element "div";
  .icon = element "icon";
}

let text = Render.text
let div = Render.div
let icon = Render.icon

sig Button = {
  .label = Str;
  .disabled? = Bool;
  .order? = Int;
  } -> (Unit -> Unit) -> Unit ~ { Draw }
let Button = fn properties => fn children =>
  let disabled = case properties.disabled of
    () => ""
    #False => ""
    #True => " disabled"
  let order = case properties.order of
    () => ""
    value => " data-order=" <> Text.of_int value
  _ <- Draw.write ("<button" <> disabled <> order <> ">")
  _ <- text properties.label
  _ <- children ()
  _ <- Draw.write "</button>"

let view = fn () =>
  root <- <div .class="counter" .hidden=False>
    _ <- text "Count: "
    _ <- <Button .label="Save" />
    _ <- <Button .label="Delete" .disabled=True .order=2 />
    _ <- <icon />
  </div>
  return root

let collecting = {
  .write = fn (fragment, ?resume) =>
    rest <- resume ()
    return fragment <> rest
  ;
  .return = fn _ => "";
}

return @handle (Draw, (fn () =>
  _ <- view ()
), collecting)
