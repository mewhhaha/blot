open @import "blot:prelude" ()

const Draw = @effect {
  .write = Str -> Unit;
}

let element = fn name => fn _properties => fn children =>
  <- Draw.write ("<" <> name <> ">")
  for child in Iter.items children:
    <- child ()

  <- Draw.write ("</" <> name <> ">")
  return name

let Render = {
  .text = fn text =>
    <- Draw.write text
  ;
  .div = element "div";
  .icon = element "icon";
}

let text = Render.text
let div = Render.div
let icon = Render.icon

sig Button = {
  .label = Str;
  .disabled? = Bool;
  .order? = Int;
} -> [Unit -> Unit ~ { Draw }] -> Unit ~ { Draw }
let Button = fn properties => fn children =>
  let disabled = case properties.disabled of
    () => ""
    #False => ""
    #True => " disabled"
  let order = case properties.order of
    () => ""
    value => " data-order=" <> Text.of_int value
  <- Draw.write ("<button" <> disabled <> order <> ">")
  <- text properties.label
  for child in Iter.items children:
    <- child ()

  <- Draw.write "</button>"

let view = fn () =>
  root <- <div .class="counter" .hidden=False>
    text "Count: "
    <Button .label="Save" />
    <Button .label="Delete" .disabled=True .order=2 />
    <icon />
  </div>
  return root

let collecting = {
  .write = fn (fragment, ?resume) =>
    rest <- resume ()
    return fragment <> rest
  ;
  .return = fn _ => "";
}

return @handle (
  Draw,
  (fn () =>
    <- view ()
  ),
  collecting
)
