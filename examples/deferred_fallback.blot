// Typed fallback composition can preserve success values while changing or
// accumulating failure types, without evaluating an unused recovery source.
open import "blot:prelude"

const Fallback = import "./lib/deferred_fallback.blot"

const Profile = {
  .name = Text;
  .source_score = Int;
}

const CacheError = #CacheMiss Text
const StoreError = #StoreMiss Text
const ResolutionError = Fallback.BothFailed (CacheError, StoreError)

const cache: Text -> Result (Profile, CacheError)
const cache = fn key => case key == "cached" of
  #True => #Ok { .name = "Ada"; .source_score = 1; }
  #False => #Error (#CacheMiss key)

const store: (Text, Int) -> Result (Profile, StoreError)
const store = fn (key, divisor) => case key == "missing" of
  #True => #Error (#StoreMiss key)
  #False => #Ok { .name = "Grace"; .source_score = 84 / divisor; }

const resolve: (Text, Int) -> Result (Profile, ResolutionError)
const resolve = fn (key, divisor) => cache key |> Fallback.recover_with_context (store (key, divisor))

const replace_error: (Text, Int) -> Result (Profile, StoreError)
const replace_error = fn (key, divisor) => cache key |> Fallback.recover (store (key, divisor))

const Remote = @effect { .load = Text -> Result (Profile, StoreError); }

// Demand is conditional at runtime, but effect checking is deliberately
// conservative: this resolver keeps `Remote` in its row even when a cache hit
// skips the deferred `Remote.load` expression.
let resolve_remote: Text -> Result (Profile, ResolutionError) ~ { Remote }
let resolve_remote = fn key => cache key |> Fallback.recover_with_context (Remote.load key)

const remote_handler = {
  .load = fn (_, ?resume) => do:
    use answer <- resume (#Ok { .name = "Remote"; .source_score = 42; })
    return case answer of
      #Ok profile => #Ok { .name = profile.name; .source_score = profile.source_score + 100; }
      #Error error => #Error error
  ;
  .return = fn answer => answer;
}

let cached_remote_program: Unit -> Result (Profile, ResolutionError) ~ { Remote }
let cached_remote_program = fn () => resolve_remote "cached"
let cached_remote = cached_remote_program |> @handle (Remote, remote_handler)
use cached_remote_answer <- cached_remote

let missing_remote_program: Unit -> Result (Profile, ResolutionError) ~ { Remote }
let missing_remote_program = fn () => resolve_remote "remote"
let missing_remote = missing_remote_program |> @handle (Remote, remote_handler)
use missing_remote_answer <- missing_remote

// The fallback for `cached` would divide by zero if it were evaluated. Because
// the cache succeeds, the deferred argument is omitted entirely at runtime.
const cached = resolve ("cached", 0)
const stored = resolve ("stored", 2)
const missing = resolve ("missing", 1)
const replaced = replace_error ("missing", 1)

return {
  .default = {
    .cached;
    .stored;
    .missing;
    .replaced;
    .cached_remote = cached_remote_answer;
    .missing_remote = missing_remote_answer;
  };
}
