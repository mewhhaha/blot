// Fold a stream of domain events into a stable record state.
//
// The event union makes every transition explicit, while the signature keeps
// all branches honest about returning the same ledger shape.

open import "blot:prelude"

const Event = #Deposit Int | #Withdraw Int
const Ledger =
  {
    .balance = Int;
    .accepted = Int;
    .rejected = Int;
  }

sig apply = (Ledger, Event) -> Ledger
let apply = fn (state, event) => case event of
  #Deposit amount => {
    .balance = state.balance + amount;
    .accepted = state.accepted + 1;
    .rejected = state.rejected;
  }
  #Withdraw amount => do:
    if amount <= state.balance:
      return {
        .balance = state.balance - amount;
        .accepted = state.accepted + 1;
        .rejected = state.rejected;
      }
    else:
      return {
        .balance = state.balance;
        .accepted = state.accepted;
        .rejected = state.rejected + 1;
    }

let events = [#Deposit 10, #Withdraw 4, #Withdraw 20, #Deposit 3, #Withdraw 8]
let initial = { .balance = 0; .accepted = 0; .rejected = 0; }
let final = fold (events, initial, apply)

return final
