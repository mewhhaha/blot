// A pin tests a value against an existing binding without shadowing it.

open @import "blot:prelude" ();

let wanted = 2;

let classify = fn value => case value of
  #(wanted) => "wanted",
  _ => "other"
end;

let greeting = "hello";
let greeted = case "hello" of
  #(greeting) => True,
  _ => False
end;

let payload = case #Code 2 of
  #Code #(wanted) => wanted,
  _ => 0
end;

return {
  .same = classify 2;
  .different = classify 3;
  .greeted = greeted;
  .payload = payload;
};
