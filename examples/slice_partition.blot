// Pure source semantics with proof-backed in-place Store reuse.

open import "blot:prelude"

let whole = Slice.copy [5, 2, 4, 1, 3]
let (!partitioned, boundary) =
  Slice.partition ((!whole), fn value => value <= 3)
let whole_result = Slice.freeze (!partitioned)

let ranged = Slice.copy [9, 5, 2, 4, 1, 3, 8]
let (!range_region, range_boundary) = case Slice.partition_range (
  (!ranged),
  1,
  6,
  fn value => value <= 3
) of
  #Partitioned (!updated, middle) => (updated, middle)
  #PartitionOutOfBounds (!original, fallback) => (original, fallback)
let range_result = (Slice.freeze (!range_region), range_boundary)

return ((whole_result, boundary), range_result)
