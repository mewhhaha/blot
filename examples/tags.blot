// Declaration tags are ordinary compile-time descriptors. Their transforms
// wrap a binding's value, while their names and metadata remain available to
// tools such as `blot test`.

open import "blot:prelude"

const multiply = fn factor => tag (
  "multiply",
  { .factor = factor; },
  fn value => value * factor
)
const increment = tag ("increment", (), fn value => value + 1)

// The nearest tag runs first: multiply produces 6, then increment produces 7.
@[increment]
@[multiply 2]
let ordered = 3

// `derive` is a descriptor constructor, not a compiler builtin. This transform
// enriches the type value with an attached namespace member.
const label = fn target => target <+ { .label = "enriched"; }
@[derive label]
const Count = I32

// Lowering keeps `rec` directly bound under its source name before applying
// transforms, so tagging does not create a second recursion rule.
@[tag ("identity", (), identity)]
const rec factorial =
  fn n => do:
    if n == 0:
      return 1

    return n * factorial (n - 1)

// A test is an ordinary identity transform whose descriptor name is `test`.
// Normal evaluation leaves this function alone; `blot test` discovers it.
@[test]
let transformations_work = fn () => do:
  return expect (
    ordered == 7,
    "tags apply nearest-first"
  )

// A statement tag observes the whole declaration: its kind, its bound name,
// and its value. Value tags keep receiving the bare value.
const observe = tag_statement ("observe", (), fn stmt => stmt)
const observe_pair =
  tag_statement ("observe_pair", (), fn stmt => (stmt.name, stmt.value))

@[observe]
const observed_const = 41

@[observe]
let observed_let = 42

@[observe_pair]
const (observed_name, observed_pair) = (1, 2)

return
  { .ordered = ordered; .label = Count.label; .factorial = factorial 5; .observed_const; .observed_let; .observed_name; .observed_pair; }
