// Matching, all the way to WebAssembly.
//
// Core dispatches on a constructor and nothing else, so the rest of blot's
// patterns become what they always described: a literal payload is a guard
// inside its constructor's arm, and a `case` over literals is a chain of
// equality tests.

const Message = #Ready | #Progress Int | #Failed Int;

let describe = m => case m of
  #Ready => 0,
  #Progress 0 => 100,
  #Progress n => n * 2,
  #Failed code => code
end;

// No union to dispatch on, so the arms are comparisons.
let classify = value => case value of
  -1 => 10,
  1 => 20,
  _ => 30
end;

// A compound payload binds one name and then destructures it.
let unpack = m => case m of
  #Pair (left, right) => left + right,
  #Single n => n
end;

return describe #Ready + describe (#Progress 0) + describe (#Progress 4)
  + describe (#Failed 3) + classify 1 + classify 7 + unpack (#Pair (5, 6))
  - 130;
