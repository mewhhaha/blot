open import "blot:prelude"

const On = fn (left, right, key) => {
  .left_key = left -> key;
  .right_key = right -> key;
  .equal = (key, key) -> Bool;
}

const Group = fn (left, right) => {
  .left;
  .matches = [right];
}

const flip: @forall (fn Left => @forall (fn Right => @forall (fn Key => On (Left, Right, Key) -> On (Right, Left, Key))))
const flip = fn relation => {
  .left_key = relation.right_key;
  .right_key = relation.left_key;
  .equal = relation.equal;
}

const group: @forall (fn Left => @forall (fn Right => @forall (fn Key => (On (Left, Right, Key), [Left], [Right]) -> [Group (Left, Right)])))
const group = fn (relation, lefts, rights) => do:
  // This side is captured by a callback that may run for every left row.
  // Freeze it once so repeated read-only traversal does not duplicate authority.
  let rights = @linear.freeze rights
  let collect = fn left => do:
    let keep = fn right => relation.equal (relation.left_key left, relation.right_key right)
    let matches = filter ((&rights), ?keep)
    return { .left; .matches; }
  return map (lefts, collect)

return { .On; .Group; .flip; .group; }
