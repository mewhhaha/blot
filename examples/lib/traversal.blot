open import "blot:prelude"

// A traversal connects one whole value to zero or more homogeneous parts.
// `collect` observes every focus; `modify` changes every focus while rebuilding
// the same whole type.
const Traversal = fn (whole, part) => {
  .collect = whole -> [part];
  .modify = (whole, (part -> part)) -> whole;
}

// Lift an exactly-one focus into the same zero-or-more interface.
const one :: @forall (fn Whole => @forall (fn Part => ((Whole -> Part), ((Whole, Part) -> Whole)) -> Traversal (Whole, Part)))
const one = fn (view, set) => {
  .collect = fn whole => [view whole];
  .modify = fn (whole, change) => set (whole, change (view whole));
}

// Every element of a homogeneous array is a focus. This single traversal is
// reusable for arrays at any level once composition establishes the element type.
const each :: @forall (fn Part => Traversal ([Part], Part))
const each = {
  .collect = fn values => values;
  .modify = fn (values, change) => map (values, change);
}

// The outer part and inner whole share one Middle type. Collection flattens the
// nested focus arrays; modification delegates rebuilding to both traversals.
const compose :: @forall (fn Whole => @forall (fn Middle => @forall (fn Part => (Traversal (Whole, Middle), Traversal (Middle, Part)) -> Traversal (Whole, Part))))
const compose = fn (outer, inner) => {
  .collect = fn whole => do:
    let middles = outer.collect whole
    return fold (
      middles,
      [],
      fn (parts, middle) => do:
        let focused = inner.collect middle
        return fold (focused, parts, fn (result, part) => @array.push result part)
      )
  ;
  .modify = fn (whole, change) => outer.modify (
    whole,
    fn middle => inner.modify (middle, change)
  );
}

const over :: @forall (fn Whole => @forall (fn Part => (Traversal (Whole, Part), Whole, (Part -> Part)) -> Whole))
const over = fn (traversal, whole, change) => traversal.modify (whole, change)

return {
  .Traversal = Traversal;
  .one = one;
  .each = each;
  .compose = compose;
  .over = over;
  }
