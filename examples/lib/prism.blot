open import "blot:prelude"

// A prism is a partial focus into a larger sum. `preview` may miss, while
// `review` injects a focused value back into the whole type.
const Prism = fn (whole, part) => {
  .preview = whole -> Option part;
  .review = part -> whole;
}

// The shared `Middle` type is the composition invariant: only adjacent partial
// focuses compose. The implementation is ordinary Option/case plumbing.
const compose :: @forall (fn Whole => @forall (fn Middle => @forall (fn Part => (Prism (Whole, Middle), Prism (Middle, Part)) -> Prism (Whole, Part))))
const compose = fn (outer, inner) => {
  .preview = fn whole => case outer.preview whole of
    #None => #None
    #Some middle => inner.preview middle
  ;
  .review = fn part => outer.review (inner.review part);
}

// Apply a change only when the prism matches. A miss preserves the original
// whole value, so callers do not need a parallel branch at every use site.
const over :: @forall (fn Whole => @forall (fn Part => (Prism (Whole, Part), Whole, (Part -> Part)) -> Whole))
const over = fn (prism, whole, change) => case prism.preview whole of
  #None => whole
  #Some part => prism.review (change part)

return {
  .Prism = Prism;
  .compose = compose;
  .over = over;
}
