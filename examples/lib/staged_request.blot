open import "blot:prelude"

// A request's two required slots are ordinary type parameters. `Missing` and
// `Present T` make the construction state visible to the checker without a
// second typestate language or a runtime builder registry.
const Missing = #Missing
const Present = fn value => #Present value

const RetryCount = range (0, 5)

const Request = fn (auth, body) => {
  .endpoint = Text;
  .auth = auth;
  .body = body;
  .retries = RetryCount;
}

const Ready = Request (Present Text, Present Text)

const Receipt = {
  .credential = Text;
  .endpoint = Text;
  .payload = Text;
  .retries = RetryCount;
}

const begin :: Text -> Request (Missing, Missing)
const begin = fn endpoint => {
  .endpoint;
  .auth = #Missing;
  .body = #Missing;
  .retries = 0;
}

// Each setter consumes the old stage and returns the next one. The untouched
// slot remains quantified, so authorization and body construction can happen in
// either order without duplicating the implementation.
const authorize :: @forall (fn Body => (Request (Missing, Body), Text) -> Request (Present Text, Body))
const authorize = fn (!request, credential) => do:
  let { .endpoint; .auth; .body; .retries; } = request
  return case auth of
    #Missing => {
      .endpoint;
      .auth = #Present credential;
      .body;
      .retries;
    }

const with_body :: @forall (fn Auth => (Request (Auth, Missing), Text) -> Request (Auth, Present Text))
const with_body = fn (!request, payload) => do:
  let { .endpoint; .auth; .body; .retries; } = request
  return case body of
    #Missing => {
      .endpoint;
      .auth;
      .body = #Present payload;
      .retries;
    }

// A stage-preserving modifier quantifies both slots. It can be applied before,
// between, or after required setters without weakening the construction state.
const with_retries :: @forall (fn Auth => @forall (fn Body => (Request (Auth, Body), RetryCount) -> Request (Auth, Body)))
const with_retries = fn (!request, retries) => do:
  let { .endpoint; .auth; .body; .retries = _; } = request
  return { .endpoint; .auth; .body; .retries; }

const submit :: Ready -> Receipt
const submit = fn !request => do:
  let { .endpoint; .auth; .body; .retries; } = request
  return case auth, body of
    #Present credential, #Present payload => {
      .credential;
      .endpoint;
      .payload;
      .retries;
    }

// Pain point: the stage relation is precise, but the reusable signatures are
// visually dominated by nested @forall binders once a modifier preserves more
// than one independent slot. The runtime implementation is just record plumbing.
return {
  .Missing
  .Present
  .RetryCount
  .Request
  .Ready
  .Receipt
  .begin
  .authorize
  .with_body
  .with_retries
  .submit
}
