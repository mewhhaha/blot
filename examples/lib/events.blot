open import "blot:prelude"
const Spark = import "blot:spark"
const Events = import "blot:events"

let run ::
  { .executor = Spark.Executor; .changes = Events.Source Int; } -> Events.Policy -> Int -> Int ~ { Spark.Effect, Events.Effect }
let run = fn io => fn policy => fn count => do:
  let body :: Spark.Scope -> Int ~ { Spark.Effect, Events.Effect }
  let body = fn scope => do:
    use subscription <- Events.subscribe scope io.changes policy
    let total = 0
    for index in Iter.range (0, count):
      use event <- Events.next subscription
      if let #Some value = event else:
        break

      total := total + value

    return total
  return Spark.scope io.executor body

return { .run = run; }
