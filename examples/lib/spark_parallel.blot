open import "blot:prelude"
const Spark = import "blot:spark"

const sum :: Int -> Int = fn count => do:
  let total = 0
  for index in Iter.range (0, count):
    total := total + index

  return total

let run :: { .executor = Spark.Executor; } -> Int -> Int ~ { Spark.Effect }
let run = fn io => fn count => do:
  let body :: Spark.Scope -> Int ~ { Spark.Effect }
  let body = fn scope => do:
    let ?left :: Unit -> Int = fn () => sum count
    let ?right :: Unit -> Int = fn () => sum (count + 1)
    use first <- Spark.parallel scope (?left)
    use second <- Spark.parallel scope (?right)
    use a <- Spark.join first
    use b <- Spark.join second
    return a + b
  return Spark.scope io.executor body

return { .run = run; .kernel = sum; }
