const { .Result; } = import "blot:prelude"

// A stage either resolves an input or forwards a statically narrower residual
// to the next stage. The caller chooses the residual with ordinary type algebra.
const Stage = fn (input, output, remaining) => input -> Result (output, remaining)

const then :: @forall (fn Input => @forall (fn Middle => @forall (fn Remaining => @forall (fn Output => (Stage (Input, Output, Middle), Stage (Middle, Output, Remaining)) -> Stage (Input, Output, Remaining)))))
const then = fn (first, second) => fn input => case first input of
  #Ok output => #Ok output
  #Error remaining => second remaining

const finish :: @forall (fn Input => @forall (fn Remaining => @forall (fn Output => (Stage (Input, Output, Remaining), Remaining -> Output) -> Input -> Output)))
const finish = fn (stage, final) => fn input => Result.unwrap_or_else final (stage input)
return {
  .Stage;
  .then;
  .finish;
}
