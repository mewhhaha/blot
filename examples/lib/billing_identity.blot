open import "blot:prelude"
const Nominal = import "./nominal_domain.blot"

// Reconstructing the customer domain with the same name and carrier gives the
// same nominal type as customer_identity.blot without importing that module.
const CustomerId = Nominal.domain ("example.customer-id.v1", Int)
const InvoiceId = Nominal.domain ("example.invoice-id.v1", Int)

const customer_raw :: CustomerId -> Int
const customer_raw = CustomerId.value

const invoice_for :: CustomerId -> InvoiceId
const invoice_for = fn customer => InvoiceId.of (CustomerId.value customer + 1000)

const invoice_raw :: InvoiceId -> Int
const invoice_raw = InvoiceId.value

return {
  .CustomerId = CustomerId;
  .InvoiceId = InvoiceId;
  .customer_raw = customer_raw;
  .invoice_for = invoice_for;
  .invoice_raw = invoice_raw;
}
