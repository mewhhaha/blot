open import "blot:prelude"

// A reducer packages one fold state machine with its final projection. The
// state stays explicit in the type so composition can preserve it exactly.
// Pain point: Blot has no direct existential/opaque-state record encoding, so
// composed reducer types expose their nested internal accumulator shape.
const Reducer = fn (input, state, output) => {
  .initial = state;
  .step = (state, input) -> state;
  .finish = state -> output;
}

const PairState = fn (left, right) => {
  .left = left;
  .right = right;
}

// Pain point: `check` can currently underconstrain this shared `Input` across a
// generic reducer/array call; full specialization still rejects a mismatch.
const run: @forall (fn Input => @forall (fn State => @forall (fn Output => (Reducer (Input, State, Output), [Input]) -> Output)))
const run = fn (reducer, values) => reducer.finish (fold (values, reducer.initial, reducer.step))

const contramap: @forall (fn Outer => @forall (fn Input => @forall (fn State => @forall (fn Output => (Reducer (Input, State, Output), (Outer -> Input)) -> Reducer (Outer, State, Output)))))
const contramap = fn (reducer, project) => {
  .initial = reducer.initial;
  .step = fn (state, value) => reducer.step (state, project value);
  .finish = reducer.finish;
}

const map_output: @forall (fn Input => @forall (fn State => @forall (fn Output => @forall (fn Mapped => (Reducer (Input, State, Output), (Output -> Mapped)) -> Reducer (Input, State, Mapped)))))
const map_output = fn (reducer, transform) => {
  .initial = reducer.initial;
  .step = reducer.step;
  .finish = fn state => transform (reducer.finish state);
}

const zip_with: @forall (fn Input => @forall (fn LeftState => @forall (fn RightState => @forall (fn Left => @forall (fn Right => @forall (fn Output => (Reducer (Input, LeftState, Left), Reducer (Input, RightState, Right), ((Left, Right) -> Output)) -> Reducer (Input, PairState (LeftState, RightState), Output)))))))
const zip_with = fn (left, right, combine) => {
  .initial = {
    .left = left.initial;
    .right = right.initial;
  };
  .step = fn (state, value) => {
    .left = left.step (state.left, value);
    .right = right.step (state.right, value);
  };
  .finish = fn state => combine (
    left.finish state.left,
    right.finish state.right
  );
}

return {
  .Reducer = Reducer;
  .run = run;
  .contramap = contramap;
  .map_output = map_output;
  .zip_with = zip_with;
}
