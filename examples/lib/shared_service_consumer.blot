open import "blot:prelude"

const Port = import "./shared_service_port.blot"

const Directory =
  Port.unary (
    "example.directory.lookup.v1",
    Int,
    Option Text
  )
const Quota =
  Port.unary (
    "example.directory.quota.v1",
    Text,
    Int
  )

let profile = fn user_id => do:
  use name <- Directory.call user_id
  use quota <- Quota.call "core"
  return { .name; .quota; }

return { .Directory; .Quota; .profile; }
