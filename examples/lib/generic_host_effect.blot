open import "blot:prelude"

const Echo =
  @effect.host {
    .copy = Effect.suspends (@forall (fn element => element -> element));
  }

let run :: Int -> { .number = Int; .text = Text; } ~ { Echo }
let run = fn number => do:
  use copied_number <- Echo.copy number
  use copied_text <- Echo.copy "hello"
  return { .number = copied_number; .text = copied_text; }

return { .Echo = Echo; .run = run; }
