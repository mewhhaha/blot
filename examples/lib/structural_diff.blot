// A small derived API for comparing unrestricted scalar records.
//
// Blot's types are ordinary compile-time values, so a differ is generated by
// walking checked field evidence rather than by macros or a second type-level
// language. The shared `Value` in `Differ Value` relates both inputs to the
// schema that produced the implementation.

open import "blot:prelude"
const Derive = import "blot:derive"

const Differ = fn Value => {
  .changed = (Value, Value) -> [Text];
  .equal = (Value, Value) -> Bool;
}

const scalar_equal = fn field => case Reflect.of field.type of
  #Int _ => fn (left, right) => Int.eq (
    @satisfies (field.read left) Int,
    @satisfies (field.read right) Int
  )
  #Text _ => fn (left, right) => Text.eq (
    @satisfies (field.read left) Text,
    @satisfies (field.read right) Text
  )
  #Range info => case info.domain of
    #Int => fn (left, right) => Int.eq (
      @satisfies (field.read left) Int,
      @satisfies (field.read right) Int
    )
    #Text => fn (left, right) => Text.eq (
      @satisfies (field.read left) Text,
      @satisfies (field.read right) Text
    )
    _ => @fail "structural diff supports only integer and text scalar fields"
  _ => @fail "structural diff supports only integer and text scalar fields"

const derive = fn schema => do:
  let evidence = Derive.fields schema

  let changed :: (schema, schema) -> [Text]
  let changed = fn _ => @satisfies Array.empty [Text]

  for name in Iter.items (@shape.names evidence.fields):
    let field = @shape.get evidence.fields name
    let same = scalar_equal field
    let previous = changed
    changed := fn pair => do:
      let names = previous pair
      if same pair:
        return names
      return @array.push names name

  let equal :: (schema, schema) -> Bool
  let equal = fn pair => Int.eq (@array.len (changed pair)) 0

  return @satisfies {
    .changed = changed;
    .equal = equal;
  } (Differ schema)

return {
  .Differ = Differ;
  .derive = derive;
}
