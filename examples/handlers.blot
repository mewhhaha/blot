// Handlers that compile.
//
// gpufuck has no runtime handler representation, so blot specializes a handler
// with selective CPS before Core exists. Each operation receives an affine
// continuation for the rest of the computation.
//
// Handling means inlining the computation, because the evidence is lexical. A
// closure has already resolved its operations against the global definitions,
// so specializing the handler is not an optimization here: it is what makes it
// mean anything.

open {} = (@import "blot:prelude") ();

const Counter = @effect { .bump = Int -> Int; };
const Scale = @effect { .by = Int -> Int; };

// A clause is `fn (argument, ?resume) => …`. `?` is affine, so resuming twice is a
// static error and never resuming is an abort — which is a different feature.
let doubling = { .bump = fn (n, ?resume) => do
  result <- resume (n * 2);
  in result
end; };

// Resume may appear beneath a block, conditional, or case.
let stepping = {
  .by = fn (n, ?resume) => do
    let scaled = n * 10;
    result <- resume (if n < 0 then 0 else scaled end);
    in result
  end;
};

let counted = fn () => do
  first <- Counter.bump 20;
  second <- Counter.bump 1;
  in first + second
end;
let scaled = fn () => do
  result <- Scale.by 4;
  in result
end;

// Nested handlers discharge only what they replace.
return @handle (Counter, counted, doubling) - @handle (Scale, scaled, stepping);
