// Asking a question about a type.
//
// `@satisfies` either constrains a value with a canonical type or asks whether
// its inferred type has a property — an `.x` field, a shape, whatever a
// predicate can decide. Both forms pass the value through unchanged.
//
// The predicate is an ordinary compile-time function from a type to a `Bool`,
// so `reflect` and `refines` are all it needs and the prelude adds no
// machinery — `Is` and `Has` are two lines each.

open import "blot:prelude"

// The type is what is asked about, never the value — which is why this works
// on an expression whose value only exists at run time. `@type.of` cannot do
// that: it answers the type of a *value*, so it has to evaluate one, and
// evaluating a host read is an effect the compiler has no answer for.
// `examples/rejected/semantics/does_not_satisfy.blot` reads from a host for
// exactly that reason and is still refused while compiling.
//
// The values here are ordinary so the catalog can record what the program
// evaluates to; nothing about the mechanism needs them to be.
let reading = { .value = 12; .label = "depth"; }

// `Has` asks for a subset of fields. The value passes through unchanged, so it
// reads as an assertion on the way to using it.
let checked = @satisfies reading (Has { .value = Int; })

// A predicate written inline can ask anything the comptime evaluator can.
let counted =
  @satisfies reading (
    fn t => case reflect t of
      #Shape fields => @array.len (@shape.names fields) == 2
      _ => False
  )

// `Is` is exact rather than a subset.
const Reading = { .value = 12; .label = "depth"; }
let exact = @satisfies reading (Is Reading)

// `examples/rejected/semantics/does_not_satisfy.blot` is the program whose
// predicate answers `#False`, and it is refused while compiling rather than
// trapping.

return {
  .value = checked.value;
  .label = counted.label;
  .both = exact.value;
}
