// The prelude list is a polymorphic immutable arena with ordinary operator,
// pattern-matching, fold, mapping, and iterator APIs. The same implementation
// runs at compile time and at runtime.

open import "blot:prelude"

const IntList = List.of Int

const rec sum_matching :: IntList -> Int
const rec sum_matching =
  fn list => case List.uncons list of
    #Nil => 0
    #Cons (value, tail) => value + sum_matching tail

const Primes =
  List.prepend 2 (List.prepend 3 (List.prepend 5 (List.prepend 7 List.empty)))
const Doubled = List.map (Primes, fn value => value * 2)
const Combined = List.append Primes Doubled
const compile_time_total =
  List.fold (
    Combined,
    0,
    fn (total, value) => total + value
  )
const compile_time_values = List.to_array Combined

let runtime_list = List.from_array (upto (1, 11))
let prefixed = List.prepend 0 runtime_list
let repeated = List.append runtime_list runtime_list
let matched_head = case List.uncons prefixed of
  #Nil => -1
  #Cons (value, _) => value
let iterated_total = 0
for value in List.items runtime_list:
  iterated_total := iterated_total + value

return {
  .runtime_total = List.fold (
    runtime_list,
    0,
    fn (total, value) => total + value
  );
  .iterated_total = iterated_total;
  .matched_total = sum_matching runtime_list;
  .matched_head = matched_head;
  .prefixed = List.to_array prefixed;
  .repeated_total = List.fold (
    repeated,
    0,
    fn (total, value) => total + value
  );
  .compile_time_total = compile_time_total;
  .compile_time_values = compile_time_values;
}
