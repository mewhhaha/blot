open import "blot:prelude"

const Include = import "./lib/include_transforms.blot"

const inspect = fn source => {
  .specifier = source.specifier;
  .path = source.path;
  .text = source.text;
}

const included = @include "./assets/greeting.txt" inspect
const raw = @include "./assets/greeting.txt" Include.as_raw
const normal_json = @include "./assets/config.json" Include.as_json
const exact_json = @include "./assets/config.json" Include.as_const_json

return {
  .included = included;
  .raw = raw;
  .normal_json = normal_json;
  .exact_json = exact_json;
  }
