open import "blot:prelude"

const inspect = fn source => {
  .specifier = source.specifier;
  .path = source.path;
  .text = source.text;
}

const included = @include "./assets/greeting.txt" inspect
const normal_json = @include "./assets/config.json" as_json
const exact_json = @include "./assets/config.json" as_const_json

return {
  .included = included;
  .normal_json = normal_json;
  .exact_json = exact_json;
  }
