open import "blot:prelude"

const P = import "./lib/stream_processor.blot"

const Raw = #Raw Int
const Distinct = #Distinct Int
const Jump =
  #Jump {
    .from = Int;
    .to = Int;
    .delta = Int;
  }

// Suppress consecutive duplicates while remembering the last raw value.
let distinct_step :: (Option Int, Raw) -> (Option Int, Option Distinct)
let distinct_step = fn (previous, raw) => case raw of
  #Raw value => case previous of
    #None => (Some value, Some (#Distinct value))
    #Some before => do:
      if before == value:
        return (previous, None)

      return (Some value, Some (#Distinct value))

const distinct =
  P.make {
    .state_type = Option Int;
    .input_type = Raw;
    .output_type = Distinct;
    .initial = None;
    .step = distinct_step;
  }

// Emit only jumps whose absolute delta is at least five. The first distinct
// reading establishes the baseline and intentionally emits nothing.
let large_jump_step :: (Option Int, Distinct) -> (Option Int, Option Jump)
let large_jump_step = fn (previous, current) => case current of
  #Distinct value => case previous of
    #None => (Some value, None)
    #Some before => do:
      let delta = value - before
      if Int.abs delta >= 5:
        return (
          Some value,
          Some (#Jump {
            .from = before;
            .to = value;
            .delta;
          })
        )

      return (Some value, None)

const large_jumps =
  P.make {
    .state_type = Option Int;
    .input_type = Distinct;
    .output_type = Jump;
    .initial = None;
    .step = large_jump_step;
  }

// `compose` shares `Distinct` as the exact middle carrier. Its paired state
// keeps both independent histories, and a suppressed duplicate never advances
// the downstream jump detector.
const alerts = P.compose (distinct, large_jumps)

let observed :: P.Run (P.PairState (Option Int, Option Int), Jump)
let observed =
  P.run alerts [#Raw 10, #Raw 10, #Raw 12, #Raw 20, #Raw 20, #Raw 15, #Raw 16]

let deduped :: P.Run (Option Int, Distinct)
let deduped = P.run distinct [#Raw 2, #Raw 2, #Raw 3]

let downstream_reused :: P.Run (Option Int, Jump)
let downstream_reused = P.run large_jumps [#Distinct 1, #Distinct 10]

let duplicate_only :: P.Run (P.PairState (Option Int, Option Int), Jump)
let duplicate_only = P.run alerts [#Raw 7, #Raw 7, #Raw 7]

let empty :: P.Run (P.PairState (Option Int, Option Int), Jump)
let empty = P.run alerts []

return {
  .default = {
    .alerts = observed.outputs;
    .final_state = observed.state;
    .deduped = deduped.outputs;
    .downstream_reused = downstream_reused.outputs;
    .duplicate_only;
    .empty;
  };
}
