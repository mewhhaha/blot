// Predictable storage.
//
// A struct is a *placement*: an order over the declared fields, and the
// positional product that order describes. The product is written out, so
// where a value lives is something the program decided rather than something
// the compiler chose later.
//
// The product is a tuple rather than an array on purpose. `[I32, Str]`
// collapses to "an array of int-or-text" the moment inference looks at it;
// `(I32, Str)` keeps one type per slot, and storage that is imprecise is not
// predictable storage.

const Point = struct { .x = I32; .y = I32; };

// Named record in, positional storage out. The call site writes the fields in
// whatever order reads well; the placement decides where they land.
const origin = Point.new { .y = 0; .x = 0; };
const somewhere = Point.new { .y = 20; .x = 10; };

// --- placement is a parameter -----------------------------------------------
//
// `struct` is declaration order. `packed` is widest-first. Anything else is a
// function you write, because the order is just an array of names.

const Record = { .flag = U8; .id = I32; .code = U8; .name = Str; };

const byte_width = t =>
  if refines (t, U8)
  then 1
  else (if refines (t, I32) then 4 else 8 end)
  end;

const Declared = struct Record;
const Packed = packed (Record, byte_width);

// Alphabetical is a placement too — nothing about `structure` is privileged
// toward the two above, and an order is only ever an array of names.
const alphabetical = names => sort_by (names, ((left, right) => is_less (@text.cmp left right)));
const Sorted = structure (Record, alphabetical (@shape.names Record));

// --- what the order costs ---------------------------------------------------
//
// `aligned` places each field at a multiple of its own width and reports the
// padding rather than hiding it, because choosing a better order is the whole
// reason to look at it.

const declared_bytes = aligned (Record, Declared.fields, byte_width);
const packed_bytes = aligned (Record, Packed.fields, byte_width);

// `layout` is the unpadded case: offsets in a given order, nothing inserted.
const raw_bytes = layout (Record, byte_width);

return {
  .storage = Point.storage;
  .origin = origin;
  .somewhere = somewhere;
  .x = Point.get (somewhere, "x");
  .y_slot = Point.slot "y";
  .back_to_named = Point.named somewhere;

  .declared_order = Declared.fields;
  .declared_storage = Declared.storage;
  .declared_size = declared_bytes.size;
  .declared_padding = declared_bytes.padding;

  .packed_order = Packed.fields;
  .packed_storage = Packed.storage;
  .packed_size = packed_bytes.size;
  .packed_padding = packed_bytes.padding;
  .packed_offsets = packed_bytes.fields;

  .sorted_order = Sorted.fields;
  .unpadded_size = raw_bytes.size;
};
