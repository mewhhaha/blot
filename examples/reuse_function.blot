// The tag checks the residual Store-update path. It grants no ownership;
// the update makes the inferred `values` contract consuming.

open import "blot:prelude"

sig clear_first_length = [Int] -> Int
@[assert.reuse]
const clear_first_length = fn values => do:
  if @array.len values > 0:
    let updated = @array.set values 0 0
    return @array.len updated

  return @array.len values

let values = [10, 20, 30]
return clear_first_length values
