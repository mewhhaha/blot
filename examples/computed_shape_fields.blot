open import "blot:prelude"

const generated_name = "answer key"
let generated = { .[generated_name] = 42; }

let original :: { .count = Int; .label = Text; }
let original = { .count = 1; .label = "kept"; }
let updated = Shape.update (original, { .count = 2; })
let entries = Shape.entries { .left = 1; .right = 2; }

return (
  @shape.get generated generated_name,
  original.count,
  updated.count,
  @array.len entries
  )
