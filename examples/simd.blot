// Four lanes, in the artifact.
//
// `examples/vectors.blot` says what four lanes *mean*, and it says it with
// literals — so the comptime evaluator answers every question that program
// asks and the module it compiles to contains no vector instruction at all. It
// proves the semantics and nothing about the emission.
//
// This is the other half. Every vector below descends from a block the
// compiler cannot run, so nothing may fold it away and the whole chain has to
// survive to the arithmetic, comparison, select, shuffle, extracts, and
// horizontal sum. The compiler session tests compile this file and read those
// opcodes back out of the bytes, which is the only thing that distinguishes an
// emitted instruction from an answer the evaluator already knew.

open import "blot:prelude"

// Four lane-wise operations, chained. Each one consumes the register the last
// one produced, so a vector is never rebuilt in between — that is the property
// the opcode assertions are really about, and a chain is the only way to state
// it in a program.
let normalize :: F32x4 -> F32x4
let normalize = fn input => do:
  let gain = F32x4.splat (F32.of_int 10)
  let biased = F32x4.add input gain
  let scaled = F32x4.mul biased gain
  let centered = F32x4.sub scaled gain
  return F32x4.div centered (F32x4.splat (F32.of_int 2))

let sample :: Int -> Int
let sample = fn seed => do:
  let normalized = normalize (F32x4.of (
    F32.of_int seed,
    F32.of_int (seed + 1),
    F32.of_int (seed + 2),
    F32.of_int (seed + 3)
  ))
  let gain = F32x4.splat (F32.of_int 10)
  let selected = F32x4.select (F32x4.less normalized gain) gain normalized
  let exact = F32x4.select (F32x4.equal selected selected) selected gain
  let shuffled = F32x4.shuffle (exact, normalized, 0, 5, 2, 7)
  let swizzled = F32x4.swizzle (exact, 3, 2, 1, 0)

  // Every intermediate lane is a whole number a single-precision float holds
  // exactly, so the interpreter, the GPU evaluator, and the emitted Wasm agree
  // on these truncations without rounding entering into it.
  let first = F32.truncate (F32x4.x normalized)
  let second = F32.truncate (F32x4.y normalized)
  let last = F32.truncate (F32x4.w normalized)
  // A horizontal sum is one instruction sequence over the register rather
  // than the four extracts and three adds a program would have to write.
  let total = F32.truncate (F32x4.sum normalized)
  let energy = F32.truncate (F32x4.dot normalized gain)
  let shuffled_total = F32.truncate (F32x4.sum shuffled)
  let swizzled_total = F32.truncate (F32x4.sum swizzled)
  let all_score = case F32x4.all (F32x4.less gain normalized) of
    #True => 1
    #False => 0
  let any_score = case F32x4.any (F32x4.less gain normalized) of
    #True => 1
    #False => 0
  return first + second + last + total + energy + shuffled_total + swizzled_total + all_score + any_score

return { .default = sample; .example = sample 1; }
