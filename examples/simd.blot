// Four lanes, in the artifact.
//
// `examples/vectors.blot` says what four lanes *mean*, and it says it with
// literals — so the comptime evaluator answers every question that program
// asks and the module it compiles to contains no vector instruction at all. It
// proves the semantics and nothing about the emission.
//
// This is the other half. Every vector below descends from a block the
// compiler cannot run, so nothing may fold it away and the whole chain has to
// survive to the arithmetic, comparison, select, shuffle, extracts, and
// horizontal sum. `backend.test.ts` compiles this file and reads those opcodes
// back out of the bytes, which is the only thing that distinguishes an emitted
// instruction from an answer the evaluator already knew.

open @import "blot:prelude" ()

const Console = @effect.host {
  .write = Str -> Unit;
  }

// The write is what makes this resist folding. Its answer belongs to the host,
// so the comptime evaluator has to stop at the block rather than run it, and
// the four lanes it gathers become a value the running program builds. The
// same `Vec4.of` written at the top level would be a constant vector before
// the backend saw a lane, and so would everything computed from it.
// Four lane-wise operations, chained. Each one consumes the register the last
// one produced, so a vector is never rebuilt in between — that is the property
// the opcode assertions are really about, and a chain is the only way to state
// it in a program.
sig normalize = F32x4 -> F32x4
let normalize = fn input =>
  let gain = Vec4.splat (Float32.of_int 10)
  let biased = Vec4.add input gain
  let scaled = Vec4.mul biased gain
  let centered = Vec4.sub scaled gain
  return Vec4.div centered (Vec4.splat (Float32.of_int 2))

sig normalized = F32x4
normalized <- normalize (
  _ <- Console.write "sampling"
  return Vec4.of (Float32.of_int 1, Float32.of_int 2, Float32.of_int 3, Float32.of_int 4)
)

sig gain = F32x4
let gain = Vec4.splat (Float32.of_int 10)

sig selected = F32x4
let selected = Vec4.select (Vec4.less normalized gain) gain normalized

sig exact = F32x4
let exact = Vec4.select (Vec4.equal selected selected) selected gain

sig shuffled = F32x4
let shuffled = Vec4.shuffle (exact, normalized, 0, 5, 2, 7)

// Every intermediate lane is a whole number a single-precision float holds
// exactly, so the interpreter, the GPU evaluator, and the emitted Wasm agree on
// the truncations below without rounding entering into it. A disagreement here
// is a lowering bug and never a last-bit one.
//
// Scalars may cross the canonical boundary directly. This example converts to
// integers so its answers remain compact and obvious; `F32x4` itself stays an
// internal register value and cannot be exported.
return {
  .first = Float32.truncate (Vec4.x normalized);
  .second = Float32.truncate (Vec4.y normalized);
  .last = Float32.truncate (Vec4.w normalized);
  // A horizontal sum is one instruction sequence over the register rather than
  // the four extracts and three adds a program would have to write, which is
  // why `sum` is a primitive where `dot` is prelude source over it.
  .total = Float32.truncate (Vec4.sum normalized);
  .energy = Float32.truncate (Vec4.dot normalized gain);
  .shuffled = Float32.truncate (Vec4.sum shuffled);
  }
