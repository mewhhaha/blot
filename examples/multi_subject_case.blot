// A comma-separated case evaluates a subject only when the selected pattern
// column needs it. The first arm below never asks for `second`, so its panic is
// not evaluated.

open import "blot:prelude"

let choose :: (Bool, Bool) -> Int
let choose = fn (first, second) => case first, second of
  #True, _ => 1
  #False, #True => 2
  #False, #False => 3

let skipped = case #True, @panic "wildcard subject was evaluated" of
  #True, _ => 4
  #False, _ => 5

return
  [choose (True, True), choose (False, True), choose (False, False), skipped]
