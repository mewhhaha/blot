open import "blot:prelude"
const V = import "./lib/validation_applicative.blot"

const Port = refine (Int, fn value => value >= 1 && value <= 65535)
const Replicas = refine (Int, fn value => value >= 1 && value <= 32)
const TimeoutMs = refine (Int, fn value => value >= 100 && value <= 60000)

const RawConfig =
  {
    .port = Int;
    .replicas = Int;
    .timeout_ms = Int;
  }

const Config =
  {
    .port = Port;
    .replicas = Replicas;
    .timeout_ms = TimeoutMs;
  }

const ConfigError =
  #InvalidPort Int | #InvalidReplicas Int | #InvalidTimeout Int

let port: V.Validator (RawConfig, Port, #InvalidPort Int)
let port = fn raw => do:
  if raw.port >= 1 && raw.port <= 65535:
    return #Ok raw.port

  return #Error [#InvalidPort raw.port]

let replicas: V.Validator (RawConfig, Replicas, #InvalidReplicas Int)
let replicas = fn raw => do:
  if raw.replicas >= 1 && raw.replicas <= 32:
    return #Ok raw.replicas

  return #Error [#InvalidReplicas raw.replicas]

let timeout: V.Validator (RawConfig, TimeoutMs, #InvalidTimeout Int)
let timeout = fn raw => do:
  if raw.timeout_ms >= 100 && raw.timeout_ms <= 60000:
    return #Ok raw.timeout_ms

  return #Error [#InvalidTimeout raw.timeout_ms]

const Core = { .port = Port; .replicas = Replicas; }
const CoreError = #InvalidPort Int | #InvalidReplicas Int

let core: V.Validator (RawConfig, Core, CoreError)
let core =
  V.zip_with (
    fn (valid_port, valid_replicas) => {
      .port = valid_port;
      .replicas = valid_replicas;
    },
    port,
    replicas
  )

let config: V.Validator (RawConfig, Config, ConfigError)
let config =
  V.zip_with (
    fn (valid_core, valid_timeout) => {
      .port = valid_core.port;
      .replicas = valid_core.replicas;
      .timeout_ms = valid_timeout;
    },
    core,
    timeout
  )


let capacity: V.Validator (RawConfig, Int, ConfigError)
let capacity =
  V.map (
    fn valid => valid.replicas * valid.timeout_ms,
    config
  )

let capacity_or_zero = fn raw => case capacity raw of
  #Ok value => value
  #Error _ => 0

const Summary =
  {
    .ok = Bool;
    .errors = [Text];
    .port = Int;
    .replicas = Int;
    .timeout_ms = Int;
  }

let error_name: ConfigError -> Text
let error_name = fn error => case error of
  #InvalidPort _ => "port"
  #InvalidReplicas _ => "replicas"
  #InvalidTimeout _ => "timeout_ms"

let summarize: V.Validation (Config, ConfigError) -> Summary
let summarize = fn result => case result of
  #Ok valid => {
    .ok = True;
    .errors = [];
    .port = valid.port;
    .replicas = valid.replicas;
    .timeout_ms = valid.timeout_ms;
  }

  #Error errors => {
    .ok = False;
    .errors = map (errors, error_name);
    .port = 0;
    .replicas = 0;
    .timeout_ms = 0;
  }

let good = { .port = 8080; .replicas = 3; .timeout_ms = 5000; }
let bad = { .port = 0; .replicas = 99; .timeout_ms = 1; }
let boundary = { .port = 65535; .replicas = 32; .timeout_ms = 60000; }

return {
  .default = {
    .good = summarize (config good);
    .bad = summarize (config bad);
    .boundary = summarize (config boundary);
    .good_capacity = capacity_or_zero good;
    .bad_capacity = capacity_or_zero bad;
  };
}
