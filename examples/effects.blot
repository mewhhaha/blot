// Effects.
//
// There is no `effect` declaration form, no `perform`, no `try`, no `with`, and
// no handler keyword. An effect is a shape of operation types handed to one
// primitive; performing an operation is an ordinary call; a handler is a shape;
// and `@handle` is a function.

const Console = @effect {
  .write = Str -> Unit;
};

const Counter = @effect {
  .next = Unit -> Str;
};

// Nothing here says "effectful". The row is inferred; performing is a call.
let greet = () => do
  const _ = Console.write "hello";
  const _2 = Console.write "world";
  return "done";
end;

// A handler is a shape: one field per operation taking `(argument, ?resume)`,
// plus an optional `.return` clause applied to the computation's result.
//
// `?` is affine — at most once. Not a weaker `!`: a handler that never resumes
// is aborting, which is legitimate, while resuming twice is not. `blot check`
// catches the second call statically.
let collecting = {
  .write = (message, ?resume) => do
    const rest = resume ();
    return @text.concat (@text.concat message "|") rest;
  end;
  .return = value => value;
};

let counting = {
  .write = (_, ?resume) => @int.add 1 (resume ());
  .return = _ => 0;
};

// A handler that never resumes discards the rest of the computation, which is
// how an abort is written without any exception machinery.
let silencing = {
  .write = (_, ?resume) => "silenced";
  .return = value => value;
};

let transcript = handle (greet, collecting);
let writes = handle (greet, counting);
let silenced = handle (greet, silencing);

// Handlers nest. The inner one discharges `Console`; the outer sees nothing
// left to handle.
let nested = handle ((() => handle (greet, counting)), collecting);

return {
  .transcript = transcript;
  .writes = writes;
  .silenced = silenced;
  .nested = nested;
};
