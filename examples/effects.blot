// Effects.
//
// There is no `effect` declaration form, no `perform`, no `with`, and no
// handler declaration keyword. An effect is a shape of operation types handed
// to one primitive; performing an operation is an ordinary call; a handler is
// a shape; and `@handle` is a function.
//
// `x <- computation;` is `let x = computation ();` and nothing more. Performing
// is already a call and the row is already inferred, so there is nothing left
// for a perform form to declare — which leaves `<-` one honest job: naming what
// a computation *returns* without spelling the `()`. Requiring a nullary value
// is what stops it from being a second spelling for `let`.
//
// The row is inferred and it is also writable. `A -> B ~ { Console }` is what a
// function that performs `Console` prints as, and a `sig` spells it the same
// way — an effect is an ordinary compile-time value, so a row is the ordinary
// list of them. A bare `->` is not silence about effects: it is the empty row,
// so `sig greet = Unit -> Str;` below would be rejected.

open {} = (@import "blot:prelude") ();

const Console = @effect {
  .write = Str -> Unit;
};

const Counter = @effect {
  .next = Unit -> Str;
};

// Reading from an effect, which is what `<-` is for.
const Terminal = @effect {
  .read = Unit -> Str;
};

sig ask = Unit -> Str ~ { Terminal };
let ask = fn () => do
  answer <- Terminal.read;
  in answer <> "!"
end;

let answering = {
  .read = fn ((), ?resume) => resume "42";
  .return = fn value => value;
};

// Performing is a call, and the row follows from it. The `sig` says the same
// thing the printer would: the body may perform `Console` and nothing else.
sig greet = Unit -> Str ~ { Console };
let greet = fn () => do
  let _ = Console.write "hello";
  let _2 = Console.write "world";
  in "done"
end;

// A handler is a shape: one field per operation taking `(argument, ?resume)`,
// plus an optional `.return` clause applied to the computation's result.
//
// `?` is affine — at most once. Not a weaker `!`: a handler that never resumes
// is aborting, which is legitimate, while resuming twice is not. `blot check`
// catches the second call statically.
let collecting = {
  .write = fn (message, ?resume) => do
    let rest = resume ();
    in @text.concat (@text.concat message "|") rest
  end;
  .return = fn value => value;
};

let counting = {
  .write = fn (_, ?resume) => @int.add 1 (resume ());
  .return = fn _ => 0;
};

let passing = {
  .write = fn (_, ?resume) => resume ();
  .return = fn value => value;
};

// A handler that never resumes discards the rest of the computation, which is
// how an abort is written without any exception machinery.
let silencing = {
  .write = fn (_, ?resume) => "silenced";
  .return = fn value => value;
};

let transcript = @handle (Console, greet, collecting);
let writes = @handle (Console, greet, counting);
let silenced = @handle (Console, greet, silencing);

// Handlers nest. The inner one discharges `Console`; the outer sees nothing
// left to handle.
let nested = @handle (Console, (fn () => @handle (Console, greet, counting)), passing);

let asked = @handle (Terminal, ask, answering);

return {
  .transcript = transcript;
  .writes = writes;
  .silenced = silenced;
  .nested = nested;
  .asked = asked;
};
