open import "blot:prelude"

let sample :: Int -> Int
let sample = fn seed => do:
  let values = I32x4.of_wrapping (seed, 7, -8, 9)
  let shifted = I32x4.shift_left values 1
  let bounded = I32x4.max_signed shifted (I32x4.splat_wrapping (@int.neg 12))
  let words = I16x8.add (I16x8.splat_wrapping (32762 + seed)) (I16x8.splat 1)
  let bytes = I8x16.add (I8x16.splat_wrapping (122 + seed)) (I8x16.splat 1)
  const selected = 2
  let wrapped = I8x16.splat_wrapping (123 + seed)

  let wide = I32x4.x bounded
  let selected_value = I32x4.lane values selected
  let word_mask = I16x8.mask_bits (I16x8.less_signed words (I16x8.splat 0))
  let byte_mask = I8x16.mask_bits (I8x16.less_signed bytes (I8x16.splat 0))
  let wrapped_mask = I8x16.mask_bits (I8x16.less_signed wrapped (I8x16.splat 0))
  return wide + selected_value + word_mask + byte_mask + wrapped_mask

return { .default = sample; .example = sample 5; }
