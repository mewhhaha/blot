{
  "exclude": [
    ".*",
    "case-studies/engine/desktop.ts",
    "compiler/target",
    "dist",
    "experiments/rust-middle/target",
    "node_modules",
    "tree-sitter-blot"
  ],
  "tasks": {
    "generate:parser": "deno run --allow-read --allow-write npm:@jsr/mewhhaha__baba@9.0.0/cli grammar.baba --out generated --name blot --root program --metadata baba.json --target wasm",
    "generate:compiler-schema": "deno run --allow-read --allow-write scripts/generate_compiler_schema.ts",
    "generate": "deno task generate:parser && deno task generate:compiler-schema",
    "check:generated": "deno task generate:parser && git diff --exit-code -- generated/wasm generated/queries generated/.baba-manifest.json && deno task generate:compiler-schema --check && deno run --allow-read scripts/generate_language_health.ts --check",
    "inspect": "deno run --allow-read scripts/inspect_plan.ts",
    "parse": "deno run --allow-read scripts/parse.ts",
    "audit:lints": "deno run --allow-read scripts/audit_lints.ts",
    "verify:simplifications": "deno run --allow-read scripts/verify_simplifications.ts",
    "game-loop:desktop": "deno run --allow-env=HOME,XDG_CACHE_HOME,LD_LIBRARY_PATH --allow-net=archive.archlinux.org --allow-read --allow-write --allow-run scripts/run_game_loop_desktop.ts"
  },
  "nodeModulesDir": "manual",
  "desktop": {
    "backend": "raw"
  },
  "unstable": ["webgpu"],
  "lint": {
    "exclude": [
      "generated",
      "src/diagnostic_codes.generated.ts",
      "src/syntax/fixities.generated.ts",
      "tree-sitter-blot"
    ]
  },
  "fmt": {
    "exclude": [
      "generated",
      "compiler/src/frontend_plan.rs",
      "src/diagnostic_codes.generated.ts",
      "src/syntax/fixities.generated.ts",
      "STDLIB.md",
      "AGENTS.md",
      "CLAUDE.md",
      "tree-sitter-blot",
      "queries",
      "formal/lean/lake-manifest.json",
      "pnpm-lock.yaml"
    ]
  }
}
