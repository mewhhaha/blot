{
  "name": "@mewhhaha/blot",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "tasks": {
    "generate": "deno run --allow-read --allow-write @mewhhaha/baba/cli grammar.baba --out generated --name blot --root program --metadata baba.json --target wasm",
    "inspect": "deno run --allow-read scripts/inspect_plan.ts",
    "parse": "deno run --allow-read scripts/parse.ts",
    "audit:staging": "deno run --allow-read scripts/audit_staging.ts",
    "corpus": "deno run --allow-read scripts/compile_corpus.ts",
    "verify:runtime": "deno run --allow-read scripts/verify_runtime.ts",
    "verify:rust-compiler": "deno run --allow-read scripts/verify_runtime.ts --full-rust",
    "check": "deno run --allow-read scripts/generate_rust_middle_schema.ts --check && deno check mod.ts scripts/*.ts case-studies/*.ts case-studies/engine/serve.ts experiments/rust-middle/*.ts src/cli.ts src/backend/rust_middle.test.ts src/load.test.ts src/check/setops.test.ts src/check/narrow.test.ts src/check/type.test.ts src/check/coverage.test.ts syntax.test.ts examples.test.ts inference.test.ts linear.test.ts comptime.test.ts module.test.ts backend.test.ts",
    "test": "deno test --allow-read --allow-write",
    "blot": "deno run --allow-read --allow-write src/cli.ts",
    "case-study": "deno run --unstable-webgpu --allow-read --allow-env case-studies/run.ts",
    "install": "deno run --allow-read --allow-write --allow-env --allow-run=deno,tree-sitter scripts/setup_helix.ts",
    "engine": "deno run --unstable-webgpu --allow-read --allow-net --allow-env --allow-run=xdg-open,open,explorer case-studies/engine/serve.ts",
    "experiment:rust-middle": "deno run --allow-read --allow-write experiments/rust-middle/benchmark.ts",
    "experiment:rust-middle-parity": "deno run --allow-read experiments/rust-middle/parity.ts",
    "experiment:rust-middle-check-parity": "deno run --allow-read experiments/rust-middle/check_parity.ts",
    "experiment:rust-middle-eval-parity": "deno run --allow-read experiments/rust-middle/eval_parity.ts examples/*.blot",
    "experiment:rust-middle-hir-parity": "deno run --allow-read experiments/rust-middle/hir_parity.ts",
    "generate:rust-middle-schema": "deno run --allow-read --allow-write=experiments/rust-middle/src/schema.rs,experiments/rust-middle/src/frontend_plan.rs scripts/generate_rust_middle_schema.ts",
    "build:rust-middle": "deno run --allow-read --allow-write=generated/rust-middle --allow-run=cargo scripts/build_rust_middle.ts",
    "check:rust-middle-artifact": "deno run --allow-read --allow-run=cargo scripts/build_rust_middle.ts --check",
    "publish:dry-run": "deno publish --dry-run"
  },
  "imports": {
    "@mewhhaha/baba": "jsr:@mewhhaha/baba@^9.0.0",
    "@mewhhaha/baba/cli": "jsr:@mewhhaha/baba@^9.0.0/cli",
    "@mewhhaha/baba/runtime/generated-wasm": "jsr:@mewhhaha/baba@^9.0.0/runtime/generated-wasm",
    "@mewhhaha/baba/runtime/webgpu": "jsr:@mewhhaha/baba@^9.0.0/runtime/webgpu",
    "@mewhhaha/gpupaper": "jsr:@mewhhaha/gpupaper@^0.1.5",
    "@mewhhaha/gpupaper/runtime": "jsr:@mewhhaha/gpupaper@^0.1.5/runtime",
    "@mewhhaha/gpupaper/wasm": "jsr:@mewhhaha/gpupaper@^0.1.5/wasm",
    "gpufuck": "jsr:@mewhhaha/gpufuck@^0.9.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "minimumDependencyAge": {
    "age": "P7D",
    "exclude": [
      "jsr:@mewhhaha/*"
    ]
  },
  "publish": {
    "exclude": [
      "AGENTS.md",
      "CLAUDE.md",
      "experiments/",
      "!generated/wasm/parser.wasm",
      "!generated/rust-middle/compiler.wasm"
    ]
  },
  "fmt": {
    "exclude": [
      "generated",
      "experiments/rust-middle/src/frontend_plan.rs",
      "AGENTS.md",
      "CLAUDE.md",
      "tree-sitter-blot",
      "queries",
      "formal/lean/lake-manifest.json"
    ]
  }
}
