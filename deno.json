{
  "unstable": [
    "webgpu"
  ],
  "tasks": {
    "generate": "deno run --allow-read --allow-write @mewhhaha/baba/cli grammar.baba --out generated --name blot --root program --metadata baba.json --target wasm",
    "inspect": "deno run --allow-read scripts/inspect_plan.ts",
    "parse": "deno run --allow-read scripts/parse.ts",
    "check": "deno check scripts/*.ts src/cli.ts syntax.test.ts",
    "test": "deno test --allow-read",
    "blot": "deno run --allow-read src/cli.ts",
    "install": "deno run --allow-read --allow-write --allow-env --allow-run=deno,tree-sitter scripts/setup_helix.ts"
  },
  "imports": {
    "@mewhhaha/baba": "jsr:@mewhhaha/baba@^7.3.0",
    "@mewhhaha/baba/cli": "jsr:@mewhhaha/baba@^7.3.0/cli",
    "@mewhhaha/baba/runtime/generated-wasm": "jsr:@mewhhaha/baba@^7.3.0/runtime/generated-wasm",
    "@mewhhaha/baba/runtime/webgpu": "jsr:@mewhhaha/baba@^7.3.0/runtime/webgpu",
    "gpufuck": "../gpufuck/functional.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "minimumDependencyAge": {
    "age": "P7D",
    "exclude": [
      "jsr:@mewhhaha/*"
    ]
  },
  "fmt": {
    "exclude": [
      "generated",
      "AGENTS.md",
      "CLAUDE.md",
      "tree-sitter-blot",
      "queries"
    ]
  }
}
