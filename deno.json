{
  "name": "@mewhhaha/blot",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "tasks": {
    "generate": "deno run --allow-read --allow-write @mewhhaha/baba/cli grammar.baba --out generated --name blot --root program --metadata baba.json --target wasm",
    "inspect": "deno run --allow-read scripts/inspect_plan.ts",
    "parse": "deno run --allow-read scripts/parse.ts",
    "audit:staging": "deno run --allow-read scripts/audit_staging.ts",
    "corpus": "deno run --allow-read scripts/compile_corpus.ts",
    "verify:runtime": "deno run --allow-read scripts/verify_runtime.ts",
    "verify:compiler": "deno run --allow-read scripts/verify_runtime.ts --full-rust",
    "check": "deno run --allow-read scripts/generate_compiler_schema.ts --check && deno check .",
    "test": "deno test --allow-read --allow-write",
    "blot": "deno run --allow-read --allow-write src/cli.ts",
    "lsp": "deno run --allow-read src/cli.ts lsp",
    "fmt:blot": "deno run --allow-read --allow-write src/cli.ts fmt",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "case-study": "deno run --unstable-webgpu --allow-read --allow-env case-studies/run.ts",
    "install": "deno run --allow-read --allow-write --allow-env --allow-run=deno,tree-sitter scripts/setup_helix.ts",
    "engine": "deno run --unstable-webgpu --allow-read --allow-net --allow-env --allow-run=xdg-open,open,explorer case-studies/engine/serve.ts",
    "benchmark:compiler": "deno run --allow-read --allow-write compiler/benchmark.ts",
    "experiment:generated-code": "deno run --allow-read --allow-write --allow-run=rustc experiments/generated-code/benchmark.ts",
    "experiment:package": "deno run --allow-read --allow-write --allow-run=deno experiments/package/benchmark.ts",
    "conformance:frontend": "deno run --allow-read conformance/compiler/parity.ts",
    "conformance:check": "deno run --allow-read conformance/compiler/check_parity.ts",
    "conformance:eval": "deno run --allow-read conformance/compiler/eval_parity.ts examples/*.blot",
    "conformance:hir": "deno run --allow-read conformance/compiler/hir_parity.ts",
    "generate:compiler-schema": "deno run --allow-read --allow-write=compiler/src/schema.rs,compiler/src/frontend_plan.rs scripts/generate_compiler_schema.ts",
    "build:compiler": "deno run --allow-read --allow-write=generated/compiler --allow-env=CARGO_HOME,HOME --allow-run=cargo scripts/build_compiler.ts",
    "check:compiler-artifact": "deno run --allow-read --allow-env=CARGO_HOME,HOME --allow-run=cargo scripts/build_compiler.ts --check",
    "publish:dry-run": "deno publish --dry-run"
  },
  "imports": {
    "@mewhhaha/baba": "jsr:@mewhhaha/baba@^9.0.0",
    "@mewhhaha/baba/cli": "jsr:@mewhhaha/baba@^9.0.0/cli",
    "@mewhhaha/baba/runtime/generated-wasm": "jsr:@mewhhaha/baba@^9.0.0/runtime/generated-wasm",
    "@mewhhaha/baba/runtime/webgpu": "jsr:@mewhhaha/baba@^9.0.0/runtime/webgpu",
    "@mewhhaha/gpupaper": "jsr:@mewhhaha/gpupaper@^0.1.5",
    "@mewhhaha/gpupaper/runtime": "jsr:@mewhhaha/gpupaper@^0.1.5/runtime",
    "@mewhhaha/gpupaper/wasm": "jsr:@mewhhaha/gpupaper@^0.1.5/wasm",
    "gpufuck": "jsr:@mewhhaha/gpufuck@^0.9.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "minimumDependencyAge": {
    "age": "P7D",
    "exclude": [
      "jsr:@mewhhaha/*"
    ]
  },
  "publish": {
    "exclude": [
      "AGENTS.md",
      "CLAUDE.md",
      "experiments/",
      "compiler/",
      "conformance/",
      "!generated/wasm/parser.wasm",
      "!generated/compiler/compiler.wasm",
      "!generated/compiler/prelude.snapshot"
    ]
  },
  "lint": {
    "exclude": [
      "generated",
      "tree-sitter-blot"
    ]
  },
  "fmt": {
    "exclude": [
      "generated",
      "compiler/src/frontend_plan.rs",
      "AGENTS.md",
      "CLAUDE.md",
      "tree-sitter-blot",
      "queries",
      "formal/lean/lake-manifest.json"
    ]
  }
}
